{
  "name": "safetyhub",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "SafetyHub.kz — платформа онлайн-обучения и аттестации в области промышленной безопасности, охраны труда и пожарной безопасности",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "test": "node --test",
    "test:contacts": "node scripts/check-contact-literals.mjs",
    "test:db": "node scripts/run-supabase-sql-tests.mjs",
    "check:db-types": "node scripts/check-supabase-type-contract.mjs",
    "test:e2e": "node --env-file-if-exists=.env.local node_modules/@playwright/test/cli.js test",
    "test:e2e:auth": "node --env-file-if-exists=.env.local scripts/run-e2e-release.mjs e2e/authenticated-workspaces.spec.ts",
    "test:e2e:release": "node --env-file-if-exists=.env.local scripts/run-e2e-release.mjs",
    "e2e:otp-state": "node --env-file-if-exists=.env.local scripts/capture-e2e-otp-session.mjs",
    "test:load": "node scripts/load-test-supabase.mjs",
    "seed:workspace": "node --env-file-if-exists=.env.local scripts/seed-operator-workspace.mjs",
    "admin:bootstrap": "node --env-file-if-exists=.env.local scripts/bootstrap-passwordless-admin.mjs",
    "auth:config:prepare:production": "node scripts/prepare-production-auth-config.mjs",
    "test:e2e:install": "playwright install chromium",
    "check:contacts": "node scripts/check-contact-literals.mjs",
    "check:security": "node scripts/check-security-baseline.mjs",
    "check:config": "node scripts/check-repository-config.mjs",
    "check:bundles": "node scripts/check-bundle-budgets.mjs",
    "verify": "npm run check:security && npm run check:contacts && npm run check:config && npm run lint && npm run type-check && npm test && npm run build && npm run check:bundles && npm audit --audit-level=moderate && npm audit signatures",
    "verify:release": "npm run verify && npm run db:reset && npm run db:types:check:local && npm run check:db-types && npm run test:db && npm run seed:workspace && npm run test:e2e:release",
    "format": "prettier --write \"**/*.{ts,tsx,json}\"",
    "db:types": "npm run db:types:generate:local",
    "db:types:generate": "node scripts/generate-supabase-types.mjs --linked",
    "db:types:generate:local": "node scripts/generate-supabase-types.mjs --local",
    "db:types:check": "node scripts/generate-supabase-types.mjs --linked --check",
    "db:types:check:local": "node scripts/generate-supabase-types.mjs --local --check",
    "db:migrations:check-linked": "supabase migration list --linked",
    "db:backup:linked": "node scripts/backup-linked-database.mjs",
    "storage:backup:linked": "node scripts/backup-linked-storage.mjs",
    "storage:backup:verify": "node scripts/verify-linked-storage-backup.mjs",
    "storage:buckets:ensure:local": "node scripts/ensure-course-presentation-buckets.mjs --local",
    "storage:buckets:check:local": "node scripts/ensure-course-presentation-buckets.mjs --local --check",
    "storage:buckets:ensure:linked": "node --env-file-if-exists=.env.local scripts/ensure-course-presentation-buckets.mjs --linked",
    "storage:buckets:check:linked": "node --env-file-if-exists=.env.local scripts/ensure-course-presentation-buckets.mjs --linked --check",
    "content:pull:linked": "node --env-file-if-exists=.env.local scripts/content-sync-linked.mjs --pull",
    "content:snapshot:validate": "node scripts/course-content/validate-snapshot.mjs",
    "content:initial-import:validate": "node scripts/course-content/validate-snapshot.mjs --initial-import",
    "content:initial-import": "node --env-file-if-exists=.env.local scripts/initial-course-import.mjs",
    "content:catalog-batch:check": "node --env-file-if-exists=.env.local scripts/check-course-catalog-batch.mjs",
    "content:seed:generate": "node scripts/generate-content-seed.mjs",
    "content:assets:seed:local": "node scripts/seed-course-presentation-assets.mjs",
    "content:parity:check": "node --env-file-if-exists=.env.local scripts/content-sync-linked.mjs --check",
    "db:seed:generate": "npm run content:seed:generate",
    "db:reset": "supabase db reset && npm run storage:buckets:ensure:local && npm run content:assets:seed:local",
    "db:push": "supabase db push"
  },
  "dependencies": {
    "@napi-rs/canvas": "1.0.8",
    "@pdf-lib/fontkit": "^1.1.1",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@supabase/ssr": "0.12.4",
    "@supabase/supabase-js": "2.111.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fflate": "^0.8.2",
    "libphonenumber-js": "1.13.12",
    "next": "16.2.12",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.2.108",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.5.0",
    "tus-js-client": "^4.3.1",
    "zod": "^4.4.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "24.13.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.2.12",
    "pg": "^8.23.0",
    "postcss": "8.5.25",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "sharp": "0.35.3",
    "supabase": "^2.111.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "yaml": "^2.8.1"
  },
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": ">=24 <25"
  },
  "overrides": {
    "postcss": "8.5.25",
    "sharp": "0.35.3"
  },
  "allowScripts": {
    "fsevents@2.3.2": true,
    "sharp@0.35.3": true,
    "unrs-resolver@1.11.1": true
  }
}
