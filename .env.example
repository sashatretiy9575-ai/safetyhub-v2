NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SECRET_KEY=your-secret-key
# Local operator UUID used only by the service/offline assessment-localization importer.
SAFETYHUB_CONTENT_OPERATOR_ID=00000000-0000-0000-0000-000000000000
RATE_LIMIT_HMAC_SECRET=replace-with-at-least-32-random-characters
# Both certificate verification secrets must contain at least 32 random characters.
CERTIFICATE_VERIFICATION_SECRET=replace-with-at-least-32-random-characters
# Set only while rotating the verification secret, then remove after the transition. The same 32-character minimum applies.
CERTIFICATE_VERIFICATION_PREVIOUS_SECRET=
# Enable only behind a reverse proxy that removes client-supplied X-Forwarded-For.
TRUST_PROXY_IP_HEADERS=false
# Cloudflare's documented always-pass test pair is public and is only for local
# development/CI. Production must replace both values with the real widget pair.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
SUPABASE_AUTH_CAPTCHA_SECRET=1x0000000000000000000000000000000AA
# Vercel server only: ZH registration verifies before any Auth/profile write.
# In production it must be the real secret matching the widget site key, never
# the public local/CI test value shown here and never a NEXT_PUBLIC variable.
SAFETYHUB_TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# Supabase Auth "Send Email" hook (supabase/config.toml [auth.hook.send_email]).
# The same `v1,whsec_<base64>` value is pushed to Auth and set on Vercel; join
# several with `|` while rotating. Vercel relays the rendered message through
# the PS.kz mailbox below, so the mailbox password lives only in Vercel env.
SUPABASE_SEND_EMAIL_HOOK_SECRETS=v1,whsec_replace-with-base64-of-32-random-bytes
SAFETYHUB_SMTP_HOST=srv-plesk28.ps.kz
SAFETYHUB_SMTP_PORT=465
SAFETYHUB_SMTP_USER=no-reply@safetyhub.kz
SAFETYHUB_SMTP_PASSWORD=
SAFETYHUB_SMTP_FROM=no-reply@safetyhub.kz
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Vercel supplies VERCEL_ENV and VERCEL_URL automatically. Production requires
# NEXT_PUBLIC_SITE_URL to be a bare HTTPS origin; previews use their VERCEL_URL.
CONTENT_UPSTREAM_TIMEOUT_MS=4000
CONTENT_FALLBACK_ENABLED=false
CONTENT_REVALIDATE_SECRET=replace-with-at-least-32-random-characters
# Staged production rollout gates. Production/preview default to disabled when
# absent; local development/tests default to enabled. Use only exact true/false.
SAFETYHUB_LOCALE_ROUTES_ENABLED=false
SAFETYHUB_ZH_USERNAME_PASSWORD_ENABLED=false
SAFETYHUB_ADMIN_INBOX_ENABLED=false
# Edge Function only: encode at least 32 cryptographically random bytes and keep
# the value in Supabase Functions secrets/Vault, never in a NEXT_PUBLIC variable.
STORAGE_RECONCILER_SECRET=replace-with-at-least-32-random-characters

# Local/staging operator-workspace seed and authenticated Playwright checks.
# The seed refuses remote projects unless --allow-remote or ALLOW_TEST_DATA=1 is set.
# For localhost, the release runner creates short-lived OTP browser states from
# these confirmed fixture accounts. Do not configure a password for them.
E2E_ADMIN_EMAIL=admin@safetyhub.local
E2E_PARTICIPANT_EMAIL=participant@safetyhub.local
# For a remote preview/staging check, capture a real email-OTP login with
# `npm run e2e:otp-state` and point to two absolute files outside this repo.
# Never put cookie contents in environment variables or commit those files.
E2E_ADMIN_STORAGE_STATE=
E2E_PARTICIPANT_STORAGE_STATE=
