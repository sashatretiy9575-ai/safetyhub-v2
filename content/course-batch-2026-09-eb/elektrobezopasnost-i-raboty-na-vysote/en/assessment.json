{
  "schemaVersion": 1,
  "slug": "elektrobezopasnost-i-raboty-na-vysote",
  "locale": "en",
  "status": "draft-awaiting-independent-review",
  "policy": {
    "durationMinutes": 15,
    "passScore": 7,
