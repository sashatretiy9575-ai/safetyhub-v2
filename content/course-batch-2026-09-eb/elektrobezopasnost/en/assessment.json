  "variants": [
    {
      "id": "992269c6-3af2-5364-9999-d29e82014341",
      "variantNumber": 1,
      "questions": [
        {
          "id": "8f255529-9b77-5aff-aabb-d4c575307cc5",
          "text": "What 50 Hz alternating current is called the non-let-go current, at which a person cannot release their grip unaided?",
          "displayOrder": 1,
          "options": [
            {
              "id": "79d5a222-500a-59ba-9b56-218012c8cf41",
              "text": "0.6–1.5 mA",
              "displayOrder": 1
            },
            {
              "id": "e2cf0e19-17e7-58ae-8495-97167445012d",
              "text": "10–15 mA",
              "displayOrder": 2
            },
            {
              "id": "3d0f7223-b47f-5ba4-b125-7509203f8a72",
              "text": "50–100 mA",
              "displayOrder": 3
            },
            {
              "id": "9a5e6776-5281-5363-8729-f2b286dc394e",
              "text": "More than 5 A",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "e2cf0e19-17e7-58ae-8495-97167445012d",
          "explanation": "A current of 10–15 mA causes irresistible muscle spasms: it is impossible to unclench the hand and break free unaided.",
          "slideRefs": [
            "slide-07"
          ]
        },
        {
          "id": "431fd7d8-064c-5f95-b2f8-fc2a0db2fe9c",
          "text": "What share of the current does the “hand — hand” loop pass through the heart?",
          "displayOrder": 2,
          "options": [
            {
              "id": "d958eff8-0c3a-587a-b67e-dcca5194fd0e",
              "text": "About 0.4%",
              "displayOrder": 1
            },
            {
              "id": "85934a05-b855-5752-a49d-2369e6b8034d",
              "text": "About 3.3%",
              "displayOrder": 2
            },
            {
              "id": "462e786d-9391-5f83-b304-d6c931e5aba0",
              "text": "About 12%",
              "displayOrder": 3
            },
            {
              "id": "c0252651-bc72-5aa4-8f6d-3ed5b14cd989",
              "text": "About 25%",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "85934a05-b855-5752-a49d-2369e6b8034d",
          "explanation": "The “hand — hand” loop passes about 3.3% of the current through the heart and remains the most common workplace case.",
          "slideRefs": [
            "slide-09"
          ]
        },
        {
          "id": "1019be00-eb6f-569a-82e7-ef9fe714c3cd",
          "text": "How do you correctly leave a step voltage zone?",
          "displayOrder": 3,
          "options": [
            {
              "id": "2a6861aa-8727-5e77-b6f3-e9b4e6bc0958",
              "text": "At a run, to leave the danger zone faster",
              "displayOrder": 1
            },
            {
              "id": "ce11d51b-7a18-50e0-88ba-a880efb8a5dd",
              "text": "By hopping on one foot",
              "displayOrder": 2
            },
            {
              "id": "8d0cf960-9291-5963-b1f8-a8a562bb6fa4",
              "text": "With a “shuffle”, feet never off the ground",
              "displayOrder": 3
            },
            {
              "id": "9a02e151-f74e-569e-afb7-9f25e989ea44",
              "text": "With long strides along the shortest route",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "8d0cf960-9291-5963-b1f8-a8a562bb6fa4",
          "explanation": "Leave the current spreading zone slowly with a “shuffle”, each step no longer than your foot; running and jumping are forbidden — a fall is fatal.",
          "slideRefs": [
            "slide-13"
          ]
        },
        {
          "id": "d10d8e54-6507-50dc-a312-0f3fb92176ab",
          "text": "What temperature does an electric arc reach?",
          "displayOrder": 4,
          "options": [
            {
              "id": "c7cfdefe-3b04-57fa-be5f-09e3faf49eac",
              "text": "400–600 °C",
              "displayOrder": 1
            },
            {
              "id": "66f2063e-fee4-5e4e-b993-7010015a4141",
              "text": "1000–1500 °C",
              "displayOrder": 2
            },
            {
              "id": "90d42e3b-62fc-54e8-9850-7a59f32170ff",
              "text": "4000–6000 °C",
              "displayOrder": 3
            },
            {
              "id": "f1c5860f-bf48-5261-9133-6573fd12e958",
              "text": "10,000–15,000 °C",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "90d42e3b-62fc-54e8-9850-7a59f32170ff",
          "explanation": "The temperature of an electric arc reaches 4000–6000 °C, so working without a face shield and a protective suit is deadly.",
          "slideRefs": [
            "slide-08"
          ]
        },
        {
          "id": "703382b1-5b27-5294-8e4d-e16fae6e9b8f",
          "text": "What is protective earthing for?",
          "displayOrder": 5,
          "options": [
            {
              "id": "4718243f-45d8-5e31-8d8a-a81e23f782c6",
              "text": "It disconnects the faulty section in 0.4 seconds",
              "displayOrder": 1
            },
            {
              "id": "5e6d5b8a-960d-5cf6-baae-d6ba2caf878c",
              "text": "It continuously monitors the network insulation resistance",
              "displayOrder": 2
            },
            {
              "id": "bbf51935-beb0-5740-9d13-5231a7be0b1f",
              "text": "It protects the network against overcurrent",
              "displayOrder": 3
            },
            {
              "id": "5c29f795-4062-58fb-bc9c-f4e98ededa32",
              "text": "It reduces touch voltage on a fault to the enclosure",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "5c29f795-4062-58fb-bc9c-f4e98ededa32",
          "explanation": "Earthing connects non-live metal parts to an earth electrode: the fault current flows into the ground. Disconnection in 0.4 s is the TN neutral connection.",
          "slideRefs": [
            "slide-16"
          ]
        },
        {
          "id": "4c229c95-1251-5299-a21f-a9a9a61caf03",
          "text": "Which RCD is used to protect people against direct contact with live parts?",
          "displayOrder": 6,
          "options": [
            {
              "id": "09c95b2e-7f6c-51c0-9eeb-545bfacd637a",
              "text": "With a leakage current of no more than 100 mA",
              "displayOrder": 1
            },
            {
              "id": "fd758cc2-742d-5e75-8af7-baa285dfb4f6",
              "text": "With a leakage current of no more than 30 mA",
              "displayOrder": 2
            },
            {
              "id": "86401adf-351d-5a54-9dbb-b8a04f121747",
              "text": "With a leakage current of no more than 300 mA",
              "displayOrder": 3
            },
            {
              "id": "1dfb8c1d-a206-5a51-a662-981bc0cdece7",
              "text": "With a leakage current of no more than 1 A",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "fd758cc2-742d-5e75-8af7-baa285dfb4f6",
          "explanation": "People are protected by an RCD with IΔn of no more than 30 mA; it disconnects the circuit in 0.02–0.04 s.",
          "slideRefs": [
            "slide-19"
          ]
        },
        {
          "id": "cc5bf556-984e-572e-aabb-1ff5636bbc11",
          "text": "In what order is a portable protective earth applied?",
          "displayOrder": 7,
          "options": [
            {
              "id": "92eff637-5bcb-5c50-b659-900f30c5d9cb",
              "text": "First to the earth electrode, then to the live parts",
              "displayOrder": 1
            },
            {
              "id": "0970732b-2917-5055-a407-eed20e309701",
              "text": "First to the live parts, then to the earth electrode",
              "displayOrder": 2
            },
            {
              "id": "0080d28b-fe00-597f-b74d-a0401cffa9e0",
              "text": "To the earth electrode and the live parts at once",
              "displayOrder": 3
            },
            {
              "id": "5e39bf5d-40ba-5d77-9fa3-dd7f4ed4b76c",
              "text": "In any order, if the work is done in gloves",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "92eff637-5bcb-5c50-b659-900f30c5d9cb",
          "explanation": "Earthing is applied “first to Earth, then to Phase” and removed in the reverse order. Breaking this order is fatal.",
          "slideRefs": [
            "slide-24"
          ]
        },
        {
          "id": "a2d23b24-4e20-5356-9eb5-30d5ed8604d2",
          "text": "Where is the indicative “EARTHED” sign hung?",
          "displayOrder": 8,
          "options": [
            {
              "id": "73b22a0d-ca56-580e-abc6-729098a1f6fb",
              "text": "On the control handles of switching devices",
              "displayOrder": 1
            },
            {
              "id": "468b2af5-e1de-5fcb-81a4-e6341a01beaa",
              "text": "On the entrance door of the switchgear room",
              "displayOrder": 2
            },
            {
              "id": "8770f5f9-b6f1-5b89-9bdd-9d1b00d5e6e0",
              "text": "On the permitting officer's helmet and overalls",
              "displayOrder": 3
            },
            {
              "id": "f54066d3-6c60-55dd-85b2-42ced400d06d",
              "text": "On the barrier around the danger zone",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "73b22a0d-ca56-580e-abc6-729098a1f6fb",
          "explanation": "The indicative “EARTHED” sign is hung on the keys and control handles of switching devices and on earthed sections of the electrical installation.",
          "slideRefs": [
            "slide-25"
          ]
        },
        {
          "id": "6d9970b2-7ca4-56b5-8ddb-0080f3649ecb",
          "text": "What is the maximum validity period of a work permit?",
          "displayOrder": 9,
          "options": [
            {
              "id": "f2098d14-57e8-5fd6-9b4e-6e5943712684",
              "text": "One work shift",
              "displayOrder": 1
            },
            {
              "id": "08d54df1-9eeb-5115-a636-7b25acbb48ab",
              "text": "No more than 30 calendar days",
              "displayOrder": 2
            },
            {
              "id": "3fab23d5-6539-5ece-8ddd-ddc4c6119e31",
              "text": "One year",
              "displayOrder": 3
            },
            {
              "id": "9323c032-83c0-535c-9acd-cc53b4e42d33",
              "text": "No more than 15 calendar days",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "9323c032-83c0-535c-9acd-cc53b4e42d33",
          "explanation": "A work permit is valid for no more than 15 calendar days; a work order — within one shift.",
          "slideRefs": [
            "slide-28"
          ]
        },
        {
          "id": "80c165db-fb84-543d-adc8-77ca1a399ff5",
          "text": "How do you start freeing a victim from electric current?",
          "displayOrder": 10,
          "options": [
            {
              "id": "f327b660-3824-57ef-a8a1-f56dcc426adc",
              "text": "By switching off the electrical installation",
              "displayOrder": 1
            },
            {
              "id": "76937a7b-0ce7-5278-bd19-15adfb718a4f",
              "text": "By pulling the victim away by the hand",
              "displayOrder": 2
            },
            {
              "id": "74bf49b2-2135-5375-9be4-ad56f4c8ce3c",
              "text": "By giving rescue breaths on the spot",
              "displayOrder": 3
            },
            {
              "id": "b87afade-ce59-50d5-b37e-ac995a5d2bb7",
              "text": "By looking for witnesses to the incident",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "f327b660-3824-57ef-a8a1-f56dcc426adc",
          "explanation": "The first step is to de-energise the installation: switch off the nearest isolator, breaker or switch. If the power cannot be cut quickly, the rescuer insulates themselves with dielectric equipment.",
          "slideRefs": [
            "slide-40"
          ]
        }
      ]
    },
    {
      "id": "7d91c6b6-f2ea-52fc-aeea-11c540f04554",
      "variantNumber": 2,
      "questions": [
        {
          "id": "b1d6930c-d990-5bc7-8b9b-1f9fc1b04349",
          "text": "What is the closest distance you may approach unguarded live parts up to 1 kV?",
          "displayOrder": 1,
          "options": [
            {
              "id": "e7136d4c-7db1-50fc-8066-e2a98dbde33a",
              "text": "0.1 m",
              "displayOrder": 1
            },
            {
              "id": "1df12e9d-5482-550d-9fb4-aeb01f7c05c8",
              "text": "0.3 m",
              "displayOrder": 2
            },
            {
              "id": "8a2f6dbc-c9f9-56c2-983a-dc67068fec8f",
              "text": "0.6 m",
              "displayOrder": 3
            },
            {
              "id": "99f4f8e1-d5f9-510d-858b-a4f3a716118d",
              "text": "2.0 m",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "8a2f6dbc-c9f9-56c2-983a-dc67068fec8f",
          "explanation": "The minimum permissible distance to unguarded live parts up to 1 kV is 0.6 m; for 110 kV it is 1.0 m, and for 220 kV it is 2.0 m.",
          "slideRefs": [
            "slide-10"
          ]
        },
        {
          "id": "c26ecb5b-cad8-5625-947f-93a45b5d00fb",
          "text": "At what alternating current does cardiac fibrillation occur?",
          "displayOrder": 2,
          "options": [
            {
              "id": "c3b9e928-f10d-5bd1-adcd-6ff3b8de51de",
              "text": "0.6–1.5 mA",
              "displayOrder": 1
            },
            {
              "id": "1c6becbd-8e17-5318-8373-bba987d757ce",
              "text": "10–15 mA",
              "displayOrder": 2
            },
            {
              "id": "3fcf7081-e700-51d8-ace0-18bbebd3f0eb",
              "text": "50–100 mA",
              "displayOrder": 3
            },
            {
              "id": "e276f6e0-22fa-589c-ae7c-ae31c087ace8",
              "text": "Up to 0.5 mA",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "3fcf7081-e700-51d8-ace0-18bbebd3f0eb",
          "explanation": "A current of 50–100 mA causes chaotic contractions of the heart (fibrillation) and circulatory arrest.",
          "slideRefs": [
            "slide-07"
          ]
        },
        {
          "id": "96b42277-f306-52cb-af26-81efb35f907f",
          "text": "What category does the outdoor switchgear area belong to?",
          "displayOrder": 3,
          "options": [
            {
              "id": "766386a2-bf6d-54db-ae0d-b0e75b5984a9",
              "text": "Especially hazardous premises",
              "displayOrder": 1
            },
            {
              "id": "334fe32e-b58f-53e6-a4c7-b285eed6e078",
              "text": "Premises without increased hazard",
              "displayOrder": 2
            },
            {
              "id": "f91d367e-c887-55d3-8b72-d36c2b557f13",
              "text": "Premises with increased hazard",
              "displayOrder": 3
            },
            {
              "id": "e7d4cd94-a69a-554a-9d38-a0205587fd8c",
              "text": "Not classified by hazard",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "766386a2-bf6d-54db-ae0d-b0e75b5984a9",
          "explanation": "An outdoor switchgear area is always equated to especially hazardous premises; any outdoor work is work in especially hazardous conditions.",
          "slideRefs": [
            "slide-11"
          ]
        },
        {
          "id": "a0ff9db6-d1eb-53b9-971e-d21143843585",
          "text": "Which earthing system is prohibited for new and reconstructed electrical installations?",
          "displayOrder": 4,
          "options": [
            {
              "id": "7919a393-9468-51ba-b859-5fe23f705385",
              "text": "TN-S",
              "displayOrder": 1
            },
            {
              "id": "68aed548-0683-51be-a146-18bd886dfe49",
              "text": "TN-C-S",
              "displayOrder": 2
            },
            {
              "id": "6c32b8fd-b8fd-5310-800c-8a2e86bb0b40",
              "text": "IT",
              "displayOrder": 3
            },
            {
              "id": "f149ecbc-51c4-5eb3-ab61-7d9916bb334f",
              "text": "TN-C",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "f149ecbc-51c4-5eb3-ab61-7d9916bb334f",
          "explanation": "TN-C, with a combined PEN conductor throughout the network, is outdated and prohibited for new and reconstructed electrical installations.",
          "slideRefs": [
            "slide-17"
          ]
        },
        {
          "id": "bb8ea0d6-3589-58ed-9573-f1e3f81a4d0b",
          "text": "With protective neutral connection, how quickly must a faulty section of a 220/380 V network be disconnected?",
          "displayOrder": 5,
          "options": [
            {
              "id": "c0d8dc21-dc4d-5654-92bb-72f33ffac7ee",
              "text": "In no more than 2 s",
              "displayOrder": 1
            },
            {
              "id": "c75bb9dd-7d6b-5582-a5d6-3580083c6767",
              "text": "In no more than 0.4 s",
              "displayOrder": 2
            },
            {
              "id": "1c87c302-7457-572f-95b5-f90ae806d416",
              "text": "In no more than 5 s",
              "displayOrder": 3
            },
            {
              "id": "fc7f5925-73bf-5633-a3f8-a34747119628",
              "text": "In no more than 10 s",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "c75bb9dd-7d6b-5582-a5d6-3580083c6767",
          "explanation": "Under the PUE (Electrical Installation Code), the disconnection time of a faulty section in a 220/380 V network must not exceed 0.4 s.",
          "slideRefs": [
            "slide-18"
          ]
        },
        {
          "id": "76688ee4-c708-5d79-b683-91c9d41edbf9",
          "text": "What voltage must lamps have inside metal tanks, boilers and wells?",
          "displayOrder": 6,
          "options": [
            {
              "id": "7d43ab47-a95c-530c-b8e1-1938f6beec95",
              "text": "No higher than 12 V",
              "displayOrder": 1
            },
            {
              "id": "e961fa86-b792-5da7-980d-33208a32bc21",
              "text": "No higher than 42 V",
              "displayOrder": 2
            },
            {
              "id": "98e35570-1738-5a49-aa45-8e39c0e36ec1",
              "text": "No higher than 127 V",
              "displayOrder": 3
            },
            {
              "id": "d9bf0ca4-eb39-5468-ae0b-1edc37b16291",
              "text": "No higher than 220 V",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "7d43ab47-a95c-530c-b8e1-1938f6beec95",
          "explanation": "In especially hazardous conditions — inside boilers, tanks and wells — a voltage of no higher than 12 V is permitted.",
          "slideRefs": [
            "slide-20"
          ]
        },
        {
          "id": "0462d7ab-8b40-5ac2-b091-37c45706db80",
          "text": "What are dielectric gloves in electrical installations above 1000 V?",
          "displayOrder": 7,
          "options": [
            {
              "id": "b66b9342-3012-5820-8bd6-e74c5b84c913",
              "text": "Basic electrical protective equipment",
              "displayOrder": 1
            },
            {
              "id": "353795c5-f419-5918-8555-624944a3237a",
              "text": "Equipment that is not used there",
              "displayOrder": 2
            },
            {
              "id": "067827c5-48b5-5218-855e-c069f179986c",
              "text": "Additional electrical protective equipment",
              "displayOrder": 3
            },
            {
              "id": "ea158e4c-c4a4-5d50-9742-8b7ebcb8a954",
              "text": "Equipment for measurements only",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "067827c5-48b5-5218-855e-c069f179986c",
          "explanation": "Above 1 kV, dielectric gloves are only additional equipment and are used together with basic equipment (insulating rods, tongs, voltage detectors).",
          "slideRefs": [
            "slide-21"
          ]
        },
        {
          "id": "56a29343-718c-517d-85be-7e2d1ead363c",
          "text": "Which electrical safety group entitles a person to inspect alone and perform work in electrical installations up to 1 kV?",
          "displayOrder": 8,
          "options": [
            {
              "id": "283802d6-813a-56f6-820d-d87de243b887",
              "text": "Group I",
              "displayOrder": 1
            },
            {
              "id": "4a975207-43bf-5858-9310-e5559af964aa",
              "text": "Group III",
              "displayOrder": 2
            },
            {
              "id": "60704616-a098-5048-9339-9f4d27edf3a6",
              "text": "Group II",
              "displayOrder": 3
            },
            {
              "id": "fc5dae19-696f-5532-a23c-87a5fe6c712c",
              "text": "No group is required for this",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "4a975207-43bf-5858-9310-e5559af964aa",
          "explanation": "Group III is electrical personnel entitled to inspect alone and perform work up to 1 kV.",
          "slideRefs": [
            "slide-29"
          ]
        },
        {
          "id": "0465281d-7d4a-59c4-a0f5-39a29b658443",
          "text": "What does preparing a workplace in an electrical installation start with?",
          "displayOrder": 9,
          "options": [
            {
              "id": "4685c100-9895-5885-b7a4-4361c8f6282a",
              "text": "Applying portable protective earths",
              "displayOrder": 1
            },
            {
              "id": "fcde7091-8b37-59d0-aad2-0fc6a3622814",
              "text": "Hanging up the “EARTHED” signs",
              "displayOrder": 2
            },
            {
              "id": "9d7d4fe2-ab8c-55f8-91ab-133e5a612814",
              "text": "Fencing off the workplace with screens",
              "displayOrder": 3
            },
            {
              "id": "05297a65-5211-53f4-8b21-3137331c789e",
              "text": "Switching off with a visible break",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "05297a65-5211-53f4-8b21-3137331c789e",
          "explanation": "The first step is the necessary switching off with a visible break; then locking, checking for absence of voltage, earthing, signs and fencing.",
          "slideRefs": [
            "slide-31"
          ]
        },
        {
          "id": "143c75a9-7e8c-50b4-b241-fdc61d37072f",
          "text": "Who carries out the initial admission of seconded crews?",
          "displayOrder": 10,
          "options": [
            {
              "id": "b33b6b4b-9bcf-572a-b2af-ca842f8cadf1",
              "text": "The contractor's work supervisor",
              "displayOrder": 1
            },
            {
              "id": "0421364b-cb7d-5f07-9eff-59eff74b1790",
              "text": "The head of the seconded group",
              "displayOrder": 2
            },
            {
              "id": "168e72d3-aa15-5702-b3ff-6d9c81e45aa5",
              "text": "The contractor's safety inspector",
              "displayOrder": 3
            },
            {
              "id": "e4d5b9e0-7aaf-538c-a6e0-df8852aa492e",
              "text": "The client's operating staff",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "e4d5b9e0-7aaf-538c-a6e0-df8852aa492e",
          "explanation": "Initial admission of seconded crews is carried out only by the client company's own operating staff.",
          "slideRefs": [
            "slide-37"
          ]
        }
      ]
    },
    {
      "id": "55d3576b-1ff0-50e9-bb84-1c51b7c6f4fa",
      "variantNumber": 3,
      "questions": [
        {
          "id": "0713bc2c-efd3-5a3b-a54a-c150d1475f46",
          "text": "What is every electrical installation considered to be until proven otherwise and until earthing is in place?",
          "displayOrder": 1,
          "options": [
            {
              "id": "b2519ede-98e8-5161-9c6e-49b0ab598e6a",
              "text": "Switched off and safe",
              "displayOrder": 1
            },
            {
              "id": "5e0462e9-4ea4-5e1a-a206-53449f400a98",
              "text": "Safe at voltages up to 42 V",
              "displayOrder": 2
            },
            {
              "id": "6d1bded7-51c7-52e5-af20-6d966327539b",
              "text": "Live, with voltage present",
              "displayOrder": 3
            },
            {
              "id": "e068570a-169f-54bc-bc17-be68ac3323c2",
              "text": "Needing only a visual check",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "6d1bded7-51c7-52e5-af20-6d966327539b",
          "explanation": "The main rule: every electrical installation is considered live until proven otherwise and until earthing is in place.",
          "slideRefs": [
            "slide-05"
          ]
        },
        {
          "id": "ed7a0f9d-6cf1-53ee-8dd1-b7914aa3896c",
          "text": "What is the radius of the dangerous current spreading zone around an overhead line wire that has fallen to the ground?",
          "displayOrder": 2,
          "options": [
            {
              "id": "9c6ef418-1d0d-51f2-aef2-f8c769b974e8",
              "text": "1 m",
              "displayOrder": 1
            },
            {
              "id": "37d646e3-9629-5a14-b097-7162f98702b7",
              "text": "3 m",
              "displayOrder": 2
            },
            {
              "id": "381ee6c5-20e3-5046-82b8-b58d8f80e261",
              "text": "20 m",
              "displayOrder": 3
            },
            {
              "id": "93ea0688-541e-5c88-82de-75ff0995a8d7",
              "text": "8 m",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "93ea0688-541e-5c88-82de-75ff0995a8d7",
          "explanation": "The danger radius around a fallen wire is 8 m (4–5 m indoors); do not approach a wire lying on the ground.",
          "slideRefs": [
            "slide-12"
          ]
        },
        {
          "id": "48fa0e52-c60a-5809-b7ec-757234f25a81",
          "text": "What may be used to supply an extra-low voltage network for portable tools and lamps?",
          "displayOrder": 3,
          "options": [
            {
              "id": "bcc84f21-6619-5d8f-b713-bada039006e1",
              "text": "A step-down autotransformer",
              "displayOrder": 1
            },
            {
              "id": "f6ebdea3-b216-53e1-a8e6-8caca5be4ba2",
              "text": "An isolating transformer",
              "displayOrder": 2
            },
            {
              "id": "4c01ca83-6ffa-5c41-9080-524de86418e1",
              "text": "A rheostat or a voltage divider",
              "displayOrder": 3
            },
            {
              "id": "27d50dc1-3b2b-5f28-9cf0-5af803ac2aab",
              "text": "A plain extension lead with an RCD",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "f6ebdea3-b216-53e1-a8e6-8caca5be4ba2",
          "explanation": "Extra-low voltage is obtained only from isolating step-down transformers with insulated windings; autotransformers are prohibited.",
          "slideRefs": [
            "slide-20"
          ]
        },
        {
          "id": "974deddc-e26c-522f-bf43-b88fcaae6938",
          "text": "May electrical protective equipment with an expired test stamp be used?",
          "displayOrder": 4,
          "options": [
            {
              "id": "4f3c1423-4067-56f2-b09c-407b09692f9a",
              "text": "No, this is strictly prohibited",
              "displayOrder": 1
            },
            {
              "id": "eb262590-4342-5b51-b073-53a703fc3b01",
              "text": "Yes, if there are no visible cracks",
              "displayOrder": 2
            },
            {
              "id": "dba836ac-ab7e-5faf-b571-0687d59fd290",
              "text": "Yes, in electrical installations up to 1000 V",
              "displayOrder": 3
            },
            {
              "id": "7470b829-05f5-52f9-9033-f2af375d60b9",
              "text": "Yes, if the equipment has passed a roll test",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "4f3c1423-4067-56f2-b09c-407b09692f9a",
          "explanation": "First check the test date on the stamp: using expired equipment is prohibited.",
          "slideRefs": [
            "slide-22"
          ]
        },
        {
          "id": "0a23f961-cd31-53a0-86d8-c8cb3fa2cecd",
          "text": "How is the absence of voltage checked?",
          "displayOrder": 5,
          "options": [
            {
              "id": "f898d253-6417-566e-8848-e9efac0e9fad",
              "text": "With a voltage detector, without protective equipment",
              "displayOrder": 1
            },
            {
              "id": "2d6295cb-2c2d-5ab5-89c6-6efb800953f9",
              "text": "By touching with the back of the hand",
              "displayOrder": 2
            },
            {
              "id": "b4eac8ec-9983-5c9e-90fe-6381e6a791b0",
              "text": "With a voltage detector, wearing dielectric gloves",
              "displayOrder": 3
            },
            {
              "id": "359f347e-a8d3-5572-b42d-42d3d1749e75",
              "text": "By the indicator lamps on the panel",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "b4eac8ec-9983-5c9e-90fe-6381e6a791b0",
          "explanation": "The detector is first checked on parts known to be live, then all phases are tested — only while wearing dielectric gloves.",
          "slideRefs": [
            "slide-23"
          ]
        },
        {
          "id": "b55b86f1-b431-5b70-a479-ff73161e7652",
          "text": "What must the cross-section of the copper wire of a portable protective earth be in installations above 1000 V?",
          "displayOrder": 6,
          "options": [
            {
              "id": "c36ea308-0b92-5cf7-a4c1-d39c4a9849f6",
              "text": "At least 4 mm²",
              "displayOrder": 1
            },
            {
              "id": "c0723e33-de44-58cb-9f67-09ef55c8933e",
              "text": "At least 10 mm²",
              "displayOrder": 2
            },
            {
              "id": "e56bb02a-36c7-50a5-95b5-75d74b660c28",
              "text": "At least 16 mm²",
              "displayOrder": 3
            },
            {
              "id": "59ee8484-fe13-593b-8590-8837a2a2a7f6",
              "text": "At least 25 mm²",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "59ee8484-fe13-593b-8590-8837a2a2a7f6",
          "explanation": "For thermal withstand, portable earths are made of flexible copper wire of at least 16 mm² up to 1000 V and at least 25 mm² above 1000 V.",
          "slideRefs": [
            "slide-24"
          ]
        },
        {
          "id": "69e00606-3393-504e-9726-496874968014",
          "text": "Who has the right to remove the “DO NOT SWITCH ON! PEOPLE AT WORK” sign?",
          "displayOrder": 7,
          "options": [
            {
              "id": "550e145f-eed6-5dc4-bed4-b4cc1e6dbe59",
              "text": "Any crew member",
              "displayOrder": 1
            },
            {
              "id": "9bed8c4a-5886-5810-8539-304d165cbb7c",
              "text": "Only the person who put it up",
              "displayOrder": 2
            },
            {
              "id": "b006149d-45fb-5a2e-b92c-c9f323d4fcb1",
              "text": "Any worker with Group III",
              "displayOrder": 3
            },
            {
              "id": "110097ad-0107-583b-8be3-ac8725c02a86",
              "text": "The duty officer upon a verbal phone call",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "9bed8c4a-5886-5810-8539-304d165cbb7c",
          "explanation": "The “DO NOT SWITCH ON” sign has the force of an order, and only the person who put it up may remove it.",
          "slideRefs": [
            "slide-25"
          ]
        },
        {
          "id": "182df9d2-3cfe-5ba2-b36e-1957700ca946",
          "text": "How long is a work order valid?",
          "displayOrder": 8,
          "options": [
            {
              "id": "9e9f058f-49e5-5a3a-92b3-acdac0df8fbb",
              "text": "For no more than 15 calendar days",
              "displayOrder": 1
            },
            {
              "id": "02ab481b-9f29-5e08-8b0d-c7576e907b00",
              "text": "For one work shift",
              "displayOrder": 2
            },
            {
              "id": "e054e886-42a8-5c81-8fc8-7877e79a3807",
              "text": "For one month",
              "displayOrder": 3
            },
            {
              "id": "e32733e5-b031-5169-bc65-6da9b37e02d8",
              "text": "Until all site work is finished",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "02ab481b-9f29-5e08-8b0d-c7576e907b00",
          "explanation": "A work order is a verbal task for a one-off simple job: it is valid for one work shift and is recorded in the operational log.",
          "slideRefs": [
            "slide-28"
          ]
        },
        {
          "id": "f97ccc64-ec88-5206-8d53-94877cc674e3",
          "text": "What principle is the LOTO lockout system based on?",
          "displayOrder": 9,
          "options": [
            {
              "id": "9d260b05-cedb-5a30-8ab9-c49187445216",
              "text": "One lock per crew, the key kept by the foreman",
              "displayOrder": 1
            },
            {
              "id": "dcb72513-8d37-500d-844d-09443a12723d",
              "text": "Lock keys are kept by the permitting officer",
              "displayOrder": 2
            },
            {
              "id": "ba08e6f7-d657-5132-a3fe-086f93c48b4d",
              "text": "The duty officer removes the lock at end of shift",
              "displayOrder": 3
            },
            {
              "id": "86e06b5d-5278-50c9-852f-f852b917b9de",
              "text": "One worker — one lock — one key",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "86e06b5d-5278-50c9-852f-f852b917b9de",
          "explanation": "Each crew member attaches a personal lock and keeps their own key: power cannot be applied until the last worker removes their lock.",
          "slideRefs": [
            "slide-32"
          ]
        },
        {
          "id": "c9327c09-beb9-5cfc-b8b8-a49e262d2a92",
          "text": "What is done if the work supervisor has to leave for a while?",
          "displayOrder": 10,
          "options": [
            {
              "id": "29480f69-db3a-5571-a23d-fb89d5151ffc",
              "text": "The crew is fully withdrawn from the installation",
              "displayOrder": 1
            },
            {
              "id": "df5f850b-3c22-5761-ad32-aa4ec2fc0bdd",
              "text": "Supervision is handed to a crew member with Group III",
              "displayOrder": 2
            },
            {
              "id": "617884c1-1494-5d04-98a8-e99adfd2ab1b",
              "text": "The switchgear doors are locked and work continues",
              "displayOrder": 3
            },
            {
              "id": "580147a6-3d6b-50c4-803a-c74c99a1a7c5",
              "text": "The absence is noted in the site operational log",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "29480f69-db3a-5571-a23d-fb89d5151ffc",
          "explanation": "Without the work supervisor's supervision, the crew may not stay in the switchgear or at height — it is withdrawn from the electrical installation.",
          "slideRefs": [
            "slide-34"
          ]
        }
      ]
    }
  ]
}
