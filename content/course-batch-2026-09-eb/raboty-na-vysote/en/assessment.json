{
  "schemaVersion": 1,
  "slug": "raboty-na-vysote",
  "locale": "en",
  "status": "draft-awaiting-independent-review",
  "policy": {
    "durationMinutes": 15,
    "passScore": 7,
    "questionCount": 10,
    "variantCount": 3,
