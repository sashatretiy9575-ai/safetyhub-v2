  "variants": [
    {
      "id": "5a17aee6-9ec3-59ec-99e6-ef1c22521985",
      "variantNumber": 1,
      "questions": [
        {
          "id": "ec7e7734-18f5-50ed-8c8d-a4eccda94ab4",
          "text": "С какой высоты работа считается работой на высоте по Правилам РК?",
          "displayOrder": 1,
          "options": [
            {
              "id": "3e5d15be-9c31-5ee1-8344-d0cb21a039e0",
              "text": "С 0,5 м и более",
              "displayOrder": 1
            },
            {
              "id": "4100667a-6ab5-5644-8bda-dec6ca8e3dcd",
              "text": "С 1,3 м и более",
              "displayOrder": 2
            },
            {
              "id": "a3a4b114-a1d7-58ac-a40c-12c0fe1c5511",
              "text": "С 3 м и более",
              "displayOrder": 3
            },
            {
              "id": "cfb1f352-bb53-5755-9636-8ccb16ab4e76",
              "text": "С 5 м и более",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "4100667a-6ab5-5644-8bda-dec6ca8e3dcd",
          "explanation": "По Правилам РК работа на высоте — это работа на высоте 1,3 м и более от поверхности грунта, перекрытия или настила и ближе 2 м от границы перепада.",
          "slideRefs": [
            "slide-05"
          ]
        },
        {
          "id": "fd8bb32d-f051-5055-8e4e-3f30fc937eef",
          "text": "Что по иерархии мер защиты от падения применяют раньше, чем СИЗ от падения?",
          "displayOrder": 2,
          "options": [
            {
              "id": "26b877db-1988-5985-a0b7-86116c51b9cb",
              "text": "Ограждения, леса и защитные сетки",
              "displayOrder": 1
            },
            {
              "id": "5029498d-b84f-51c9-b4f4-cacb8569504e",
              "text": "Страховочная система с амортизатором",
              "displayOrder": 2
            },
            {
              "id": "6ef87398-2ca3-5c95-87cb-c8fe9373f8e6",
              "text": "Дополнительный инструктаж перед сменой",
              "displayOrder": 3
            },
            {
              "id": "70708ffe-3f38-56a6-a510-d4e1fc875161",
              "text": "Более частые медосмотры работников",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "26b877db-1988-5985-a0b7-86116c51b9cb",
          "explanation": "СИЗ от падения — последнее средство защиты: приоритет отдаётся коллективной защите — ограждениям, перилам, лесам и сеткам.",
          "slideRefs": [
            "slide-06"
          ]
        },
        {
          "id": "52f32caf-7fc3-5500-836b-911df0672a61",
          "text": "Каким составом выполняются работы на высоте?",
          "displayOrder": 3,
          "options": [
            {
              "id": "2ceb85ba-7ed8-538e-bf71-1b2d045eb68a",
              "text": "Одним работником с телефоном",
              "displayOrder": 1
            },
            {
              "id": "8b15c2bf-de1e-5142-8c8c-73498a56f22a",
              "text": "Бригадой не менее 5 человек",
              "displayOrder": 2
            },
            {
              "id": "83a734b5-1c9e-5cc1-8f59-5c69e0bec825",
              "text": "Бригадой не менее 2 человек",
              "displayOrder": 3
            },
            {
              "id": "c01bde8d-ae95-5fde-bb8d-3166531c8d7a",
              "text": "Любым составом по усмотрению",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "83a734b5-1c9e-5cc1-8f59-5c69e0bec825",
          "explanation": "Работы на высоте выполняются по наряду-допуску бригадой (звеном) не менее чем из 2 человек.",
          "slideRefs": [
            "slide-07"
          ]
        },
        {
          "id": "2531ae75-2c54-5426-95e6-4bd3390f8109",
          "text": "Что означает буква B в правиле ABC страховочной системы?",
          "displayOrder": 4,
          "options": [
            {
              "id": "24ed89d8-c269-5fde-9eeb-00d06b52f010",
              "text": "Анкерное устройство (Anchor)",
              "displayOrder": 1
            },
            {
              "id": "a61bf202-abbb-5b79-bc82-952863d56d2d",
              "text": "Соединитель (Connector)",
              "displayOrder": 2
            },
            {
              "id": "6d91ea4d-42f4-5272-8ea2-fa22599b27f4",
              "text": "Привязь (Body wear)",
              "displayOrder": 3
            },
            {
              "id": "34d9dfee-4fc4-5653-88b0-27ba25a33002",
              "text": "Блокирующее устройство (Block)",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "6d91ea4d-42f4-5272-8ea2-fa22599b27f4",
          "explanation": "A — анкерное устройство, B — привязь (Body wear), C — соединитель: строп с амортизатором, блокирующее устройство втягивающего типа или зажим.",
          "slideRefs": [
            "slide-09"
          ]
        },
        {
          "id": "b9880ba5-958f-599f-81eb-e37a2cfb8319",
          "text": "Как вычисляют фактор падения?",
          "displayOrder": 5,
          "options": [
            {
              "id": "1cc46f01-c754-5cea-907c-43e629db6789",
              "text": "Длину стропа умножают на рост работника",
              "displayOrder": 1
            },
            {
              "id": "80cdc9bb-1dec-58e8-8922-ac7cf7a381ba",
              "text": "Высоту падения делят на длину стропа",
              "displayOrder": 2
            },
            {
              "id": "9f2a893c-4604-5ed5-b457-c3eeeb4b18aa",
              "text": "Высоту работ делят на 1,8 м",
              "displayOrder": 3
            },
            {
              "id": "d5fde8f9-b113-52cb-99a5-a5493c1600fe",
              "text": "Массу работника делят на прочность анкера",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "80cdc9bb-1dec-58e8-8922-ac7cf7a381ba",
          "explanation": "Фактор падения = высота падения / длина стропа; он определяет жёсткость рывка при срыве.",
          "slideRefs": [
            "slide-10"
          ]
        },
        {
          "id": "fc045619-c28e-58f5-8146-1eb55714ad01",
          "text": "На сколько приставная лестница должна выступать над площадкой выхода?",
          "displayOrder": 6,
          "options": [
            {
              "id": "0cc2178d-3214-5301-a0f4-20c4aad48cae",
              "text": "Не менее чем на 0,3 м",
              "displayOrder": 1
            },
            {
              "id": "9a6ff73d-9364-5827-9743-00cf6ceb8b09",
              "text": "Не менее чем на 2 м",
              "displayOrder": 2
            },
            {
              "id": "ed537a5a-4d63-5591-b27d-bf8dc894016a",
              "text": "Не менее чем на 1 м",
              "displayOrder": 3
            },
            {
              "id": "8d40304c-647c-5fd1-a0c3-e706f990b302",
              "text": "Выступать не должна",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "ed537a5a-4d63-5591-b27d-bf8dc894016a",
          "explanation": "Верхний край приставной лестницы должен выступать выше площадки выхода не менее чем на 1,0 м.",
          "slideRefs": [
            "slide-12"
          ]
        },
        {
          "id": "1b959108-1c70-58e5-9804-4b0cfba51c91",
          "text": "Что делают с привязью, которая удержала человека при срыве?",
          "displayOrder": 7,
          "options": [
            {
              "id": "2d9e3169-e08f-5e86-9b88-a2e124683b16",
              "text": "Изымают и уничтожают",
              "displayOrder": 1
            },
            {
              "id": "98de5cec-d592-514e-8c36-3c1f6dcabcb3",
              "text": "Осматривают и используют дальше",
              "displayOrder": 2
            },
            {
              "id": "f04fee63-6965-5272-88a8-145ff7c906b0",
              "text": "Стирают и возвращают на склад",
              "displayOrder": 3
            },
            {
              "id": "5abd2d82-f81e-5ba7-8857-0d26834b930e",
              "text": "Используют только для обучения",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "2d9e3169-e08f-5e86-9b88-a2e124683b16",
          "explanation": "Привязь, удержавшая человека при срыве, немедленно изымается из эксплуатации и уничтожается; об этом говорит и разорванный индикатор срыва.",
          "slideRefs": [
            "slide-13"
          ]
        },
        {
          "id": "f955f98f-390f-5c75-96d1-8a5e552b627b",
          "text": "С какой стороны запрещено подниматься на угловую опору ВЛ?",
          "displayOrder": 8,
          "options": [
            {
              "id": "5c2e4fc6-2e47-5b6a-a291-a53ba84f7b02",
              "text": "Со стороны внешнего угла проводов",
              "displayOrder": 1
            },
            {
              "id": "ebc63088-b7be-507b-8bbd-23b09d4f96a7",
              "text": "Со стороны подъездной дороги к опоре",
              "displayOrder": 2
            },
            {
              "id": "6450cb78-ac9a-5463-9902-95589c20cdff",
              "text": "Со стороны внутреннего угла проводов",
              "displayOrder": 3
            },
            {
              "id": "7816d844-7452-5604-92a5-ed89204b1ac7",
              "text": "Со стороны ближайшего анкера",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "6450cb78-ac9a-5463-9902-95589c20cdff",
          "explanation": "Подниматься на угловую опору со стороны внутреннего угла проводов строжайше запрещено.",
          "slideRefs": [
            "slide-17"
          ]
        },
        {
          "id": "0c632662-675c-5103-a69e-e21f416c50ff",
          "text": "Сколько времени по плану эвакуации и спасения отводится на спасение зависшего работника?",
          "displayOrder": 9,
          "options": [
            {
              "id": "0eb4d645-51f1-5fc0-8887-d767d273c400",
              "text": "До 10 минут",
              "displayOrder": 1
            },
            {
              "id": "06440a89-35f0-5314-a545-6da43d919951",
              "text": "До 1 часа",
              "displayOrder": 2
            },
            {
              "id": "5c1a27b5-3336-5301-9846-951d9d8b1a62",
              "text": "До 30 минут",
              "displayOrder": 3
            },
            {
              "id": "aa1a3532-74ae-5b25-bd1e-45d358204646",
              "text": "До 2 часов",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "0eb4d645-51f1-5fc0-8887-d767d273c400",
          "explanation": "По плану эвакуации и спасения время на спасение зависшего — до 10 минут: дольше висеть в привязи опасно для жизни.",
          "slideRefs": [
            "slide-19"
          ]
        },
        {
          "id": "160e33f7-56fe-5cb3-a4f7-e8fd68af3fde",
          "text": "Как размещают пострадавшего в сознании, снятого после зависания в привязи?",
          "displayOrder": 10,
          "options": [
            {
              "id": "e38c5071-7da9-547c-889e-ccb11bb852af",
              "text": "Полусидя, не укладывая на спину",
              "displayOrder": 1
            },
            {
              "id": "58862ac8-c7ed-507c-959c-1535a75f29c4",
              "text": "Горизонтально на спине с приподнятыми ногами",
              "displayOrder": 2
            },
            {
              "id": "4123f423-233f-5c1d-b4db-70939b9159a4",
              "text": "На животе, головой набок",
              "displayOrder": 3
            },
            {
              "id": "9fbfbbab-707f-5522-a4b0-878ce5756043",
              "text": "Стоя, с опорой на спасателя",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "e38c5071-7da9-547c-889e-ccb11bb852af",
          "explanation": "Пострадавшего в сознании сажают полусидя: резкая укладка на спину грозит «синдромом возврата». Если сознания нет, его укладывают горизонтально, а при остановке дыхания начинают СЛР.",
          "slideRefs": [
            "slide-20"
          ]
        }
      ]
    },
    {
      "id": "f4d8f385-b461-54f1-9f75-4cad59f88559",
      "variantNumber": 2,
      "questions": [
        {
          "id": "bed8a813-9dd8-557c-99d3-e17ee19aac24",
          "text": "С какого возраста допускаются к работам на высоте?",
          "displayOrder": 1,
          "options": [
            {
              "id": "a82ce103-36c3-588c-b9fd-5e3dd51b67f9",
              "text": "С 18 лет",
              "displayOrder": 1
            },
            {
              "id": "ffee55ad-d5d6-526a-b4c3-4c956ddd3c37",
              "text": "С 16 лет",
              "displayOrder": 2
            },
            {
              "id": "10501766-f4e5-5f4a-8d3f-ba42aae3de77",
              "text": "С 21 года",
              "displayOrder": 3
            },
            {
              "id": "4e96e0d9-9f84-57f0-aaaa-93b2a59ad83f",
              "text": "С 25 лет",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "a82ce103-36c3-588c-b9fd-5e3dd51b67f9",
          "explanation": "К работам на высоте допускаются лица, достигшие 18 лет, прошедшие обязательный медицинский осмотр и обучение по безопасности и охране труда.",
          "slideRefs": [
            "slide-07"
          ]
        },
        {
          "id": "30ebdf05-cd63-5eb9-9d9a-3d314b91bfbe",
          "text": "Сколько рабочих смен длится инструктаж работника, впервые допускаемого к работе на высоте?",
          "displayOrder": 2,
          "options": [
            {
              "id": "0747222d-df11-57c1-80d4-119c26dd5674",
              "text": "1 смену",
              "displayOrder": 1
            },
            {
              "id": "34b1658f-3493-52d4-bc12-4948a7ed4799",
              "text": "3 смены",
              "displayOrder": 2
            },
            {
              "id": "6fbed59b-6b5a-5450-88ae-139600eb88d7",
              "text": "5 смен",
              "displayOrder": 3
            },
            {
              "id": "a810c985-7ef1-5087-a5c0-a11f5f56ce00",
              "text": "10 смен",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "6fbed59b-6b5a-5450-88ae-139600eb88d7",
          "explanation": "Работники, впервые допускаемые к работе на высоте, проходят инструктаж ответственного руководителя в течение 5 рабочих смен.",
          "slideRefs": [
            "slide-07"
          ]
        },
        {
          "id": "006ce201-0aad-5adc-adb3-1abe50b9e4b8",
          "text": "Какая система физически не допускает работника к краю перепада высот?",
          "displayOrder": 3,
          "options": [
            {
              "id": "cd892df9-4acd-5f83-a537-2d05b94196bd",
              "text": "Страховочная система",
              "displayOrder": 1
            },
            {
              "id": "637c1fd0-6abb-5879-a3cb-8d4de0dca167",
              "text": "Удерживающая система",
              "displayOrder": 2
            },
            {
              "id": "9ee614e7-472d-55b4-87c7-26734753af06",
              "text": "Спасательная система",
              "displayOrder": 3
            },
            {
              "id": "19040396-a329-5e49-b758-194df8d549ef",
              "text": "Система сигнальных лент",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "637c1fd0-6abb-5879-a3cb-8d4de0dca167",
          "explanation": "Удерживающая система — привязь и строп фиксированной длины — не даёт подойти к краю, поэтому срыв исключён.",
          "slideRefs": [
            "slide-08"
          ]
        },
        {
          "id": "404b9148-df90-55c6-8afb-983732eb4c96",
          "text": "К чему запрещено крепить строп страховочной системы?",
          "displayOrder": 4,
          "options": [
            {
              "id": "5d138b7e-2519-5f57-b825-b8d2e9042810",
              "text": "К стационарным анкерным точкам",
              "displayOrder": 1
            },
            {
              "id": "3ecc6c9d-25c3-5837-9d2e-443fba523d97",
              "text": "К гибкой горизонтальной анкерной линии",
              "displayOrder": 2
            },
            {
              "id": "a29ace51-8536-5e77-b718-7482c5f9b24a",
              "text": "К балочному зажиму на двутавре",
              "displayOrder": 3
            },
            {
              "id": "435fddab-9d7a-51e0-b254-f139c3e496ce",
              "text": "К трубопроводам и кабельным лоткам",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "435fddab-9d7a-51e0-b254-f139c3e496ce",
          "explanation": "Строп крепят только к проверенным несущим конструкциям; трубопроводы, кабельные лотки, радиаторы и оконные рамы для этого запрещены.",
          "slideRefs": [
            "slide-11"
          ]
        },
        {
          "id": "0e630aed-0302-585c-b7ba-068ba4814a52",
          "text": "Под каким углом к горизонту устанавливают приставную лестницу?",
          "displayOrder": 5,
          "options": [
            {
              "id": "ecc8dd90-c3a5-5c2a-878c-65d638870957",
              "text": "45–50 градусов",
              "displayOrder": 1
            },
            {
              "id": "92c02f6c-6d64-53a8-a465-53ec7ef5b7d1",
              "text": "55–60 градусов",
              "displayOrder": 2
            },
            {
              "id": "d086b4c4-8cbe-526f-8f17-18a055dac019",
              "text": "70–75 градусов",
              "displayOrder": 3
            },
            {
              "id": "36fe6c73-d04e-5db0-ae4c-607681d71fd3",
              "text": "85–90 градусов",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "d086b4c4-8cbe-526f-8f17-18a055dac019",
          "explanation": "Приставную лестницу ставят под углом 70–75° (высота к основанию примерно 4 к 1) и выводят на 1 м выше площадки.",
          "slideRefs": [
            "slide-12"
          ]
        },
        {
          "id": "68e78e12-e1ea-5013-81c4-a6660ed0df69",
          "text": "Как проверить подгонку набедренных лямок привязи?",
          "displayOrder": 6,
          "options": [
            {
              "id": "53abc221-e7a3-57f4-a155-2e90aef6efed",
              "text": "Под лямку должен свободно проходить кулак",
              "displayOrder": 1
            },
            {
              "id": "3f818a7b-524f-522a-8d06-7e8e659bd9a0",
              "text": "Лямка должна свободно висеть на бедре",
              "displayOrder": 2
            },
            {
              "id": "03a25a32-dbc3-52cb-9520-9c590de8514c",
              "text": "Под лямку должна плотно проходить ладонь",
              "displayOrder": 3
            },
            {
              "id": "7e3854a4-d79e-57c8-bcc3-580681147dd0",
              "text": "Лямку затягивают до онемения ног",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "03a25a32-dbc3-52cb-9520-9c590de8514c",
          "explanation": "При правильной подгонке ладонь плотно проходит под набедренную ленту: не туже и не свободнее.",
          "slideRefs": [
            "slide-13"
          ]
        },
        {
          "id": "2e4c1c55-9592-5da3-a40d-bc5584d22162",
          "text": "При какой скорости ветра прекращают обычные работы на высоте?",
          "displayOrder": 7,
          "options": [
            {
              "id": "831180c0-23e3-5fa0-994e-2a13557d5c86",
              "text": "5 м/с и более",
              "displayOrder": 1
            },
            {
              "id": "5fc3e37b-a4b1-59d6-84ef-764a989b3e8f",
              "text": "15 м/с и более",
              "displayOrder": 2
            },
            {
              "id": "e26655ac-32a2-531e-b567-a21f4c7e0b13",
              "text": "8 м/с и более",
              "displayOrder": 3
            },
            {
              "id": "a34f1eb8-811e-54c3-a8e5-8579cd03d3c0",
              "text": "25 м/с и более",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "5fc3e37b-a4b1-59d6-84ef-764a989b3e8f",
          "explanation": "Работы на высоте останавливают при ветре 15 м/с и более, а при монтаже глухих конструкций и панелей — уже при 10 м/с.",
          "slideRefs": [
            "slide-15"
          ]
        },
        {
          "id": "a4995bd3-ad38-5a10-8633-e4cf2a0fa215",
          "text": "На каком расстоянии от крайнего провода ВЛ работы с автогидроподъёмника ведут только по наряду-допуску?",
          "displayOrder": 8,
          "options": [
            {
              "id": "d7d161f3-e215-5eb6-ac18-00345ac55b3d",
              "text": "Менее 3 м",
              "displayOrder": 1
            },
            {
              "id": "30f1d1dc-f880-5a03-b977-6b62b4c2ebcc",
              "text": "Менее 30 м",
              "displayOrder": 2
            },
            {
              "id": "57e03214-681b-5bca-9451-42e923be15a6",
              "text": "Менее 100 м",
              "displayOrder": 3
            },
            {
              "id": "283e1773-f88f-569d-8753-34fc2ae4fc05",
              "text": "Менее 300 м",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "30f1d1dc-f880-5a03-b977-6b62b4c2ebcc",
          "explanation": "Работы на расстоянии менее 30 м от крайнего провода ВЛ выполняются только по наряду-допуску и под надзором руководителя.",
          "slideRefs": [
            "slide-18"
          ]
        },
        {
          "id": "3ca0d2b2-ec13-5486-83f0-f1d5d05ee8d5",
          "text": "Через какое время неподвижного висения в привязи может наступить потеря сознания?",
          "displayOrder": 9,
          "options": [
            {
              "id": "f56224ef-1078-575e-bcb2-da28463138e4",
              "text": "Через 1–2 часа",
              "displayOrder": 1
            },
            {
              "id": "08d9b447-0323-58e8-87b5-ec85c09d0b27",
              "text": "Через 30–40 минут",
              "displayOrder": 2
            },
            {
              "id": "9fd3722d-d5a1-5c30-901f-b1de4785f064",
              "text": "Через 3–4 часа",
              "displayOrder": 3
            },
            {
              "id": "c4aa0915-fb6e-5aad-b426-b304f2c3b07e",
              "text": "Через 5–10 минут",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "c4aa0915-fb6e-5aad-b426-b304f2c3b07e",
          "explanation": "Через 5–10 минут неподвижного висения наступают гипоксия мозга, потеря сознания и остановка сердца.",
          "slideRefs": [
            "slide-20"
          ]
        },
        {
          "id": "354b867a-8a90-544d-bd7d-b04c779ceabc",
          "text": "Что делают, если во время работы на высоте обнаружен надрыв стропа?",
          "displayOrder": 10,
          "options": [
            {
              "id": "cc06b706-c7f2-5667-812e-10bfc12e51f4",
              "text": "Доделывают задание и сообщают",
              "displayOrder": 1
            },
            {
              "id": "057cea16-e7cc-59b3-97fa-efde1df46830",
              "text": "Немедленно останавливают работу",
              "displayOrder": 2
            },
            {
              "id": "c80ecc07-3373-57e7-bf1c-b23f44774397",
              "text": "Заклеивают надрыв изолентой",
              "displayOrder": 3
            },
            {
              "id": "ca3570d5-b685-504b-9c03-c9431bf8431e",
              "text": "Перестёгиваются на тот же строп",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "057cea16-e7cc-59b3-97fa-efde1df46830",
          "explanation": "Обнаружение дефекта или надрыва привязи, стропа, карабина или анкерной линии — причина безусловной остановки работ.",
          "slideRefs": [
            "slide-23"
          ]
        }
      ]
    },
    {
      "id": "d09a0429-5019-5df3-b7c4-aff6bd27cb24",
      "variantNumber": 3,
      "questions": [
        {
          "id": "8e7a94be-8f73-5312-bf08-8b4df9b0a55a",
          "text": "Что нужно работнику для допуска к работам на высоте, кроме возраста 18 лет?",
          "displayOrder": 1,
          "options": [
            {
              "id": "926e286b-a139-5006-81d1-4addb1d6bab2",
              "text": "Только устное разрешение мастера",
              "displayOrder": 1
            },
            {
              "id": "b97ab8f6-f382-5d97-af0a-2468b69ea0a4",
              "text": "Медосмотр и удостоверение об обучении",
              "displayOrder": 2
            },
            {
              "id": "5eeca4d3-67da-5ae7-aa9a-31487edb49fc",
              "text": "Стаж на высоте не менее трёх лет",
              "displayOrder": 3
            },
            {
              "id": "cd628952-b685-5949-bf40-077b611564ff",
              "text": "Разряд по рабочей профессии не ниже 4-го",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "b97ab8f6-f382-5d97-af0a-2468b69ea0a4",
          "explanation": "Работник должен достичь 18 лет, пройти обязательный медицинский осмотр и иметь удостоверение об обучении по безопасности и охране труда.",
          "slideRefs": [
            "slide-07"
          ]
        },
        {
          "id": "377b725c-124a-5634-950b-c2862757cd15",
          "text": "Какая мера защиты от падения стоит первой в иерархии?",
          "displayOrder": 2,
          "options": [
            {
              "id": "5550145e-9d6a-5847-9973-02ea282ba861",
              "text": "Установить коллективные ограждения",
              "displayOrder": 1
            },
            {
              "id": "4711dca8-0161-5c6d-9998-3ce9266218f5",
              "text": "Применить удерживающую систему",
              "displayOrder": 2
            },
            {
              "id": "294b5628-8ed5-5e9a-888a-493efd04fc45",
              "text": "Исключить работу на высоте",
              "displayOrder": 3
            },
            {
              "id": "7053a9c7-13d2-55fc-8eee-ed841c1f8247",
              "text": "Надеть страховочную привязь",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "294b5628-8ed5-5e9a-888a-493efd04fc45",
          "explanation": "Сначала работу на высоте исключают, затем применяют коллективную защиту, удержание и только потом — остановку падения. СИЗ — последнее средство.",
          "slideRefs": [
            "slide-06"
          ]
        },
        {
          "id": "ffeacb11-7ba4-5db8-bc79-28de2f091a66",
          "text": "Можно ли применять поясной монтажный ремень без наплечных и набедренных лямок как страховочную систему?",
          "displayOrder": 3,
          "options": [
            {
              "id": "be5fe39b-0481-553a-95fc-a20b0c68fb99",
              "text": "Запрещено только на высоте более 5 м",
              "displayOrder": 1
            },
            {
              "id": "84477434-d150-578a-adc3-8066907cefa3",
              "text": "Нет, это запрещено",
              "displayOrder": 2
            },
            {
              "id": "08a01a70-f1b8-50da-a31c-913fae8b2cb1",
              "text": "Да, если к ремню подключён амортизатор",
              "displayOrder": 3
            },
            {
              "id": "f72746c5-b905-5008-b41a-09e892bcbdb1",
              "text": "Да, если есть надёжный анкер",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "84477434-d150-578a-adc3-8066907cefa3",
          "explanation": "Поясной ремень без лямок запрещён в качестве страховочной системы: остановить падение может только полная страховочная привязь.",
          "slideRefs": [
            "slide-08"
          ]
        },
        {
          "id": "c8642646-3b34-5007-aa1a-796ad3644f92",
          "text": "До какой величины амортизатор страховочной системы снижает силу рывка на тело?",
          "displayOrder": 4,
          "options": [
            {
              "id": "129e8362-d417-5600-b0a0-6e54eb5d8453",
              "text": "До 6 кН и менее",
              "displayOrder": 1
            },
            {
              "id": "4fd3e8bb-e9a4-5c01-9487-d948f61b43c2",
              "text": "До 12 кН и менее",
              "displayOrder": 2
            },
            {
              "id": "903fb0b9-525d-5eb2-b31d-e35ef4410229",
              "text": "До 22 кН и менее",
              "displayOrder": 3
            },
            {
              "id": "75e7ce1f-a747-57c6-8a80-a936f402354b",
              "text": "До 1 кН и менее",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "129e8362-d417-5600-b0a0-6e54eb5d8453",
          "explanation": "Амортизатор гасит удар и снижает силу рывка на тело до 6 кН и менее.",
          "slideRefs": [
            "slide-08"
          ]
        },
        {
          "id": "ff34658d-a7b2-5a62-a16f-575c2c90b463",
          "text": "Как соблюдают правило 100% привязи при перемещении по конструкциям?",
          "displayOrder": 5,
          "options": [
            {
              "id": "3dbcbdb2-5c3e-522b-952a-f9a21be2f768",
              "text": "Отстёгиваются только на ровных участках",
              "displayOrder": 1
            },
            {
              "id": "5d39eeb2-b584-58da-bdc6-5f9e8cc730d7",
              "text": "Держатся руками за конструкции без стропа",
              "displayOrder": 2
            },
            {
              "id": "0f11e3ce-4ef1-5be9-bc84-dd45d4e0fd15",
              "text": "Перестёгивают один строп на каждом шаге",
              "displayOrder": 3
            },
            {
              "id": "c5ea8cac-e7c9-535d-9f5f-469c50e0b1fe",
              "text": "Y-стропом: один ус всегда пристёгнут",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "c5ea8cac-e7c9-535d-9f5f-469c50e0b1fe",
          "explanation": "Для непрерывной страховки используют двухплечевой (Y-образный) строп: пока один ус перестёгивают, второй остаётся пристёгнутым.",
          "slideRefs": [
            "slide-09"
          ]
        },
        {
          "id": "d9628462-5433-5d53-9242-2593e6791e8b",
          "text": "При каком положении анкера фактор падения равен 2?",
          "displayOrder": 6,
          "options": [
            {
              "id": "63a9a055-5682-5009-a3d4-eceaa8c86fa5",
              "text": "Анкер выше головы",
              "displayOrder": 1
            },
            {
              "id": "a7990755-e561-5647-81de-558a724947e5",
              "text": "Анкер на уровне стоп",
              "displayOrder": 2
            },
            {
              "id": "646fcba3-5ebb-5583-9efe-e06ecc90431a",
              "text": "Анкер на уровне груди или плеч",
              "displayOrder": 3
            },
            {
              "id": "37589596-1ee4-50fd-866c-713880fa2d32",
              "text": "Анкер на уровне пояса соседнего работника",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "a7990755-e561-5647-81de-558a724947e5",
          "explanation": "Фактор 2 — анкер на уровне стоп: свободное падение равно двойной длине стропа. Строп крепят как можно выше головы.",
          "slideRefs": [
            "slide-10"
          ]
        },
        {
          "id": "1d69a824-b347-5d9a-9c39-c72a484bf7f6",
          "text": "Что относится к анкерным устройствам класса C?",
          "displayOrder": 7,
          "options": [
            {
              "id": "50283500-ab02-5a84-9e64-184325a9cc6a",
              "text": "Гибкие горизонтальные тросовые линии",
              "displayOrder": 1
            },
            {
              "id": "02ea5875-3f2f-5296-93f9-da986134cd4c",
              "text": "Стационарные точки на несущих конструкциях",
              "displayOrder": 2
            },
            {
              "id": "c1fa0ebe-b9e2-5fea-9739-ce863ac8b690",
              "text": "Переносные треноги и струбцины",
              "displayOrder": 3
            },
            {
              "id": "d246c759-c440-5a02-bd3d-05f96b5194df",
              "text": "Жёсткие рельсовые линии с кареткой",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "50283500-ab02-5a84-9e64-184325a9cc6a",
          "explanation": "Класс C — гибкие горизонтальные тросовые линии; класс A — стационарные точки, B — переносные устройства, D — жёсткие рельсовые линии.",
          "slideRefs": [
            "slide-11"
          ]
        },
        {
          "id": "7fd6d61d-3ffe-55e9-9129-a309d1871826",
          "text": "С каких ступеней стремянки без перил и огражденной площадки запрещено работать?",
          "displayOrder": 8,
          "options": [
            {
              "id": "17ee5148-462d-57cf-be17-8abd46f0f997",
              "text": "С двух нижних ступеней",
              "displayOrder": 1
            },
            {
              "id": "1b147d3b-8f64-5d5c-bbbb-639b306a3f5d",
              "text": "С двух верхних ступеней",
              "displayOrder": 2
            },
            {
              "id": "17e4567f-5c2a-5207-8d8e-fd6a04752376",
              "text": "Со средних ступеней",
              "displayOrder": 3
            },
            {
              "id": "70b95d21-9f1f-5c8e-8f0f-61699afa2259",
              "text": "С любой ступени выше первой",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "1b147d3b-8f64-5d5c-bbbb-639b306a3f5d",
          "explanation": "Запрещено работать с двух верхних ступеней стремянок, не имеющих перил и огражденных площадок.",
          "slideRefs": [
            "slide-12"
          ]
        },
        {
          "id": "0b624a5d-2f10-5a32-ab49-55d4d1dbe66d",
          "text": "Можно ли перемещать автогидроподъёмник, когда в люльке находятся люди?",
          "displayOrder": 9,
          "options": [
            {
              "id": "f0a053ad-cfa4-55d6-8e59-99e74980e1d3",
              "text": "Да, на малой скорости",
              "displayOrder": 1
            },
            {
              "id": "38256525-d67f-566f-89a9-a7fcc7ab7861",
              "text": "Да, если стрела опущена",
              "displayOrder": 2
            },
            {
              "id": "1a85ac09-b92a-559d-8688-b30e1089b92d",
              "text": "Запрещено, только если люди не пристёгнуты",
              "displayOrder": 3
            },
            {
              "id": "5380ea39-a679-5c1c-9490-b1234f559d06",
              "text": "Нет, это запрещено",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "5380ea39-a679-5c1c-9490-b1234f559d06",
          "explanation": "Передвижение подъёмника с людьми в люльке или с поднятой стрелой категорически запрещено.",
          "slideRefs": [
            "slide-18"
          ]
        },
        {
          "id": "37feb015-3f73-5ce5-8920-07ebd9bd72cd",
          "text": "Каково соотношение компрессий грудной клетки и вдохов при сердечно-лёгочной реанимации?",
          "displayOrder": 10,
          "options": [
            {
              "id": "ebf94061-9e3a-5887-9cf0-57d9aeb54679",
              "text": "15 к 1",
              "displayOrder": 1
            },
            {
              "id": "ba186fd7-78cc-5439-a59c-8d2ec88f3763",
              "text": "5 к 1",
              "displayOrder": 2
            },
            {
              "id": "9298ccc4-37d3-5084-9cee-f8018b054053",
              "text": "10 к 2",
              "displayOrder": 3
            },
            {
              "id": "5d945097-2094-52c7-9315-928de82a2784",
              "text": "30 к 2",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "5d945097-2094-52c7-9315-928de82a2784",
          "explanation": "СЛР: 30 нажатий на середину грудины глубиной 5–6 см с частотой 100–120 в минуту, затем 2 вдоха.",
          "slideRefs": [
            "slide-22"
          ]
        }
      ]
    }
  ]
}
