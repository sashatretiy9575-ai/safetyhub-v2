{
  "version": 1,
  "courseId": "697acb0f-4761-4eef-bdd3-191939cf0afb",
  "locale": "zh",
  "expectedVersion": 1,
  "questionVariants": [
    {
      "id": "0ed3fd0d-07bb-53ee-8c0b-dda4bd89ba1e",
      "variantNumber": 1,
      "questions": [
        {
          "id": "7d6d72f1-1f4d-5a6c-be94-d6478feeb5d0",
          "text": "脚手架使用者拆除斜系带以搬运材料。如何进行？",
          "options": [
            {
              "id": "b2a38aee-d39c-54d9-ba98-d36287ef7c82",
              "text": "立即停止使用该场地并由授权项目人员恢复结构。"
            },
            {
              "id": "fb43b758-cfa3-54a8-beda-832bd5f697c5",
              "text": "保持连接断开直到班次结束。"
            },
            {
              "id": "84365384-7574-5305-be87-5f52ccc118a1",
              "text": "用绳索替换连接。"
            },
            {
              "id": "cc2f5921-89d1-5112-b37b-169f94ccda05",
              "text": "如果甲板上只有一个人，则允许操作。"
            }
          ],
          "explanation": ""
        },
        {
          "id": "6769c0ca-1f86-5959-910f-e160a39fefb4",
          "text": "脚手架底座板设置在松软地面上，下面没有垫板。应采取什么措施？",
          "options": [
            {
              "id": "1f96b1f0-e729-5e0b-a7dc-fa4421bac739",
              "text": "在板的一侧下方放置一块随机砖块。"
            },
            {
              "id": "59833fc2-168e-5ea3-a833-73b5279dacdb",
              "text": "增加支架上的负载以压实土壤。"
            },
            {
              "id": "1a29a980-87fa-5192-bb7f-8e642f7b37fa",
              "text": "用脚将柱子周围的土壤压实。"
            },
            {
              "id": "f6fdebc8-0ac1-50d5-93bc-31dcfff2fe47",
              "text": "停止安装，根据设计和系统护照准备稳定的基础。"
            }
          ],
          "explanation": ""
        },
        {
          "id": "125ee8c2-aef7-5702-a648-7bb0b2933bc9",
          "text": "强风过后，地面没有明显的损坏。可以立即复工吗？",
          "options": [
            {
              "id": "2a89d0af-4b8a-502b-877c-cadbd559834e",
              "text": "是的，如果您减少地板上的材料用量。"
            },
            {
              "id": "5cda491d-e173-59ca-830d-f4743255aae9",
              "text": "是，如果作业平台 干燥。"
            },
            {
              "id": "cb51c0bb-c96f-5ef0-bd02-319969219a72",
              "text": "不可以；脚手架必须先由具备相应能力的人员进行专项检查，确认合格后方可投入使用。"
            },
            {
              "id": "03e6539b-0d79-5bf1-88f7-8df08f169440",
              "text": "是的，如果工人使用安全帽。"
            }
          ],
          "explanation": ""
        },
        {
          "id": "63665f9e-9350-57c8-8608-47145e4c7205",
          "text": "在 作业平台 存储的材料超过规定的允许负载。该怎么办？",
          "options": [
            {
              "id": "861a440c-60ad-5017-b768-4fb4abdeff47",
              "text": "将负载分布在甲板的一个边缘。"
            },
            {
              "id": "db1297af-0b4e-5140-8504-828c70032638",
              "text": "立即停止荷载，调整荷载至设计及脚手架状态。"
            },
            {
              "id": "77324bd6-f300-5dc9-9b81-3054fa118d76",
              "text": "拆掉一些领带以扩大空间。"
            },
            {
              "id": "feb744da-75ef-5e26-a0ef-741949d0bcbc",
              "text": "允许短时间过载。"
            }
          ],
          "explanation": ""
        },
        {
          "id": "088d7595-6f55-579b-adfa-695b5e0f73f0",
          "text": "为什么脚手架连接到结构上？",
          "options": [
            {
              "id": "226944f1-0e15-5225-bda3-9b76c98763ee",
              "text": "替换所有对角括号。"
            },
            {
              "id": "cce74001-f22f-5a68-bb8d-d9bcd0125dcb",
              "text": "无需计算即可增加甲板宽度。"
            },
            {
              "id": "7e3b8568-f6b9-5657-ad1f-62697c4cdfdb",
              "text": "仅用于层高度指示。"
            },
            {
              "id": "b42c12c1-1cab-5793-97f5-aca894172bf4",
              "text": "确保根据设计安装图计算的空间稳定性。"
            }
          ],
          "explanation": ""
        },
        {
          "id": "0e6cf77a-3615-5ba9-ae0e-6bdee837ebfc",
          "text": "工人作业平台 应该是什么样的？",
          "options": [
            {
              "id": "b450e982-07b2-55dc-a0ff-10ea8400a86c",
              "text": "在规定限度内连续、稳定、安全且无危险间隙或损坏。"
            },
            {
              "id": "754cd847-3821-5af8-9f2a-6094cb1084d8",
              "text": "向外缘倾斜，以便排水。"
            },
            {
              "id": "918b5257-b1c8-501c-86e0-8b255d4b6a27",
              "text": "松散存放，以便快速拆卸。"
            },
            {
              "id": "f2a66ca0-9e68-56ef-8a6f-cd3a27865c77",
              "text": "由不同厚度的任何碎片编译而成。"
            }
          ],
          "explanation": ""
        },
        {
          "id": "102f95b2-ba00-5633-ab4c-a61ecb8e9b4f",
          "text": "安装脚手架时优先考虑哪种防坠落措施？",
          "options": [
            {
              "id": "c2f82404-2cc7-592d-aefc-3567866e6833",
              "text": "安装人员仅可自行决定。"
            },
            {
              "id": "153ab31f-64ab-5fd0-a5f0-a497c30b6762",
              "text": "只有安全帽，没有防护栏和防坠落系统。"
            },
            {
              "id": "ebe1ded0-9d23-5ad5-928e-5ad8ec3e1989",
              "text": "提供集体保护技术，并在需要时辅以防坠落系统。"
            },
            {
              "id": "48976c8f-9a45-5bb8-9391-26b0e39eeffa",
              "text": "口头身高警告。"
            }
          ],
          "explanation": ""
        },
        {
          "id": "5830f751-52f8-5dc5-a840-bceb70397b48",
          "text": "脚手架投入使用的正确顺序是什么？",
          "options": [
            {
              "id": "f6c1cd59-53ed-5518-a865-d54dfdcc29ed",
              "text": "仅检查底层并打开所有级别。"
            },
            {
              "id": "3a2c6419-0bd4-51cd-b30b-3e215e7f23c9",
              "text": "在不检查结构的情况下安装标记。"
            },
            {
              "id": "12f99518-f581-56c3-beeb-d9bbd6e203fe",
              "text": "允许操作，然后在轮班结束时检查脚手架。"
            },
            {
              "id": "c692f7b0-5b06-5f2a-ae85-d6884920a2c4",
              "text": "按图完成安装，并由合格人员检查，记录结果并指示状态。"
            }
          ],
          "explanation": ""
        },
        {
          "id": "e3376089-fa59-5718-b389-8060e6a2e615",
          "text": "脚手架拆除的安全顺序是什么？",
          "options": [
            {
              "id": "4bc987f8-5d1f-5202-bc47-fa2f717af096",
              "text": "在没有指导的情况下同时拆卸不相关的区域。"
            },
            {
              "id": "c63ab398-96b4-5b61-a53f-d029eaf11be2",
              "text": "根据批准的方案以相反的技术顺序进行，同时保持稳定并围起区域。"
            },
            {
              "id": "e30deb60-bb97-578e-a707-1b312903349b",
              "text": "首先拆除所有锚固件，然后拆除甲板。"
            },
            {
              "id": "c41abc59-33f1-5167-ac20-cb32ceea4d31",
              "text": "将元素扔进围栏区域。"
            }
          ],
          "explanation": ""
        },
        {
          "id": "2b1de486-d32a-5e2b-846d-463d53d4c922",
          "text": "谁是使用脚手架工作的合格人员？",
          "options": [
            {
              "id": "79039d02-270e-5f8c-9b04-350c03b4f403",
              "text": "任何先达到作业平台的用户。"
            },
            {
              "id": "3931d09f-3412-546c-872d-75dc58d26eea",
              "text": "作业人员，仅传输物料。"
            },
            {
              "id": "c670127b-013f-588f-abfa-31c18b24fb4d",
              "text": "分配给 作业人员 并具有所分配的审查和决策所需的知识和权限。"
            },
            {
              "id": "a51e2917-0fc9-501a-8811-5d65cd71707a",
              "text": "任何参观建筑工地的访客。"
            }
          ],
          "explanation": ""
        }
      ]
    },
    {
      "id": "8cb0b85c-fab5-5e92-b733-6b0a969f201c",
      "variantNumber": 2,
      "questions": [
        {
          "id": "5692c857-f86e-5af4-a9f3-10bc7aa390ed",
          "text": "一名没有相应作业许可的人员提出改变作业平台高度。应如何处理？",
          "options": [
            {
              "id": "e3bf3016-7928-5642-ae21-b8085f4dc1be",
              "text": "如果不使用工具则允许。"
            },
            {
              "id": "97728e58-c94a-57b4-803f-cec8b36d05a3",
              "text": "移除防护装置以加快传输速度。"
            },
            {
              "id": "223449d7-d4b4-5bf4-a3f8-5ac42668e7c3",
              "text": "不允许更改；安装和搬迁由经过培训的指定人员进行。"
            },
            {
              "id": "a52cc2f9-1919-5390-b965-498acbe8cefe",
              "text": "允许在同事口头监督下进行修改。"
            }
          ],
          "explanation": ""
        },
        {
          "id": "b47dee41-0c82-5cc4-a039-350b4e6e0534",
          "text": "雨后，脚手架基础下方出现沉降。应如何处理？",
          "options": [
            {
              "id": "bb9dc14b-a142-5620-b79e-521b7e55b167",
              "text": "继续工作直至轮班结束。"
            },
            {
              "id": "d162894e-0fbe-5857-a43c-9678f14688f5",
              "text": "关闭通道，使用安全程序卸载该区域，并对底座进行检查和修复。"
            },
            {
              "id": "361169d2-ff9f-55a6-b299-5b7403b6005a",
              "text": "当有人在甲板上时敲掉楔子。"
            },
            {
              "id": "79a96c3d-56c1-5d2f-88d3-4b1ef9e1ee16",
              "text": "在对面添加材料。"
            }
          ],
          "explanation": ""
        },
        {
          "id": "d78550a6-f3bc-5ed4-a205-c0045e20c637",
          "text": "地板上结冰。如何进行？",
          "options": [
            {
              "id": "3c3df9c7-38ad-514b-a997-518dc47d91ee",
              "text": "继续工作时，在冰上撒上锯末。"
            },
            {
              "id": "ba7f9851-6efe-5a3c-94f2-0011ae1d4120",
              "text": "动作要快一点，以免耽误。"
            },
            {
              "id": "89fe62b1-96d7-5ff7-9e0c-57c662f5351c",
              "text": "拆下扶手，方便清洁。"
            },
            {
              "id": "3bc6520e-d425-5cb5-8b42-744bc4852ccc",
              "text": "停止使用该区域，直至安全纠正滑倒并重新评估情况。"
            }
          ],
          "explanation": ""
        },
        {
          "id": "276bdb24-899e-59a9-a079-915e8a10ac45",
          "text": "在地板上发现一块松动的木板。我应该怎么办？",
          "options": [
            {
              "id": "69ba8e8c-97b6-54d8-ae0d-4dd4a2354e71",
              "text": "使用前由授权人员覆盖区域并固定或更换作业平台。"
            },
            {
              "id": "63a52059-277f-549a-a2fa-c54e5e53ebc4",
              "text": "用材料压板。"
            },
            {
              "id": "d16ba25c-c20f-5080-8ebd-daf1bf9a419f",
              "text": "警告工人跨过危险区域。"
            },
            {
              "id": "a26078f2-afd5-58bb-9c4b-cd0d6e416560",
              "text": "把木板翻面后继续作业。"
            }
          ],
          "explanation": ""
        },
        {
          "id": "037aec4a-3506-52d6-8828-f206bdd1126b",
          "text": "是否可以使用一个通用数来确定锚的节距？",
          "options": [
            {
              "id": "0d718307-9bf4-5d45-adff-a1d3cc0e4439",
              "text": "是的，如果脚手架低于相邻建筑物。"
            },
            {
              "id": "08e43fa8-4283-54e7-9279-4226642e7693",
              "text": "否；参数是根据项目、制造商的护照和特定系统的图表来获取的。"
            },
            {
              "id": "4f8d5e48-fe99-595c-875d-3f58c133b1cf",
              "text": "是的，一个号码适用于所有脚手架。"
            },
            {
              "id": "88e01f70-2df5-5bdd-9345-f90b6d0e9793",
              "text": "是的，如果外墙是混凝土制成的。"
            }
          ],
          "explanation": ""
        },
        {
          "id": "80b90315-86eb-5bec-a434-decfe2472630",
          "text": "应如何设置通往脚手架各作业层的安全通道？",
          "options": [
            {
              "id": "36ba0b91-3604-53d8-85c3-1948ab40c06a",
              "text": "无需特殊装置即可安装在框架外侧。"
            },
            {
              "id": "a6b89ee5-d17c-5b43-b063-20038708fc63",
              "text": "通过对角线连接。"
            },
            {
              "id": "c5ca6347-4f20-5fa8-8458-bd85b94a59cb",
              "text": "在不适合人员使用的装载平台上举升。"
            },
            {
              "id": "35972f2b-340f-5f09-88ea-27f001e4d79a",
              "text": "沿着提供的楼梯或楼梯段，正确紧固并设置受保护的开口。"
            }
          ],
          "explanation": ""
        },
        {
          "id": "1ad23bc6-8cd8-5542-b6cd-321a6b48f47e",
          "text": "防坠落锚点选在脚手架的任意构件上。应如何处理？",
          "options": [
            {
              "id": "5a018eef-1ea9-5bb0-bd65-c0a5ce0f950d",
              "text": "将安全带连接到同事的腰带上。"
            },
            {
              "id": "c214b37c-fd62-5be7-a454-a930aed00419",
              "text": "忽略可能的自由落体。"
            },
            {
              "id": "73e0e34f-a84a-5587-9fce-730b2c157d2e",
              "text": "仅使用计划和计算的连接点，并考虑净空高度。"
            },
            {
              "id": "66aa8c10-46cd-5746-964a-4a3ce2f48e2f",
              "text": "无需检查即可固定到最近的扶手上。"
            }
          ],
          "explanation": ""
        },
        {
          "id": "40af5b4c-0367-5887-acc8-a4345d2945b1",
          "text": "脚手架改动后的检查包括哪些内容？",
          "options": [
            {
              "id": "95e170ff-1018-5cbc-97c9-1ec860a4d5bd",
              "text": "仅检查顶部扶手。"
            },
            {
              "id": "46eb5597-d542-5ecc-863f-d807e1adaab3",
              "text": "检查底座、元件、连接、紧固件、甲板、围栏和通道，并记录状态。"
            },
            {
              "id": "0273376d-ad87-54f4-9e71-74878c15f9ef",
              "text": "仅检查标记的颜色。"
            },
            {
              "id": "134c0c5f-1d18-5947-a4ff-b4f6cbde0720",
              "text": "仅检查员工人数。"
            }
          ],
          "explanation": ""
        },
        {
          "id": "a5d5a75a-0515-59db-86eb-8c53cebe713a",
          "text": "脚手架上标有“请勿使用”。该怎么办？",
          "options": [
            {
              "id": "27a8292d-2ccc-59fb-baa5-951787848670",
              "text": "不要进入脚手架，等待原因消除并由合格人员签发新许可证。"
            },
            {
              "id": "68fa6851-7873-550c-b2a7-3f7e22d91fe2",
              "text": "仅使用较低层。"
            },
            {
              "id": "be6d595e-9eb8-55d1-9f16-e50b64720e27",
              "text": "经同事口头许可后删除标记。"
            },
            {
              "id": "5c0bd61c-8592-541d-b04d-71d603f410fb",
              "text": "无需材料即可工作，保持标记。"
            }
          ],
          "explanation": ""
        },
        {
          "id": "b7ac1bbd-f68a-5f06-a682-78b5f2d113d7",
          "text": "需要侧面围栏元件做什么？",
          "options": [
            {
              "id": "5be2d4f8-0e8b-5eab-ba3e-e04454c9b008",
              "text": "增加脚手架的允许荷载。"
            },
            {
              "id": "13ff7656-cd4d-5076-9135-175a9d6b48e1",
              "text": "在所有情况下更换中间扶手。"
            },
            {
              "id": "4f499786-d72c-59f8-8dd4-9879f4fc8fe3",
              "text": "用于固定电缆。"
            },
            {
              "id": "cdfe1ece-13e5-5824-8d78-0156421ef934",
              "text": "减少物体和工人脚从甲板边缘滑落的风险。"
            }
          ],
          "explanation": ""
        }
      ]
    },
    {
      "id": "ba490446-8f39-5277-ab62-d2124035492c",
      "variantNumber": 3,
      "questions": [
        {
          "id": "278ccf96-38a9-5f5e-bb81-8841dbe3e1dd",
          "text": "脚手架投入使用后，用户发现缺少元件。哪个动作是正确的？",
          "options": [
            {
              "id": "eae7ccae-e37b-56f8-a5e2-99dc742d3f2c",
              "text": "移至下一个跨度而不报告缺陷。"
            },
            {
              "id": "4a9dfb8d-bc92-5a4e-ab29-f539d39e3192",
              "text": "停止使用，保护该区域并向主管人员报告以进行检查。"
            },
            {
              "id": "4b024e9d-7331-5571-beee-9a65b6c1f5f6",
              "text": "使用任何合适的型材自行更换元件。"
            },
            {
              "id": "62042341-4ad5-51d9-ab48-18837fe6ea37",
              "text": "继续工作而不张贴材料。"
            }
          ],
          "explanation": ""
        },
        {
          "id": "7885e909-7fe7-5287-a6d1-6fc6e14347bf",
          "text": "安装在一组松散的废料上。哪个决定是正确的？",
          "options": [
            {
              "id": "f3739f24-20be-51ba-8030-4bdfcd453d5d",
              "text": "用铁丝固定废料并离开。"
            },
            {
              "id": "b7eeeec5-2d0f-5578-b5f4-73322a3dedb2",
              "text": "仅在一侧添加沙子。"
            },
            {
              "id": "72742e8b-2b1a-5633-a098-6e74b5eb655b",
              "text": "使用提供的基础元件在准备好的基础上重建支撑。"
            },
            {
              "id": "4e920141-f958-56ce-bfa7-6fd31172eb12",
              "text": "考虑在无风的情况下可接受的支撑。"
            }
          ],
          "explanation": ""
        },
        {
          "id": "a6868dc3-cd8a-5a49-b60c-d0148c73d692",
          "text": "工作期间，能见度变差，风力加大。领导者应该做什么？",
          "options": [
            {
              "id": "cbac7473-0343-5941-85f0-a40d7b2c585a",
              "text": "评估情况，如果不能确保安全运行和稳定性，则停止工作。"
            },
            {
              "id": "23b3d84c-ff04-5ca2-8596-309c278c713f",
              "text": "拆除信号屏障，防止其被推倒。"
            },
            {
              "id": "1506c3b7-f181-5063-bec9-c0dbafcb9acc",
              "text": "允许在不移动材料的情况下进行工作。"
            },
            {
              "id": "41ae0574-866e-5eb3-b99b-238955e8c927",
              "text": "继续仅在上层进行工作。"
            }
          ],
          "explanation": ""
        },
        {
          "id": "57be894a-ea0f-5209-94dc-9c54523c4fce",
          "text": "该层没有侧面元素，人们正在下面工作。哪个动作是正确的？",
          "options": [
            {
              "id": "86c20103-061a-5c2a-822e-d924776e393f",
              "text": "将材料移近边缘以清理通道。"
            },
            {
              "id": "40c3dd22-d271-5044-b005-560e84df97a0",
              "text": "如果工具在您的口袋里，请继续。"
            },
            {
              "id": "cd147d86-0666-52f0-b247-f44f9088c127",
              "text": "在没有围栏的情况下发出口头警告。"
            },
            {
              "id": "2613b877-b504-519c-a0e4-b096271a9763",
              "text": "停止工作，清除下面的人员并恢复防止坠落物体的保护。"
            }
          ],
          "explanation": ""
        },
        {
          "id": "53ac272c-f246-5208-8198-9dfa6af90216",
          "text": "夹具或连接松动该怎么办？",
          "options": [
            {
              "id": "b67b973b-d47a-532e-89fc-66a6d394af23",
              "text": "当人们在甲板上时将其拉起。"
            },
            {
              "id": "ed0cc646-2b91-53bf-a073-e4633c656de0",
              "text": "用电线更换夹子。"
            },
            {
              "id": "e18d9924-f2ff-52fc-a17c-84b98d50b46f",
              "text": "停止使用受影响区域并通过系统恢复连接，然后进行测试。"
            },
            {
              "id": "5c241580-1d25-5908-9f10-3161cf1b5aeb",
              "text": "离开直至预定拆除。"
            }
          ],
          "explanation": ""
        },
        {
          "id": "a8580d1d-b97b-5ab4-8e8a-10f209c2a08e",
          "text": "建造甲板围栏时必须考虑什么？",
          "options": [
            {
              "id": "e1aa8a8c-99a0-5f9f-9e73-0a479f1c03cf",
              "text": "根据设计和脚手架系统，扶手、中间保护和侧面元件的连续性。"
            },
            {
              "id": "a6cceb3a-9be1-5a33-9f71-e89180e439b2",
              "text": "外面只有一根绳子。"
            },
            {
              "id": "9625466b-a240-563a-93d9-7f0af4c17db3",
              "text": "仅最近墙壁的高度。"
            },
            {
              "id": "80e52545-3d7d-5b3f-aceb-38d8eb15ca0c",
              "text": "仅顶部导轨颜色。"
            }
          ],
          "explanation": ""
        },
        {
          "id": "5bdc6210-5957-59dd-89df-fc0c5b4dc433",
          "text": "脚手架位于电气装置旁边。如何进行？",
          "options": [
            {
              "id": "0f4a651f-96f2-5f12-84b0-2108675cc668",
              "text": "手动将长元件移动到电线上。"
            },
            {
              "id": "77c1063e-7d0d-544c-9094-9d9fcf6ab68e",
              "text": "根据计划遵守既定的安全距离和防护措施，排除元素和人员的接近。"
            },
            {
              "id": "51c582b6-3756-58a6-8dcf-aaa32064f23a",
              "text": "无需测试即可将金属脚手架视为保护接地。"
            },
            {
              "id": "23093c95-d691-5861-ae3a-d721792954f2",
              "text": "关闭照明后继续工作。"
            }
          ],
          "explanation": ""
        },
        {
          "id": "3da37fc5-bb04-57c5-8ca8-a7cb0fc3fd67",
          "text": "什么时候需要进行特别检查？",
          "options": [
            {
              "id": "77962d55-ba31-5785-83f5-823f25e80598",
              "text": "仅在完全拆卸后。"
            },
            {
              "id": "8dfdefbe-dbcb-535f-8527-c4a65bdfa228",
              "text": "仅限假期前。"
            },
            {
              "id": "c4a3b9fe-0cd8-586b-8603-a362ac22287e",
              "text": "变化、损坏、沉降、恶劣天气或其他可能影响安全的事件。"
            },
            {
              "id": "d41bec89-6674-5aca-995b-1a1dcf1c5b24",
              "text": "仅当改变立面颜色时。"
            }
          ],
          "explanation": ""
        },
        {
          "id": "45427f1d-f108-5aa0-88e2-f23a404cb6be",
          "text": "拆卸过程中，发现元件变形。我应该怎么办？",
          "options": [
            {
              "id": "f0ea4f18-3bbb-51a6-a522-9d9247e707a7",
              "text": "隐藏通用包中的元素。"
            },
            {
              "id": "ae367e9f-72df-5213-810b-0a0ecf40d6e5",
              "text": "将其用作临时支撑垫。"
            },
            {
              "id": "875a4d99-124f-5b7e-a674-82ca8a554229",
              "text": "用力吹直并立即安装到另一个区域。"
            },
            {
              "id": "94c2c398-66e0-569c-a227-c05ed69b1223",
              "text": "将其与可维修元件分开，贴上标签并发送以进行指定拒绝或评估。"
            }
          ],
          "explanation": ""
        },
        {
          "id": "0b63f5e5-62ed-5a5a-b439-cbcf4a93d2c4",
          "text": "脚手架锚固是什么意思？",
          "options": [
            {
              "id": "a2e7a74f-b504-5cab-b646-ad5490dd683e",
              "text": "脚手架与工程中规定结构的连接，保证其稳定性。"
            },
            {
              "id": "f4f3e019-a8c9-54dd-affe-502d48a7146c",
              "text": "甲板上的允许负载标记。"
            },
            {
              "id": "d1e46088-3658-579c-928b-534e5b29d638",
              "text": "两根柱子之间的任何绳索。"
            },
            {
              "id": "81113a66-6c91-50b7-bf5a-8b56b98f034b",
              "text": "底板衬垫。"
            }
          ],
          "explanation": ""
        }
      ]
    }
  ]
}
