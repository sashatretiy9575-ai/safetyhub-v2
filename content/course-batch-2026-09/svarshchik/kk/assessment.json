          ],
          "correctOptionId": "b683b10f-1f49-5905-a664-43bd3c784474",
          "explanation": "Ток көзделген дәнекерлеу тізбегімен қайтуы тиіс. Бұйыммен сенімді электр байланысы қамтамасыз етіледі. Кездейсоқ құбыр мен құрылымды өткізгіш орнына қолданбайды. Жарылыс-өрт қаупінде оқшаулауға арнайы талаптар ескеріледі.",
          "slideRefs": [
            "slide-14"
          ]
        },
        {
          "id": "25cfd7d0-3510-543b-adf2-5898f7ad5cbb",
          "text": "Дәнекерлеу аймағындағы экрандар не үшін қажет?",
          "displayOrder": 5,
          "options": [
            {
              "id": "93e8b5e9-6802-5ba4-a401-314d9c09afa6",
              "text": "Айналадағы адамдарды доға мен бөлшектерден қорғау",
              "displayOrder": 1
            },
            {
              "id": "a8256ac5-e6aa-5f0b-a0f3-35b2304871d2",
              "text": "Дәнекерлеушінің маскасын алмастыру",
              "displayOrder": 2
            },
            {
              "id": "c3f85e1e-c75b-5d95-afb3-88bad1211fd6",
              "text": "Желдетуден бас тарту",
              "displayOrder": 3
            },
            {
              "id": "b0d05031-0be0-570f-ad48-928eca550e7d",
              "text": "Тек жұмысты жасыру",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "93e8b5e9-6802-5ba4-a401-314d9c09afa6",
          "explanation": "Дәнекерлеу аймағы көзделген экрандармен бөлінеді. Қорғаныссыз адамдардың доғаға тікелей қарауына жол берілмейді. Ұшқын мен бөлшектердің түсу бағыты тексеріледі. Өтетін жолдар бос әрі түсінікті сақталады.",
          "slideRefs": [
            "slide-19"
          ]
        },
        {
          "id": "0f5df0f2-9395-56a6-a404-2457bb9f6ee4",
          "text": "От жұмысында ойық пен жасырын кеңістік неге қаралады?",
          "displayOrder": 6,
          "options": [
            {
              "id": "adefeb37-5f72-5e14-a1c3-1862e800f46c",
              "text": "Аппарат өшкенде бақылауды бірден аяқтау үшін",
              "displayOrder": 1
            },
            {
              "id": "8894ff2b-fac8-514f-a24d-2c1e143d88ca",
              "text": "Ұшқын көрінбейтін жерде бықсу тудыруы мүмкін",
              "displayOrder": 2
            },
            {
              "id": "87906233-507e-501e-a1a4-7f4375ccc54b",
              "text": "Іргелес аймақты қарау жанғышты жинауды алмастырады деп",
              "displayOrder": 3
            },
            {
              "id": "cc882a9c-c9e6-515c-afb3-1d397a5a900c",
              "text": "Тек адамдардың өтуін тексеру үшін",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "8894ff2b-fac8-514f-a24d-2c1e143d88ca",
          "explanation": "Уақытша от жұмыстарына көзделген рұқсат рәсімделеді. Жанғыш материалдар алынады не қорғалады. Ойықтар мен іргелес кеңістіктер тексеріледі. Сөндіру құралдары мен бақылау қамтамасыз етіледі.",
          "slideRefs": [
            "slide-23"
          ]
        },
        {
          "id": "299dc76b-fcd2-595e-a38a-4995eb9b9db4",
          "text": "Газ баллонын қалай жылжытады?",
          "displayOrder": 7,
          "options": [
            {
              "id": "ef555756-beeb-577a-a747-6fa3a27aeb75",
              "text": "Корпусты соғумен",
              "displayOrder": 1
            },
            {
              "id": "3a9ad393-7679-51c5-add5-af15a0185061",
              "text": "Баспалдақпен еркін домалатып",
              "displayOrder": 2
            },
            {
              "id": "e4503ad6-231d-51a6-ae8b-3aa46f25dc62",
              "text": "Құлау мен зақымнан қорғайтын арнайы құралмен",
              "displayOrder": 3
            },
            {
              "id": "d1fd470d-4b42-52f1-af1b-0cc7c682f4bf",
              "text": "Вентильден ұстап",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "e4503ad6-231d-51a6-ae8b-3aa46f25dc62",
          "explanation": "Баллон құлаудан бекітіліп, қызудан қорғалады. Арнайы тасымалдау құралдары қолданылады. Вентильден көтеруге және соғуға болмайды. Арақашықтық пен бірге орналастыру талаптармен анықталады.",
          "slideRefs": [
            "slide-26"
          ]
        },
        {
          "id": "a24f7471-3f4b-5396-abc5-bc7bf72e4665",
          "text": "Кері соққыдан кейін тексерусіз жалғастыруға бола ма?",
          "displayOrder": 8,
          "options": [
            {
              "id": "2c1d5fa1-5046-5e3c-a6ab-46f46f957095",
              "text": "Иә, жалын қалпына келсе",
              "displayOrder": 1
            },
            {
              "id": "5a72ab8a-bb8e-5924-a837-1119ed0b6794",
              "text": "Иә, жалын бөгегішті алған соң",
              "displayOrder": 2
            },
            {
              "id": "027c41cb-78ef-58bc-a162-8bc89973c916",
              "text": "Иә, жақында өрт сөндіргіш болса",
              "displayOrder": 3
            },
            {
              "id": "d455347a-046a-5926-a68d-26213fa5d2f2",
              "text": "Жоқ, тоқтатып, себебін жою қажет",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "d455347a-046a-5926-a68d-26213fa5d2f2",
          "explanation": "Кері соққы жалынды газ жүйесіне қарай таратады. Көзделген клапандар мен жалын бөгегіштер тәуекелді азайтады. Тарсыл, қызу не тұрақсыздық кезінде нұсқаулықпен тоқтатады. Себеп анықталып, жойылғаннан кейін қайта іске қосады.",
          "slideRefs": [
            "slide-29"
          ]
        },
        {
          "id": "02401bcf-8924-5b7e-a285-12c68f2a57c0",
          "text": "Тұйық кеңістікте дәнекерлеуге не қажет?",
          "displayOrder": 9,
          "options": [
            {
              "id": "f5bcd3b2-eea7-5fed-a0b4-1ddb3cd8a870",
              "text": "Арнайы дайындық, рұқсат, атмосфера бақылауы және құтқару шаралары",
              "displayOrder": 1
            },
            {
              "id": "a8d4c88e-3ec0-5e59-a418-e901e4e3f85e",
              "text": "Тек аппаратты ішке көшіру",
              "displayOrder": 2
            },
            {
              "id": "f92141e6-1920-574b-ae01-e20f46c3156f",
              "text": "Бағалаусыз тек ашық люк",
              "displayOrder": 3
            },
            {
              "id": "21b5a71a-eb6f-5ec9-aab8-57ec94559329",
              "text": "Байланыссыз тек әріптестің болуы",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "f5bcd3b2-eea7-5fed-a0b4-1ddb3cd8a870",
          "explanation": "Кіруге орынды арнайы дайындау және рұқсат қажет. Атмосфера бақылауы, желдету, байланыс және бақылаушы ұйымдастырылады. Алдын ала құтқару мүмкіндігі көзделеді. Жағдай өзгерсе, жұмыс тоқтатылып, сыртқа шығады.",
          "slideRefs": [
            "slide-31"
          ]
        },
        {
          "id": "1a9f561d-d423-574b-ac96-626020fb7972",
          "text": "Жік ақауын түзету нәтижесін не растайды?",
          "displayOrder": 10,
          "options": [
            {
              "id": "ef50dd32-8840-5b7f-a73a-82f69cc84dea",
              "text": "Нәтижені тексермей қайта дәнекерлеу",
              "displayOrder": 1
            },
            {
              "id": "6d0cc97b-39ee-5947-a402-f6e27196fb8e",
              "text": "Көзделген қайта бақылау",
              "displayOrder": 2
            },
            {
              "id": "99223fed-8fa9-52a4-acd7-7d13651da5dd",
              "text": "Көзделген көлем орнына тек сыртқы қарау",
              "displayOrder": 3
            },
            {
              "id": "c5bb9912-a16a-5c58-aa91-dc2ba42202e3",
              "text": "Көрінетін із жойылғанша тек бетті тазалау",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "6d0cc97b-39ee-5947-a402-f6e27196fb8e",
          "explanation": "Көзбен бақылау көзделген әдістермен толықтырылады. Нәтиже нақты қосылысқа тіркеледі. Түзету келісілген технологиямен орындалады. Қайта бақылау жөндеу нәтижесін растайды.",
          "slideRefs": [
            "slide-36"
          ]
        }
      ]
    }
  ]
