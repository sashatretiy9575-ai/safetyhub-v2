  "variants": [
    {
      "id": "2b72195c-a2cf-5a40-8ab1-2e3be956e8d6",
      "variantNumber": 1,
      "questions": [
        {
          "id": "d155e90a-824c-539b-b66e-3015c433bc12",
          "text": "Размер каркаса на чертеже не совпадает с подготовленной заготовкой. Что делать?",
          "displayOrder": 1,
          "options": [
            {
              "id": "d03ed4ca-bc50-5546-8836-d897c1b5f566",
              "text": "Подогнуть заготовку на месте без согласования.",
              "displayOrder": 1
            },
            {
              "id": "c0bba186-cd46-50c0-94d2-270e3cd482ec",
              "text": "Изменить шаг стержней на глаз.",
              "displayOrder": 2
            },
            {
              "id": "a0cb8a27-737c-56ed-a715-4cd2b10f4ff0",
              "text": "Собрать каркас и скрыть отклонение при бетонировании.",
              "displayOrder": 3
            },
            {
              "id": "edc66359-b1b7-5098-bf42-87fdee9b61c4",
              "text": "Остановить сборку и уточнить несоответствие у ответственного лица по проектной документации.",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "edc66359-b1b7-5098-bf42-87fdee9b61c4",
          "explanation": ""
        },
        {
          "id": "9155603a-7588-5157-85e1-a26cde8334be",
          "text": "Пачка арматуры лежит без упоров на уклонной площадке. Что сделать?",
          "displayOrder": 2,
          "options": [
            {
              "id": "dade6a0b-a286-5626-8f6c-3adfda4995b7",
              "text": "Оставить пачку до начала перемещения краном.",
              "displayOrder": 1
            },
            {
              "id": "b3543270-8e55-5e57-9093-5341cdbc06ce",
              "text": "Остановить работы и обеспечить устойчивое складирование на подготовленных подкладках с упорами.",
              "displayOrder": 2
            },
            {
              "id": "641fa84e-6b9f-59b5-98ff-8876d1409bf4",
              "text": "Разрезать обвязку, находясь ниже по уклону.",
              "displayOrder": 3
            },
            {
              "id": "1d31f77a-a26b-5779-88b9-d4799d65de24",
              "text": "Подложить один случайный обрезок под середину пачки.",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "b3543270-8e55-5e57-9093-5341cdbc06ce",
          "explanation": ""
        },
        {
          "id": "8543a437-bc11-5547-83a6-19c2332ed3d5",
          "text": "Работник держит короткий стержень рукой у зоны резания станка. Как организовать операцию?",
          "displayOrder": 3,
          "options": [
            {
              "id": "b97a5874-e939-5bd7-90d2-50d3d6f989ee",
              "text": "Удерживать стержень вдвоём по обе стороны ножа.",
              "displayOrder": 1
            },
            {
              "id": "833c19d0-30d3-5556-90d2-1329660df0a8",
              "text": "Надеть более толстые перчатки и продолжить удержание рукой.",
              "displayOrder": 2
            },
            {
              "id": "8182faf7-36db-59ec-83d5-04f57e72fc1e",
              "text": "Использовать предусмотренное приспособление для подачи и удержания, сохранив руки вне опасной зоны.",
              "displayOrder": 3
            },
            {
              "id": "bac945e6-12e5-5060-b063-a978c7fc767b",
              "text": "Увеличить скорость резания, чтобы быстрее закончить.",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "8182faf7-36db-59ec-83d5-04f57e72fc1e",
          "explanation": ""
        },
        {
          "id": "40a38c06-2fda-515f-93ec-876fbc091705",
          "text": "Из каркаса в проход выступают незащищённые концы стержней. Какая мера нужна?",
          "displayOrder": 4,
          "options": [
            {
              "id": "f8eb5d4f-42de-544d-a170-8cb4bf628ffc",
              "text": "Оградить опасную зону и установить предусмотренную защиту выступающих концов либо изменить организацию прохода.",
              "displayOrder": 1
            },
            {
              "id": "947599ff-ea4b-5912-a2c9-d9705dba1a67",
              "text": "Покрасить концы яркой краской и оставить проход открытым.",
              "displayOrder": 2
            },
            {
              "id": "528bef61-80e3-5e66-a3ed-d2922d033f83",
              "text": "Накрыть концы тонкой бумагой.",
              "displayOrder": 3
            },
            {
              "id": "cb265e29-4a20-5930-b1ad-7729d78127c0",
              "text": "Предупредить работников устно без физической защиты.",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "f8eb5d4f-42de-544d-a170-8cb4bf628ffc",
          "explanation": ""
        },
        {
          "id": "44684521-968f-5136-81e5-904715a5fe1e",
          "text": "Когда допускается сварное соединение арматуры?",
          "displayOrder": 5,
          "options": [
            {
              "id": "60d273c9-d7a4-5a48-914a-89871023e6ad",
              "text": "Когда стержни имеют одинаковый цвет.",
              "displayOrder": 1
            },
            {
              "id": "bbbceaa4-4515-54d5-bc7a-8350aee488f3",
              "text": "Когда на площадке есть любой сварочный аппарат.",
              "displayOrder": 2
            },
            {
              "id": "4a4aa856-bfd9-526c-b2d8-35d1b7e6a1bb",
              "text": "Когда вязка занимает больше времени.",
              "displayOrder": 3
            },
            {
              "id": "cb49e3b7-54ce-510a-b7fd-40971ffbc6cb",
              "text": "Когда оно предусмотрено проектом и технологией, а работу выполняет допущенный квалифицированный работник.",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "cb49e3b7-54ce-510a-b7fd-40971ffbc6cb",
          "explanation": ""
        },
        {
          "id": "20932fb4-7f0f-5de3-94da-8547aabc12f6",
          "text": "Перед бетонированием обнаружено смещение каркаса. Что требуется?",
          "displayOrder": 6,
          "options": [
            {
              "id": "d80e8304-17bd-5513-8b4e-8164635b134d",
              "text": "Компенсировать смещение увеличением количества бетона.",
              "displayOrder": 1
            },
            {
              "id": "60395797-06be-559b-a5b1-02e516b671a5",
              "text": "Оставить смещение, если арматура не касается опалубки.",
              "displayOrder": 2
            },
            {
              "id": "a9116b69-cc5b-5a29-9092-569c3af5c8ad",
              "text": "Остановить подготовку к бетонированию, восстановить проектное положение и выполнить контроль.",
              "displayOrder": 3
            },
            {
              "id": "831a19cd-fd37-55de-95fc-de7233e523c3",
              "text": "Срезать мешающие стержни без согласования.",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "a9116b69-cc5b-5a29-9092-569c3af5c8ad",
          "explanation": ""
        },
        {
          "id": "a55e5e2c-b460-5c16-91f7-426484f33b47",
          "text": "Арматурщик работает у края перекрытия. Какая защита имеет приоритет?",
          "displayOrder": 7,
          "options": [
            {
              "id": "e50d1a14-c0b6-572d-aeaf-be42dda39a4e",
              "text": "Только предупреждающая надпись на полу.",
              "displayOrder": 1
            },
            {
              "id": "e7c4939f-2728-5b9f-b2e8-419283a449bf",
              "text": "Исправное коллективное ограждение; при необходимости — дополняющая страховочная система по плану работ.",
              "displayOrder": 2
            },
            {
              "id": "103f7d0c-9117-570e-b052-f0b1b0378b5c",
              "text": "Один страховочный пояс без проверки точки крепления.",
              "displayOrder": 3
            },
            {
              "id": "3200cb35-65bf-5a92-a8e7-35c7a4dfa4b1",
              "text": "Присутствие коллеги рядом без ограждения.",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "e7c4939f-2728-5b9f-b2e8-419283a449bf",
          "explanation": ""
        },
        {
          "id": "150e1860-038e-5f8f-80b3-4fba5384a5a0",
          "text": "Какова правильная предсменная проверка станка для резки арматуры?",
          "displayOrder": 8,
          "options": [
            {
              "id": "51622035-7fa8-5932-bd24-9a12403389cf",
              "text": "Начать с максимальной нагрузки без осмотра.",
              "displayOrder": 1
            },
            {
              "id": "4f55e7b6-3f1f-5e4c-8cf5-c5b212d0eed0",
              "text": "Проверить только наличие электропитания.",
              "displayOrder": 2
            },
            {
              "id": "f20790d2-748e-5853-8a0a-f62b1274cd62",
              "text": "Сначала снять ограждение и проверить нож рукой.",
              "displayOrder": 3
            },
            {
              "id": "a5d6c512-25fb-5448-9e85-a2c79e3b688b",
              "text": "Осмотреть ограждения, органы управления, рабочую оснастку и зону работы, затем выполнить предусмотренную пробную проверку.",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "a5d6c512-25fb-5448-9e85-a2c79e3b688b",
          "explanation": ""
        },
        {
          "id": "3b769351-ca84-58bd-96bf-84fa59fb2402",
          "text": "Каркас начал смещаться во время установки. Как действовать?",
          "displayOrder": 9,
          "options": [
            {
              "id": "2d392b20-757f-52fa-ac82-77828042cb65",
              "text": "Остановить перемещение, исключить доступ в опасную зону, стабилизировать каркас и только затем продолжить по команде.",
              "displayOrder": 1
            },
            {
              "id": "387e91d7-88c5-5e25-b75b-0ff1fbdb3fff",
              "text": "Зайти под каркас и поправить опоры.",
              "displayOrder": 2
            },
            {
              "id": "8741c24d-20be-5ac8-b1a6-b0666f8cc899",
              "text": "Удерживать каркас телом до завершения подъёма.",
              "displayOrder": 3
            },
            {
              "id": "3c846be4-e4c2-5eb4-a269-4e779aff5cee",
              "text": "Ускорить перемещение, чтобы каркас быстрее встал на место.",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "2d392b20-757f-52fa-ac82-77828042cb65",
          "explanation": ""
        },
        {
          "id": "2c2504b5-5055-5925-b559-a7c19939a605",
          "text": "Что называют защитным слоем бетона?",
          "displayOrder": 10,
          "options": [
            {
              "id": "03338867-3ff8-5770-9167-73671acdc033",
              "text": "Слой смазки на поверхности стержня.",
              "displayOrder": 1
            },
            {
              "id": "13820dce-fac0-5f04-955a-760e13e67412",
              "text": "Временную плёнку поверх опалубки.",
              "displayOrder": 2
            },
            {
              "id": "c9a362c6-e7bb-5632-877e-a5ce35e8fd91",
              "text": "Проектное расстояние от поверхности бетона до арматуры, обеспечиваемое её правильным положением.",
              "displayOrder": 3
            },
            {
              "id": "35473d46-edc8-54ad-aee2-23941460e360",
              "text": "Дополнительный ряд вязальной проволоки.",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "c9a362c6-e7bb-5632-877e-a5ce35e8fd91",
          "explanation": ""
        }
      ]
    },
    {
      "id": "753ce2bd-1961-56fe-b33a-85c044512257",
      "variantNumber": 2,
      "questions": [
        {
          "id": "272e7cec-f274-50f6-9753-32fc63416e9b",
          "text": "Для узла отсутствует рабочая схема армирования. Как поступить арматурщику?",
          "displayOrder": 1,
          "options": [
            {
              "id": "b8b4070e-aa31-5bb4-b1c4-5ee00a8edfa1",
              "text": "Не выполнять узел до получения утверждённой проектной информации и задания.",
              "displayOrder": 1
            },
            {
              "id": "87b70dd4-1a62-58ae-8d8a-363428a10311",
              "text": "Выбрать диаметр и шаг по остатку материала.",
              "displayOrder": 2
            },
            {
              "id": "d577374a-7f8f-5be4-b15a-d45f0cb85cb4",
              "text": "Заменить недостающую арматуру вязальной проволокой.",
              "displayOrder": 3
            },
            {
              "id": "25a371a6-15df-5240-b444-f77c9c59ed9d",
              "text": "Повторить схему соседнего узла независимо от нагрузки.",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "b8b4070e-aa31-5bb4-b1c4-5ee00a8edfa1",
          "explanation": ""
        },
        {
          "id": "f7b020f8-edd0-56ce-9934-ff0ca32b6f98",
          "text": "Во время перемещения каркаса краном работник оказался под грузом. Как должен действовать сигнальщик или руководитель?",
          "displayOrder": 2,
          "options": [
            {
              "id": "8c321b04-3ab5-5cc0-9e3c-4fa78ef1fa47",
              "text": "Попросить работника придержать каркас руками.",
              "displayOrder": 1
            },
            {
              "id": "1bd703aa-6ccb-555b-9b2e-b44571a4f4da",
              "text": "Немедленно остановить перемещение и вывести человека из опасной зоны.",
              "displayOrder": 2
            },
            {
              "id": "e0f10d78-9a20-5738-a7dc-0b9844ed51e4",
              "text": "Продолжить подъём на меньшей скорости.",
              "displayOrder": 3
            },
            {
              "id": "8d3bc139-35e6-5ce9-8b9f-ca348685ac14",
              "text": "Подать груз выше, не останавливая операцию.",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "1bd703aa-6ccb-555b-9b2e-b44571a4f4da",
          "explanation": ""
        },
        {
          "id": "b2f39577-6b65-5dfc-a0ae-4c14f6059719",
          "text": "При гибке арматуры коллега находится в секторе возможного движения стержня. Как поступить?",
          "displayOrder": 3,
          "options": [
            {
              "id": "c21ba407-3fe3-58da-9a1f-310c5db511db",
              "text": "Предупредить коллегу криком и начать гибку.",
              "displayOrder": 1
            },
            {
              "id": "6a9f806e-acb3-5415-b206-b07bbb4d7e04",
              "text": "Уменьшить угол гиба, не меняя положение коллеги.",
              "displayOrder": 2
            },
            {
              "id": "5ed159a4-732b-5b63-9506-6e0a567f4431",
              "text": "Придерживать свободный конец стержня ногой.",
              "displayOrder": 3
            },
            {
              "id": "53469778-4da0-5cd4-b0e7-a11fd14ceb1f",
              "text": "Остановить операцию и освободить опасную зону до включения оборудования.",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "53469778-4da0-5cd4-b0e7-a11fd14ceb1f",
          "explanation": ""
        },
        {
          "id": "27b9178b-493f-5a3b-8fda-6399cc565059",
          "text": "При вязке проволока порвалась и острый конец направлен к лицу. Как снизить риск?",
          "displayOrder": 4,
          "options": [
            {
              "id": "3657b2c4-8df2-5b3d-89bd-47376edff0ca",
              "text": "Удлинить конец проволоки и оставить его наружу.",
              "displayOrder": 1
            },
            {
              "id": "6b4265e4-076c-59a7-953c-d50e4c24eef8",
              "text": "Скручивать проволоку только руками без инструмента.",
              "displayOrder": 2
            },
            {
              "id": "dc186eef-3f31-5b9a-97aa-6ef776da0cad",
              "text": "Использовать исправный инструмент, контролировать направление концов проволоки и применять защиту глаз и рук по риску.",
              "displayOrder": 3
            },
            {
              "id": "be9a9387-c74b-58a5-8e4f-0c8a8f2eb31b",
              "text": "Наклониться ближе, чтобы лучше видеть место вязки.",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "dc186eef-3f31-5b9a-97aa-6ef776da0cad",
          "explanation": ""
        },
        {
          "id": "b087ce96-3116-5b36-bd0c-8a99576d1e1a",
          "text": "Можно ли заменить проектную муфту сваркой без согласования?",
          "displayOrder": 5,
          "options": [
            {
              "id": "12b1f311-1bd2-5fff-908b-780a18e1e3a8",
              "text": "Можно, если диаметр стержня меньше соседнего.",
              "displayOrder": 1
            },
            {
              "id": "55a8e4b1-d2c5-59d1-9308-cadf4e45042d",
              "text": "Нельзя: способ соединения меняют только в установленном порядке по проектному решению.",
              "displayOrder": 2
            },
            {
              "id": "1167b08f-28a5-578a-9b49-b1e3f21eb9c9",
              "text": "Можно, если сварщик считает шов прочным.",
              "displayOrder": 3
            },
            {
              "id": "bc779bfe-4c00-5eff-8a28-ce1569e89909",
              "text": "Можно для одного стыка без записи.",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "55a8e4b1-d2c5-59d1-9308-cadf4e45042d",
          "explanation": ""
        },
        {
          "id": "32649218-e755-5c27-882b-d100344a29af",
          "text": "Как устанавливают защитный слой бетона для арматуры?",
          "displayOrder": 6,
          "options": [
            {
              "id": "56bef418-7531-5e90-8788-44a06c16210e",
              "text": "По проектной документации с применением предусмотренных фиксаторов и контролем положения.",
              "displayOrder": 1
            },
            {
              "id": "a6cb76ab-a511-5752-b89d-433e1bb44b6b",
              "text": "По одному универсальному размеру для всех конструкций.",
              "displayOrder": 2
            },
            {
              "id": "bcbbe36d-cbc3-5886-a2a6-f2d249e83f8f",
              "text": "По расстоянию, которое удобно выдержать вручную.",
              "displayOrder": 3
            },
            {
              "id": "5dffe213-e0ab-555f-b778-79aba1be9155",
              "text": "За счёт свободного перемещения каркаса при бетонировании.",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "56bef418-7531-5e90-8788-44a06c16210e",
          "explanation": ""
        },
        {
          "id": "814f0e02-2557-5ed6-b8b5-a95c4ca982be",
          "text": "Каркас подаётся краном в монтажную зону. Как организовать взаимодействие?",
          "displayOrder": 7,
          "options": [
            {
              "id": "a31530e7-ab9b-51ed-8e4b-aebf7bb5cc50",
              "text": "Направлять груз руками, находясь под ним.",
              "displayOrder": 1
            },
            {
              "id": "45b77eb6-8cc7-563e-9eb1-820342bbd903",
              "text": "Продолжать движение при потере видимости машинистом.",
              "displayOrder": 2
            },
            {
              "id": "bfdf05b0-5222-5b08-91e8-d0d8f9dd9460",
              "text": "Разрешить любому работнику подавать разные команды.",
              "displayOrder": 3
            },
            {
              "id": "2474303c-d5ce-574c-a540-a877ed3d0ac2",
              "text": "Назначить установленного сигнальщика, использовать согласованные команды и не допускать людей под груз.",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "2474303c-d5ce-574c-a540-a877ed3d0ac2",
          "explanation": ""
        },
        {
          "id": "fb447427-81e0-5b82-bd63-45b9ac707a97",
          "text": "Что проверить у ручного инструмента для вязки?",
          "displayOrder": 8,
          "options": [
            {
              "id": "a7154d84-3ee1-52f6-8b1d-0286190631be",
              "text": "Только дату последней уборки рабочего места.",
              "displayOrder": 1
            },
            {
              "id": "e61c5c9b-dc09-5ea2-8a07-a3a1f9e12801",
              "text": "Целостность рукояток, рабочей части, креплений и отсутствие опасных заусенцев.",
              "displayOrder": 2
            },
            {
              "id": "313e419c-6369-5dfd-963e-8a400c1a54ac",
              "text": "Только цвет рукоятки.",
              "displayOrder": 3
            },
            {
              "id": "901cf25c-b040-586a-9a9a-9c1363c065cb",
              "text": "Только массу инструмента.",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "e61c5c9b-dc09-5ea2-8a07-a3a1f9e12801",
          "explanation": ""
        },
        {
          "id": "e9929882-9e71-534d-bd81-e67daec3f6a3",
          "text": "Во время резки обнаружено разрушение защитного ограждения станка. Каков порядок действий?",
          "displayOrder": 9,
          "options": [
            {
              "id": "75773664-d866-5745-84f7-03662c18f591",
              "text": "Закрыть место картоном и продолжить резку.",
              "displayOrder": 1
            },
            {
              "id": "bc23d580-07ec-50af-9dbb-afaec7e83e7a",
              "text": "Работать только на малых диаметрах.",
              "displayOrder": 2
            },
            {
              "id": "532b8549-9cff-5934-ad96-4df7aa23d0b7",
              "text": "Остановить станок, отключить энергию, обозначить неисправность и передать оборудование на ремонт.",
              "displayOrder": 3
            },
            {
              "id": "6bdb1dcb-6ac0-5a62-8cb3-a5d3fc3329eb",
              "text": "Попросить коллегу держать временный щит.",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "532b8549-9cff-5934-ad96-4df7aa23d0b7",
          "explanation": ""
        },
        {
          "id": "02d66848-659e-556d-9ccb-3f04c88db30d",
          "text": "Что такое механическое соединение арматуры?",
          "displayOrder": 10,
          "options": [
            {
              "id": "c950d66d-6ab5-51ce-a911-580f08d8b98f",
              "text": "Случайное перекрытие двух стержней без фиксации.",
              "displayOrder": 1
            },
            {
              "id": "ff8aa177-6284-525e-b235-8077b7cf708d",
              "text": "Сварка любых стержней без проектного решения.",
              "displayOrder": 2
            },
            {
              "id": "eac465ad-c015-564f-b4cf-0ccdb91dea06",
              "text": "Любая ручная вязка проволокой.",
              "displayOrder": 3
            },
            {
              "id": "7b0bdc99-99bd-53e9-8ff1-9b83854486f0",
              "text": "Соединение стержней специальным устройством, выполняемое по проекту и технологии конкретной системы.",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "7b0bdc99-99bd-53e9-8ff1-9b83854486f0",
          "explanation": ""
        }
      ]
    },
    {
      "id": "9c9513cc-6c34-586b-bf3d-81feab93b8c2",
      "variantNumber": 3,
      "questions": [
        {
          "id": "5694d58e-0306-5e67-99c5-dfa2235d1b50",
          "text": "На площадке предлагают изменить тип соединения стержней ради ускорения работы. Какое решение правильное?",
          "displayOrder": 1,
          "options": [
            {
              "id": "239fc8c8-f872-590c-b6ee-bc3df3cf53e0",
              "text": "Смешать разные способы в одном узле без согласования.",
              "displayOrder": 1
            },
            {
              "id": "dd9d148d-c61f-5bbc-852e-98965f92c2e0",
              "text": "Заменять соединения по усмотрению исполнителя.",
              "displayOrder": 2
            },
            {
              "id": "8dd527d3-1e64-5e15-bb79-936077ce7b40",
              "text": "Применять только соединение, предусмотренное проектом и утверждённой технологией.",
              "displayOrder": 3
            },
            {
              "id": "a9b4f5a7-f3ad-55f2-8cb6-e9e3f706865b",
              "text": "Использовать самый дешёвый способ без контроля.",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "8dd527d3-1e64-5e15-bb79-936077ce7b40",
          "explanation": ""
        },
        {
          "id": "c15c6945-d695-53f0-bf36-e7d0b832f488",
          "text": "Перед подъёмом связки стержней обнаружено повреждение стропа. Что делать?",
          "displayOrder": 2,
          "options": [
            {
              "id": "7c486bfe-e8cc-5ed5-8a29-8485a6d371dc",
              "text": "Не выполнять подъём и заменить строп исправным после проверки ответственным лицом.",
              "displayOrder": 1
            },
            {
              "id": "b6c6e09c-bc72-5d4f-a0b7-14ae7f0b2d43",
              "text": "Уменьшить массу груза и использовать повреждённый строп.",
              "displayOrder": 2
            },
            {
              "id": "6fbae5b9-1d82-52c7-8c1e-ef2090ee92dc",
              "text": "Усилить строп вязальной проволокой.",
              "displayOrder": 3
            },
            {
              "id": "67f57e5f-5bb6-5bd7-817a-24ba607ffe38",
              "text": "Поднимать груз рывком, чтобы сократить время нагрузки.",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "7c486bfe-e8cc-5ed5-8a29-8485a6d371dc",
          "explanation": ""
        },
        {
          "id": "5089da5c-dcb6-55a5-8a8a-5999d003bfa3",
          "text": "После резки рядом со станком накопились острые обрезки. Что сделать?",
          "displayOrder": 3,
          "options": [
            {
              "id": "72406deb-f88b-523e-9373-ec79d83a74fd",
              "text": "Оставить обрезки до окончания всей партии.",
              "displayOrder": 1
            },
            {
              "id": "db9077d7-deb6-581a-b4b1-6c07a3bb7084",
              "text": "Остановить и безопасно убрать обрезки в предназначенную тару, используя подходящее приспособление.",
              "displayOrder": 2
            },
            {
              "id": "74cb9861-b60f-591e-91c1-2d57fb03451f",
              "text": "Сбрасывать обрезки в проход для последующей уборки.",
              "displayOrder": 3
            },
            {
              "id": "e382ea46-bc92-5c1b-b9a4-7163239a1c48",
              "text": "Сдвинуть обрезки ногой под станок.",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "db9077d7-deb6-581a-b4b1-6c07a3bb7084",
          "explanation": ""
        },
        {
          "id": "db7790c4-b4ba-525c-b886-4322554ca29d",
          "text": "При установке каркаса возникла зона защемления между каркасом и опалубкой. Как действовать?",
          "displayOrder": 4,
          "options": [
            {
              "id": "b09bbae4-6f4c-5692-8480-9a9abb035e2e",
              "text": "Встать между каркасом и опалубкой для точного совмещения.",
              "displayOrder": 1
            },
            {
              "id": "334d123e-a33d-582c-a63e-359382668e2e",
              "text": "Удерживать каркас пальцами до полной посадки.",
              "displayOrder": 2
            },
            {
              "id": "66f50813-5889-54e5-bccf-d149fed1bec9",
              "text": "Не помещать руки в зону защемления и управлять положением каркаса согласованными средствами и командами.",
              "displayOrder": 3
            },
            {
              "id": "51a5c96e-e511-5e18-ab42-52f95625273e",
              "text": "Подталкивать каркас плечом во время опускания.",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "66f50813-5889-54e5-bccf-d149fed1bec9",
          "explanation": ""
        },
        {
          "id": "1ac2d5fb-5bbf-5ccd-90ca-632a439a9723",
          "text": "От чего зависит правильная сборка механического соединения?",
          "displayOrder": 5,
          "options": [
            {
              "id": "16f7777f-a905-504a-82a6-f811917ddab3",
              "text": "Только от внешнего блеска муфты.",
              "displayOrder": 1
            },
            {
              "id": "059b73ed-9789-532b-8bdd-76292b933de9",
              "text": "Только от усилия, приложенного вручную.",
              "displayOrder": 2
            },
            {
              "id": "360799ef-c9b1-5699-a1a1-f3af343f8772",
              "text": "Только от температуры воздуха в начале смены.",
              "displayOrder": 3
            },
            {
              "id": "a2f5f61d-a4fb-57e8-9d67-1f9b2f4dc4d6",
              "text": "От проектного решения, совместимости системы, инструкции изготовителя и установленного контроля.",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "a2f5f61d-a4fb-57e8-9d67-1f9b2f4dc4d6",
          "explanation": ""
        },
        {
          "id": "496e0f61-1e0b-5612-8f56-c886a93b90b3",
          "text": "Фиксатор каркаса разрушен до бетонирования. Как поступить?",
          "displayOrder": 6,
          "options": [
            {
              "id": "b7f10470-3c8d-541f-8fb0-5f99495773d0",
              "text": "Заменить его подходящим исправным элементом и повторно проверить устойчивость и положение каркаса.",
              "displayOrder": 1
            },
            {
              "id": "f08f9f25-f824-594f-bf1e-6aaefd883381",
              "text": "Оставить каркас без фиксатора, если он тяжёлый.",
              "displayOrder": 2
            },
            {
              "id": "610f07b2-acbf-5a2e-ab51-8d53fa39cf03",
              "text": "Привязать каркас к опалубке случайной проволокой.",
              "displayOrder": 3
            },
            {
              "id": "9f5e5fce-2e63-5e2f-b2a0-492331088996",
              "text": "Подложить случайный деревянный обрезок.",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "b7f10470-3c8d-541f-8fb0-5f99495773d0",
          "explanation": ""
        },
        {
          "id": "f31fe743-cdad-5dee-84eb-b22186396855",
          "text": "Электроинструмент требуется применить на мокром участке. Как поступить?",
          "displayOrder": 7,
          "options": [
            {
              "id": "0e9ad062-37ab-5345-800e-8de5b3482cbd",
              "text": "Отключить защитные устройства, чтобы избежать срабатывания.",
              "displayOrder": 1
            },
            {
              "id": "41dc91ff-b6c7-542c-86ec-d3c4e2eca973",
              "text": "Положить инструмент на мокрый пол и включить через обычный удлинитель.",
              "displayOrder": 2
            },
            {
              "id": "33efc22a-3e4c-50b6-9486-983669161827",
              "text": "Оценить условия, применить предусмотренную электрозащиту и не работать неисправным или неподходящим инструментом.",
              "displayOrder": 3
            },
            {
              "id": "d54b469d-e17e-5051-b6e0-ad0df8210e3b",
              "text": "Обернуть корпус тканью и продолжить работу.",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "33efc22a-3e4c-50b6-9486-983669161827",
          "explanation": ""
        },
        {
          "id": "48623af7-e32e-52ab-9fb3-390dab796c09",
          "text": "В какой последовательности готовят место сборки каркаса?",
          "displayOrder": 8,
          "options": [
            {
              "id": "690d59e1-4c09-5069-8da8-430a08b6a19d",
              "text": "Сначала раскладывают стержни в проходе, затем ищут чертёж.",
              "displayOrder": 1
            },
            {
              "id": "0cf64ac9-28fc-58df-9ce1-f079d7d42462",
              "text": "Изучают задание, ограждают и очищают зону, размещают материалы устойчиво, проверяют инструмент и защиту.",
              "displayOrder": 2
            },
            {
              "id": "4ca408d5-5380-5866-b728-b74e9f8a270f",
              "text": "Сначала включают станки, затем освобождают рабочую зону.",
              "displayOrder": 3
            },
            {
              "id": "08cbbd40-9181-50aa-9f98-d8917f15930a",
              "text": "Сначала снимают ограждения, затем выбирают СИЗ.",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "0cf64ac9-28fc-58df-9ce1-f079d7d42462",
          "explanation": ""
        },
        {
          "id": "e4c92932-37b2-521d-bcb4-01543cc84051",
          "text": "Поднятый груз завис над монтажной зоной. Что следует сделать?",
          "displayOrder": 9,
          "options": [
            {
              "id": "c4a9673d-d18d-5b36-accb-b15b9eada1f3",
              "text": "Использовать груз как временную опору.",
              "displayOrder": 1
            },
            {
              "id": "ae0d1c73-fdf1-5ce2-846c-591039b3d9de",
              "text": "Подтолкнуть груз руками снизу.",
              "displayOrder": 2
            },
            {
              "id": "37865185-3b4e-504e-95c6-1954987a867b",
              "text": "Продолжить вязку под грузом, пока кран неподвижен.",
              "displayOrder": 3
            },
            {
              "id": "9518ffac-9b52-55e6-883c-77903960f449",
              "text": "Прекратить работы под грузом, вывести людей и действовать по установленным командам ответственного персонала.",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "9518ffac-9b52-55e6-883c-77903960f449",
          "explanation": ""
        },
        {
          "id": "5422664f-ee24-55c2-b7d0-e6d33cd90ec7",
          "text": "Для чего применяют фиксаторы арматуры?",
          "displayOrder": 10,
          "options": [
            {
              "id": "d3e2ed57-6284-590b-b722-b46b78797a2a",
              "text": "Для удержания каркаса в проектном положении и обеспечения заданного защитного слоя.",
              "displayOrder": 1
            },
            {
              "id": "17ec74e4-52ef-5fe4-8b89-e32527515517",
              "text": "Для временного хранения режущего инструмента.",
              "displayOrder": 2
            },
            {
              "id": "5702e229-f6af-5e44-8d5d-fa2d0c9f1c11",
              "text": "Для изменения класса стали на площадке.",
              "displayOrder": 3
            },
            {
              "id": "376a09d9-17ee-5447-83a5-555a0c200294",
              "text": "Для замены всех соединений стержней.",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "d3e2ed57-6284-590b-b722-b46b78797a2a",
          "explanation": ""
        }
      ]
    }
  ],
