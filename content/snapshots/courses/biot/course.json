  "variants": [
    {
      "id": "cb8dfec8-21a6-59a3-8725-931cfc14bf5a",
      "variantNumber": 1,
      "questions": [
        {
          "id": "b96a656b-41f1-5470-9591-e672694a80d4",
          "text": "Работник видит непосредственную угрозу обрушения в своей зоне. Как действовать?",
          "displayOrder": 1,
          "options": [
            {
              "id": "3d80e1fd-a064-535a-9183-a93a48845297",
              "text": "Продолжить работу до получения письменного указания.",
              "displayOrder": 1
            },
            {
              "id": "8df94b5f-9e02-5504-8c25-0f547a62ccf5",
              "text": "Прекратить работу, выйти из опасной зоны и немедленно сообщить руководителю в установленном порядке.",
              "displayOrder": 2
            },
            {
              "id": "059d1b90-1bfb-54df-802d-6c77012563ac",
              "text": "Самостоятельно устранить угрозу без оценки и ограждения.",
              "displayOrder": 3
            },
            {
              "id": "a8cb0294-a61a-54a6-973e-4c7dc740898e",
              "text": "Попросить коллегу наблюдать, пока работа продолжается.",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "8df94b5f-9e02-5504-8c25-0f547a62ccf5",
          "explanation": ""
        },
        {
          "id": "132a9aa0-21b1-5407-b38c-e95fbe579410",
          "text": "Произошла травма работника. Какое первоочередное действие очевидца правильное?",
          "displayOrder": 2,
          "options": [
            {
              "id": "c1434394-5882-5284-beba-a5964dfdbe2a",
              "text": "Немедленно изменить место происшествия без необходимости спасения.",
              "displayOrder": 1
            },
            {
              "id": "a4558963-d046-5259-b923-c824a8b1890a",
              "text": "Отправить пострадавшего одного заполнять документы.",
              "displayOrder": 2
            },
            {
              "id": "4420fbed-ac73-5fc0-9b3d-4ab5977d2e1b",
              "text": "Остановить воздействие опасности, вызвать помощь, оказать посильную первую помощь и сообщить о происшествии.",
              "displayOrder": 3
            },
            {
              "id": "a37e5c5c-ee12-5466-8410-2af18436cc45",
              "text": "Сначала закончить производственную операцию.",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "4420fbed-ac73-5fc0-9b3d-4ab5977d2e1b",
          "explanation": ""
        },
        {
          "id": "ea421348-3b63-536c-a8a4-c2f46a9945cb",
          "text": "Защитное ограждение оборудования повреждено. Что обязан сделать работник?",
          "displayOrder": 3,
          "options": [
            {
              "id": "c5dac3c2-a0ba-596b-806e-56fde4ffb915",
              "text": "Работать только при присутствии коллеги.",
              "displayOrder": 1
            },
            {
              "id": "0ec46c0a-cfd5-5b82-b142-c71d3a7c3234",
              "text": "Снять оставшуюся часть ограждения и продолжить работу.",
              "displayOrder": 2
            },
            {
              "id": "ad8ff1a5-9fc7-5e68-a3c5-6726a002a6cf",
              "text": "Закрыть повреждение картоном без сообщения.",
              "displayOrder": 3
            },
            {
              "id": "786a4aef-5056-5516-af08-0c5f811ec2df",
              "text": "Остановить использование оборудования и сообщить о неисправности ответственному лицу.",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "786a4aef-5056-5516-af08-0c5f811ec2df",
          "explanation": ""
        },
        {
          "id": "08644b64-94d3-5f58-8960-85740a7ecc08",
          "text": "Какую меру следует рассматривать раньше выдачи дополнительных СИЗ?",
          "displayOrder": 4,
          "options": [
            {
              "id": "6d5c920f-21ba-5060-a463-958d7f2b4bfa",
              "text": "Устранение опасности или техническое ограждение и изоляцию источника, если это возможно.",
              "displayOrder": 1
            },
            {
              "id": "61e8d935-44a9-51c2-9695-a2fade0b8e1b",
              "text": "Увеличение продолжительности смены.",
              "displayOrder": 2
            },
            {
              "id": "d004ce74-5eea-5486-ab29-948fcd85f71e",
              "text": "Перенос инструктажа на конец работы.",
              "displayOrder": 3
            },
            {
              "id": "7b5a032c-5437-57cb-b8ef-9cfe96d6a1d9",
              "text": "Замена предупреждающего знака на более крупный без иных мер.",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "6d5c920f-21ba-5060-a463-958d7f2b4bfa",
          "explanation": ""
        },
        {
          "id": "7ccde0d5-2976-5bcb-9fcf-9ef4066781ec",
          "text": "Когда работника допускают к самостоятельной работе?",
          "displayOrder": 5,
          "options": [
            {
              "id": "ab91f431-2c74-586f-bc00-2dff483ad4d4",
              "text": "После устного знакомства с коллегой.",
              "displayOrder": 1
            },
            {
              "id": "7dd5801a-415a-5943-be6b-42b258f3c339",
              "text": "После первого самостоятельного выполнения операции.",
              "displayOrder": 2
            },
            {
              "id": "1ab378d4-f1cd-5dc2-875c-25a48bde5dc5",
              "text": "После требуемого обучения, инструктажа, проверки знаний и иных установленных допусков для его работы.",
              "displayOrder": 3
            },
            {
              "id": "dd60a02e-ad61-5eb1-8881-02676192d39d",
              "text": "Сразу после подписания табеля.",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "1ab378d4-f1cd-5dc2-875c-25a48bde5dc5",
          "explanation": ""
        },
        {
          "id": "8e8eb823-6b0f-549d-8a53-816782664d0a",
          "text": "Кто обеспечивает выдачу необходимых СИЗ работнику?",
          "displayOrder": 6,
          "options": [
            {
              "id": "adfe99f9-16be-5438-96c5-941bf9e0708a",
              "text": "Любой посетитель рабочей площадки.",
              "displayOrder": 1
            },
            {
              "id": "8ec13757-df81-5d97-a9cf-579683a6a7c1",
              "text": "Сам работник за счёт обязательной покупки в любом магазине.",
              "displayOrder": 2
            },
            {
              "id": "35cc8555-dcee-5e46-afef-19f0c992eaba",
              "text": "Только изготовитель оборудования.",
              "displayOrder": 3
            },
            {
              "id": "15290c7d-0df8-5bcc-922a-5fc807f79e4b",
              "text": "Работодатель в соответствии с рисками, нормами и установленным порядком.",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "15290c7d-0df8-5bcc-922a-5fc807f79e4b",
          "explanation": ""
        },
        {
          "id": "c8171b54-c12c-599c-97e8-7b74abc3ddc0",
          "text": "На опасном производственном объекте планируется газоопасная работа. Что необходимо до начала?",
          "displayOrder": 7,
          "options": [
            {
              "id": "4ad0b8d9-3b0f-5427-87d4-897ad5eab21e",
              "text": "Начать работу после устного согласия ближайшего коллеги.",
              "displayOrder": 1
            },
            {
              "id": "3a34d569-cb02-5209-b142-5e283df618b9",
              "text": "Организовать работу по установленной процедуре и наряду-допуску с анализом среды, защитой и готовностью к аварии.",
              "displayOrder": 2
            },
            {
              "id": "8d4f8e13-3643-5922-993c-57f5c878f0b0",
              "text": "Проверить атмосферу по запаху.",
              "displayOrder": 3
            },
            {
              "id": "da642e1a-3b43-5f2d-b4d3-6afa00b11eee",
              "text": "Отключить сигнализацию, чтобы она не мешала.",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "3a34d569-cb02-5209-b142-5e283df618b9",
          "explanation": ""
        },
        {
          "id": "f5b6ee1d-f2fe-5960-9d9d-3241f09fd06e",
          "text": "Как работник должен действовать при сигнале аварии на ОПО?",
          "displayOrder": 8,
          "options": [
            {
              "id": "182a0b0c-485f-506b-980b-130e8bb3b919",
              "text": "Прекратить работу, выполнить предусмотренные планом действия, покинуть или занять безопасное место и доложить по установленной связи.",
              "displayOrder": 1
            },
            {
              "id": "a086cbd6-f0ae-52ff-a847-e5ea12b58316",
              "text": "Продолжить работу до указания коллеги.",
              "displayOrder": 2
            },
            {
              "id": "a6f45a7d-f1fa-55ba-a523-0e78e5071595",
              "text": "Вернуться за личными вещами после выхода.",
              "displayOrder": 3
            },
            {
              "id": "a73bffca-153f-54fc-bc55-4d62bcc483b5",
              "text": "Самостоятельно изменить маршрут эвакуации без причины.",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "182a0b0c-485f-506b-980b-130e8bb3b919",
          "explanation": ""
        },
        {
          "id": "25b5b16f-ca43-531b-b0c0-04bd7dabe4db",
          "text": "Перед работой с оборудованием под давлением отсутствует разрешающая маркировка и статус непонятен. Что делать?",
          "displayOrder": 9,
          "options": [
            {
              "id": "2d9df961-1c83-56a4-8504-cdbe8ec05d96",
              "text": "Открыть арматуру ударами инструмента.",
              "displayOrder": 1
            },
            {
              "id": "e53d34ff-2416-5677-9017-96c3d05c6101",
              "text": "Включить на минимальном давлении для проверки.",
              "displayOrder": 2
            },
            {
              "id": "af9fcfa3-53c1-52d3-bc55-6855e457a511",
              "text": "Нанести дату маркером самостоятельно.",
              "displayOrder": 3
            },
            {
              "id": "5af83904-4aa9-5a4b-91da-b0cc2451cd0c",
              "text": "Не включать оборудование и запросить подтверждение допуска и технического состояния у ответственного лица.",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "5af83904-4aa9-5a4b-91da-b0cc2451cd0c",
          "explanation": ""
        },
        {
          "id": "b1e7342a-f694-5346-b959-2d404a37151d",
          "text": "Что такое опасный производственный объект?",
          "displayOrder": 10,
          "options": [
            {
              "id": "776067b3-105c-54b5-a1dc-bda99e77d0fe",
              "text": "Любое помещение, где работает больше двух человек.",
              "displayOrder": 1
            },
            {
              "id": "a4ea85ad-20d3-50b8-877d-001c340dccd4",
              "text": "Только здание пожарной части.",
              "displayOrder": 2
            },
            {
              "id": "bc864dde-7007-58fa-b0cf-2702d12e7ff2",
              "text": "Объект, идентифицированный по установленным законом признакам наличия опасных веществ, процессов или технических устройств.",
              "displayOrder": 3
            },
            {
              "id": "967b9c84-6269-5d8a-b812-0f90c2ea2975",
              "text": "Любая территория с пропускным режимом.",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "bc864dde-7007-58fa-b0cf-2702d12e7ff2",
          "explanation": ""
        }
      ]
    },
    {
      "id": "adf6ab88-5108-5cad-b44a-162073d7632a",
      "variantNumber": 2,
      "questions": [
        {
          "id": "8cdf7782-a80c-5cbd-aa0e-cdd3aeb26e2c",
          "text": "Работнику поручили операцию, безопасному выполнению которой он не обучен. Как поступить?",
          "displayOrder": 1,
          "options": [
            {
              "id": "ff6b9194-9692-5785-b826-0ac9b4bf4aec",
              "text": "Подписать журнал после выполнения работы.",
              "displayOrder": 1
            },
            {
              "id": "d46128ad-7556-5024-a2bd-f4cea6d2e5f7",
              "text": "Передать операцию другому необученному работнику.",
              "displayOrder": 2
            },
            {
              "id": "eb88cbd9-057e-5ae7-a261-a4dd5c5b9f5e",
              "text": "Выполнить операцию по примеру коллеги без инструктажа.",
              "displayOrder": 3
            },
            {
              "id": "39c59ddb-183b-5b70-9efa-7abaabae9f3c",
              "text": "Не начинать операцию и сообщить руководителю о необходимости обучения и допуска.",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "39c59ddb-183b-5b70-9efa-7abaabae9f3c",
          "explanation": ""
        },
        {
          "id": "ae4258bd-6a0e-551e-9f29-2a7b7f15632b",
          "text": "Произошёл инцидент без травмы, но могло быть тяжёлое последствие. Что следует сделать?",
          "displayOrder": 2,
          "options": [
            {
              "id": "e5019704-1db4-579d-be85-c6fffa4c9896",
              "text": "Сообщить об инциденте, сохранить доступные сведения и участвовать в разборе причин и мерах предупреждения.",
              "displayOrder": 1
            },
            {
              "id": "10d667d4-7886-5847-98f3-350776baf457",
              "text": "Обсудить случай только неофициально после смены.",
              "displayOrder": 2
            },
            {
              "id": "834af64f-8d47-5f8c-994b-17fa06e76301",
              "text": "Не сообщать, поскольку никто не пострадал.",
              "displayOrder": 3
            },
            {
              "id": "dd766577-d309-5753-85d1-3b0f61579230",
              "text": "Удалить записи, чтобы не останавливать работу.",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "e5019704-1db4-579d-be85-c6fffa4c9896",
          "explanation": ""
        },
        {
          "id": "83c5fdf0-9a52-5731-a87e-6e6af48a995f",
          "text": "Работник заметил разлив неизвестного вещества. Как действовать?",
          "displayOrder": 3,
          "options": [
            {
              "id": "4e425888-6735-5815-849a-29051d13121c",
              "text": "Проверить вещество на запах с близкого расстояния.",
              "displayOrder": 1
            },
            {
              "id": "27d537ad-b069-5625-9583-6dd6a6538506",
              "text": "Оградить или покинуть опасную зону по обстановке и сообщить, не приступая к ликвидации без подготовки и средств.",
              "displayOrder": 2
            },
            {
              "id": "f675830d-c6ed-577c-ab0b-18dec82aaa0f",
              "text": "Смыть разлив в канализацию.",
              "displayOrder": 3
            },
            {
              "id": "60205898-3f4a-5b80-854c-cf4453d7345d",
              "text": "Собрать вещество голыми руками в обычную тару.",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "27d537ad-b069-5625-9583-6dd6a6538506",
          "explanation": ""
        },
        {
          "id": "f0210db0-654c-5ef6-bcbe-5a713da95894",
          "text": "В зоне постоянно возникает опасная пыль. Какой подход соответствует иерархии контроля?",
          "displayOrder": 4,
          "options": [
            {
              "id": "865f4b1c-e43d-5316-a343-243640e7810d",
              "text": "Убирать пыль сухой метлой во время работы.",
              "displayOrder": 1
            },
            {
              "id": "3aa16ec1-10ee-5b11-82a7-9c705067dea9",
              "text": "Считать предупреждающую надпись достаточной защитой.",
              "displayOrder": 2
            },
            {
              "id": "9b87bfaf-e101-5410-a258-89f425ee17c1",
              "text": "Ограничиться выдачей одноразовых масок без оценки.",
              "displayOrder": 3
            },
            {
              "id": "b55c58f1-decf-53b4-b9b3-23bd67d3d631",
              "text": "Сначала рассмотреть устранение или замену процесса и инженерное удаление пыли, затем организационные меры и СИЗ.",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "b55c58f1-decf-53b4-b9b3-23bd67d3d631",
          "explanation": ""
        },
        {
          "id": "cb6a97f2-e65c-5b41-9b69-645a9b1abc98",
          "text": "Переводится ли обучение автоматически при любом переводе работника?",
          "displayOrder": 5,
          "options": [
            {
              "id": "fa99446a-9511-55ac-b7f0-25f34f07102d",
              "text": "Решение принимает сам работник без документов работодателя.",
              "displayOrder": 1
            },
            {
              "id": "3fd23602-4571-5fc5-a7b9-fdbba2b6dfe9",
              "text": "Да, повторное обучение запрещено при любом переводе.",
              "displayOrder": 2
            },
            {
              "id": "c3ab6856-ea49-57aa-96a0-a445df5d3e8d",
              "text": "Порядок определяет работодатель по действующим правилам с учётом профессии, работы и условий; отсутствие повторения возможно только в предусмотренном случае.",
              "displayOrder": 3
            },
            {
              "id": "c6d9b034-6c4e-5f56-b2ac-a47e2404e1d7",
              "text": "Нет, обучение всегда повторяется независимо от условий.",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "c3ab6856-ea49-57aa-96a0-a445df5d3e8d",
          "explanation": ""
        },
        {
          "id": "3d8486fb-7cd3-5949-806d-7747dcb475b4",
          "text": "Что обязан сделать работник с выданными СИЗ?",
          "displayOrder": 6,
          "options": [
            {
              "id": "53f2c7d6-1c1f-5732-9f87-61397db0a677",
              "text": "Изменять конструкцию для удобства без согласования.",
              "displayOrder": 1
            },
            {
              "id": "3daf22fb-28f1-5559-94fa-dbee37afa396",
              "text": "Правильно применять, проверять перед использованием, беречь и сообщать о дефектах.",
              "displayOrder": 2
            },
            {
              "id": "17e12411-832d-56c2-adb1-af2ce2452017",
              "text": "Передавать их любому лицу без учёта размера и назначения.",
              "displayOrder": 3
            },
            {
              "id": "26e7f553-1183-59b8-adfb-23b26e8d1812",
              "text": "Использовать неисправные СИЗ до получения новых.",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "3daf22fb-28f1-5559-94fa-dbee37afa396",
          "explanation": ""
        },
        {
          "id": "54d4fbe1-0235-565d-9c0a-bf8d24c5fe59",
          "text": "Обнаружен запах, похожий на сероводород, и сработал газоанализатор. Как действовать?",
          "displayOrder": 7,
          "options": [
            {
              "id": "a455be56-91db-5a2d-8adc-87d92f6472d6",
              "text": "Немедленно покинуть опасную зону по маршруту, предупредить других и сообщить по аварийному порядку.",
              "displayOrder": 1
            },
            {
              "id": "4923c962-6c1c-53a7-9b12-77594d7072e5",
              "text": "Продолжить работу при открытой двери.",
              "displayOrder": 2
            },
            {
              "id": "6cfeef59-1c12-58a6-88d3-108efbd9e873",
              "text": "Искать утечку в одиночку без дыхательной защиты.",
              "displayOrder": 3
            },
            {
              "id": "5423b12d-ff59-5e1a-8cd1-5babb5f71d8e",
              "text": "Снять средство защиты, чтобы точнее определить запах.",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "a455be56-91db-5a2d-8adc-87d92f6472d6",
          "explanation": ""
        },
        {
          "id": "84f7ead1-6adb-5123-9371-fe3fc20f698f",
          "text": "Какова цель плана ликвидации аварий?",
          "displayOrder": 8,
          "options": [
            {
              "id": "f52fb4ba-c6b3-5c2d-b1f0-6acae7fa8070",
              "text": "Определить размер заработной платы аварийной группы.",
              "displayOrder": 1
            },
            {
              "id": "5e99f603-9438-53f5-9cae-7a2644668f40",
              "text": "Заменить техническое обслуживание оборудования.",
              "displayOrder": 2
            },
            {
              "id": "4f4b332f-3c84-5ce5-b93c-7c1af83997aa",
              "text": "Установить график обычной уборки помещений.",
              "displayOrder": 3
            },
            {
              "id": "5bbdf605-5d5e-57b1-ba4d-7de9e84d757e",
              "text": "Заранее определить оповещение, действия персонала, управление и ресурсы для локализации аварии и защиты людей.",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "5bbdf605-5d5e-57b1-ba4d-7de9e84d757e",
          "explanation": ""
        },
        {
          "id": "498d012e-7466-5ccc-92a8-6d416e82c366",
          "text": "Перед входом в резервуар газоанализ не выполнен. Как поступить?",
          "displayOrder": 9,
          "options": [
            {
              "id": "d5ad42c0-bafe-5243-8689-d8f379435099",
              "text": "Войти на короткое время, задержав дыхание.",
              "displayOrder": 1
            },
            {
              "id": "c219e516-cbce-55b2-9a3a-ceb92a2d2443",
              "text": "Проверить воздух горящей спичкой.",
              "displayOrder": 2
            },
            {
              "id": "ca167b24-fccd-5c7c-bee8-41f9d790da8a",
              "text": "Не входить до оформления процедуры, анализа среды, вентиляции, наблюдения и готовности к спасению.",
              "displayOrder": 3
            },
            {
              "id": "21fae48e-6545-585b-934e-aaba228cf9a0",
              "text": "Разрешить вход одному работнику без наблюдающего.",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "ca167b24-fccd-5c7c-bee8-41f9d790da8a",
          "explanation": ""
        },
        {
          "id": "3ab428ba-4222-56c8-92c0-410eb3ab6aab",
          "text": "Что означает инцидент в промышленной безопасности?",
          "displayOrder": 10,
          "options": [
            {
              "id": "bba1e961-564f-535a-93af-57f22bb82e5c",
              "text": "Любое письменное замечание работнику.",
              "displayOrder": 1
            },
            {
              "id": "cb0a277f-ae39-5303-b1a4-b1679b14fb30",
              "text": "Отказ, повреждение или отклонение на ОПО, которое нарушило безопасное ведение процесса, но не достигло признаков аварии.",
              "displayOrder": 2
            },
            {
              "id": "e87e147e-5bcf-5ca3-b61d-8b28d4eacd1c",
              "text": "Только несчастный случай вне производства.",
              "displayOrder": 3
            },
            {
              "id": "c65b1393-396d-5817-9eca-a1a97d675cc0",
              "text": "Любую плановую остановку на обед.",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "cb0a277f-ae39-5303-b1a4-b1679b14fb30",
          "explanation": ""
        }
      ]
    },
    {
      "id": "1c6f90ed-50d9-5f92-a14f-380caec6523a",
      "variantNumber": 3,
      "questions": [
        {
          "id": "added656-a55c-52cb-a44d-8d359edb6183",
          "text": "В рабочей зоне внезапно возникла опасность для жизни. Как реализуется право на безопасный труд?",
          "displayOrder": 1,
          "options": [
            {
              "id": "ba57aaa7-97dd-51a0-9165-f995b32fca56",
              "text": "Работник прекращает работу и уведомляет установленное ответственное лицо о непосредственной угрозе.",
              "displayOrder": 1
            },
            {
              "id": "7d25423c-a3b7-56a5-865a-c43650c8467c",
              "text": "Работник скрывает опасность до планового совещания.",
              "displayOrder": 2
            },
            {
              "id": "34157b98-457c-5c49-9dfb-9693b6bddee8",
              "text": "Работник покидает организацию без сообщения.",
              "displayOrder": 3
            },
            {
              "id": "93ad51ba-196a-5739-a59d-c3b2ed4f536d",
              "text": "Работник продолжает работу, если смена почти закончилась.",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "ba57aaa7-97dd-51a0-9165-f995b32fca56",
          "explanation": ""
        },
        {
          "id": "6f1b3155-2144-5411-8e9b-a262f99d2868",
          "text": "После происшествия нужно сохранить обстановку. Когда её допустимо изменить?",
          "displayOrder": 2,
          "options": [
            {
              "id": "bdcfd472-7a2a-540f-ab10-4e613fee6bef",
              "text": "Всегда сразу после происшествия для быстрой уборки.",
              "displayOrder": 1
            },
            {
              "id": "325d742f-c69d-5fff-8b27-57009aa45a35",
              "text": "Только ради продолжения производственного плана.",
              "displayOrder": 2
            },
            {
              "id": "1e2dbb5b-f0b6-52c4-a678-8008f5aed8b8",
              "text": "По просьбе любого свидетеля без документирования.",
              "displayOrder": 3
            },
            {
              "id": "2d210e33-3859-5cb1-892c-2d8101e1bb80",
              "text": "Когда это необходимо для спасения людей, предотвращения дальнейшей опасности или по указанию ответственных служб с фиксацией изменений.",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "2d210e33-3859-5cb1-892c-2d8101e1bb80",
          "explanation": ""
        },
        {
          "id": "746f572b-5f22-5f6a-9ff2-e8b9ab877fb8",
          "text": "Инструмент начал издавать необычный звук и вибрацию. Что требуется?",
          "displayOrder": 3,
          "options": [
            {
              "id": "f5d880bf-6145-535c-8b75-6850c760a60d",
              "text": "Продолжить до планового перерыва.",
              "displayOrder": 1
            },
            {
              "id": "a03c44b0-fbe0-5569-9d59-eb9c43c73301",
              "text": "Передать работающий инструмент коллеге без объяснения.",
              "displayOrder": 2
            },
            {
              "id": "2365b0aa-18b4-5dcc-b88d-9ed30bfe8e37",
              "text": "Прекратить работу, безопасно отключить инструмент и сообщить о неисправности.",
              "displayOrder": 3
            },
            {
              "id": "bf6d63c7-c2d4-5eca-8310-a39ab67acb2e",
              "text": "Увеличить нагрузку для проверки мощности.",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "2365b0aa-18b4-5dcc-b88d-9ed30bfe8e37",
          "explanation": ""
        },
        {
          "id": "83fef26f-148d-5958-85cf-f950a39d6506",
          "text": "Опасное движение механизма можно физически изолировать. Какой контроль предпочтителен?",
          "displayOrder": 4,
          "options": [
            {
              "id": "8f0d8b89-151c-5420-88c7-159e82cd65f1",
              "text": "Только выдать перчатки независимо от риска захвата.",
              "displayOrder": 1
            },
            {
              "id": "8d63e01e-d1e4-55d1-be37-0a58385dccdc",
              "text": "Установить исправное техническое ограждение с предусмотренными блокировками.",
              "displayOrder": 2
            },
            {
              "id": "a2274050-9490-5f24-a221-4878dc006792",
              "text": "Только напомнить работникам быть внимательнее.",
              "displayOrder": 3
            },
            {
              "id": "786cc205-fd27-5fc4-a8c3-0010bd0b966a",
              "text": "Только сократить время нахождения рядом.",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "8d63e01e-d1e4-55d1-be37-0a58385dccdc",
          "explanation": ""
        },
        {
          "id": "12e7e21a-bc88-5bad-937f-fd65dbc6bc74",
          "text": "Зачем проводится целевой инструктаж?",
          "displayOrder": 5,
          "options": [
            {
              "id": "cd7d6c90-cbf3-54dd-9a93-a995715081ba",
              "text": "Для конкретной разовой или опасной работы и условий её безопасного выполнения в установленных случаях.",
              "displayOrder": 1
            },
            {
              "id": "13b40efb-1886-5a2f-a0d7-48eb55067cb7",
              "text": "Для замены всех видов профессионального обучения.",
              "displayOrder": 2
            },
            {
              "id": "1d2b66e4-da71-5221-ac44-f16b7071c093",
              "text": "Только для ознакомления с графиком отпусков.",
              "displayOrder": 3
            },
            {
              "id": "dbf57436-2565-51ae-adef-dc342a70845e",
              "text": "Для разрешения работать неисправным оборудованием.",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "cd7d6c90-cbf3-54dd-9a93-a995715081ba",
          "explanation": ""
        },
        {
          "id": "6de1f664-6418-5957-9aa8-e454ff09f413",
          "text": "Почему коллективная защита обычно рассматривается раньше индивидуальной?",
          "displayOrder": 6,
          "options": [
            {
              "id": "a3034cb0-7e15-5eac-a944-828d791f7730",
              "text": "Она всегда дешевле любого другого решения.",
              "displayOrder": 1
            },
            {
              "id": "b8baba1a-c824-5d6d-93ef-6ad5bc29f187",
              "text": "Она используется только после несчастного случая.",
              "displayOrder": 2
            },
            {
              "id": "63bbabd9-0a2e-5cf2-9443-d02e5f4fb9cf",
              "text": "Она снижает воздействие опасности сразу для группы людей и меньше зависит от поведения каждого.",
              "displayOrder": 3
            },
            {
              "id": "e47b32a7-e669-5a86-be18-9ceb2dbf7f4c",
              "text": "Она позволяет отменить обучение персонала.",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "63bbabd9-0a2e-5cf2-9443-d02e5f4fb9cf",
          "explanation": ""
        },
        {
          "id": "ce9886c6-8c21-5c39-9fd1-040e4427f54c",
          "text": "Перед огневой работой на ОПО не устранены горючие материалы. Какое решение верное?",
          "displayOrder": 7,
          "options": [
            {
              "id": "8b9e4f31-fec9-5696-8488-7616dec7875b",
              "text": "Попросить одного работника наблюдать без средств тушения.",
              "displayOrder": 1
            },
            {
              "id": "a63b517c-a158-5ede-a3c1-dcd5802d0d0d",
              "text": "Начать работу, поставив рядом ведро воды.",
              "displayOrder": 2
            },
            {
              "id": "4a6b1461-2c5b-50a2-ae00-4c5f96b381f3",
              "text": "Накрыть материалы бумагой.",
              "displayOrder": 3
            },
            {
              "id": "6a50ff26-407b-56fe-8c01-c09dd9898e26",
              "text": "Не начинать работу до выполнения мер наряда-допуска и подготовки пожаробезопасной зоны.",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "6a50ff26-407b-56fe-8c01-c09dd9898e26",
          "explanation": ""
        },
        {
          "id": "6aca454f-67e5-5312-a73e-09fb9a658dd0",
          "text": "Что проверяют на противоаварийной тренировке?",
          "displayOrder": 8,
          "options": [
            {
              "id": "e17a2dc3-720d-5e92-bc5b-eaa42ce92efe",
              "text": "Понимание сигналов, маршрутов, ролей, связи и практических действий без создания реальной опасности.",
              "displayOrder": 1
            },
            {
              "id": "97e15ff2-765b-5657-8532-009a54969f2c",
              "text": "Только скорость заполнения табеля.",
              "displayOrder": 2
            },
            {
              "id": "7bafe744-8b4c-5d96-a7b3-e76998f11ec8",
              "text": "Только знание номера кабинета руководителя.",
              "displayOrder": 3
            },
            {
              "id": "b297dd4b-e690-56da-a813-039b2486d223",
              "text": "Только наличие повседневной одежды.",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "e17a2dc3-720d-5e92-bc5b-eaa42ce92efe",
          "explanation": ""
        },
        {
          "id": "f3197da2-ce96-5838-b4a9-69c41e655b1e",
          "text": "Газоанализатор показал значение выше установленного безопасного предела. Как действовать?",
          "displayOrder": 9,
          "options": [
            {
              "id": "3d41feae-7908-507f-9826-deddafde180f",
              "text": "Отключить прибор и ориентироваться на самочувствие.",
              "displayOrder": 1
            },
            {
              "id": "87236056-4c73-5b62-9a0c-6500b6b9ee0a",
              "text": "Не начинать или прекратить работу, выйти из зоны и выполнить аварийные и контрольные меры по процедуре.",
              "displayOrder": 2
            },
            {
              "id": "dbb2d46b-c81b-52d4-81f6-02f744e30001",
              "text": "Передать прибор другому работнику и остаться в зоне.",
              "displayOrder": 3
            },
            {
              "id": "f6f758f3-7d5d-514e-b95e-cc4fafd4a9a9",
              "text": "Продолжить работу в более быстром темпе.",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "87236056-4c73-5b62-9a0c-6500b6b9ee0a",
          "explanation": ""
        },
        {
          "id": "2e65f150-d64e-5858-94bd-d4d1b7d5e6b6",
          "text": "Что обозначает сокращение ПЛА?",
          "displayOrder": 10,
          "options": [
            {
              "id": "0abc679d-55fd-5f77-997b-83e2df519252",
              "text": "Плановое листовое армирование.",
              "displayOrder": 1
            },
            {
              "id": "66dd3741-3e45-5366-b651-29d0d77eb357",
              "text": "Перечень личных отпусков администрации.",
              "displayOrder": 2
            },
            {
              "id": "3e4fee19-0def-5b28-9bae-3eecd7872509",
              "text": "План ликвидации аварий, определяющий организованные действия при аварийной ситуации.",
              "displayOrder": 3
            },
            {
              "id": "32d895a7-31cf-5732-ab5c-4e71fe5ad043",
              "text": "Паспорт лабораторного анализа.",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "3e4fee19-0def-5b28-9bae-3eecd7872509",
          "explanation": ""
        }
      ]
    }
  ],
