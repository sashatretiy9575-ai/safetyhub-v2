  "variants": [
    {
      "id": "d3930e8d-40f7-5d9f-98fb-bdb08b119083",
      "variantNumber": 1,
      "questions": [
        {
          "id": "d6c4a8d9-1581-540a-b124-a09262885bad",
          "text": "Перед распиловкой доска качается на верстаке. Как следует поступить?",
          "displayOrder": 1,
          "options": [
            {
              "id": "afe70682-5b3b-5b17-8f87-ff322b92e682",
              "text": "Удерживать доску коленом и пилить свободной рукой.",
              "displayOrder": 1
            },
            {
              "id": "a6ea4733-8f83-54ba-8f8c-a8a529d49ac3",
              "text": "Попросить коллегу держать доску рядом с линией реза.",
              "displayOrder": 2
            },
            {
              "id": "f90b68b6-b411-51f9-a468-4c10747519dc",
              "text": "Надёжно закрепить заготовку упорами или зажимами и только затем начать распиловку.",
              "displayOrder": 3
            },
            {
              "id": "705e600b-bb35-5e75-8d23-8cf0dc95811e",
              "text": "Начать с коротких быстрых движений, чтобы доска сама заняла устойчивое положение.",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "f90b68b6-b411-51f9-a468-4c10747519dc",
          "explanation": ""
        },
        {
          "id": "eed054b7-721a-5d22-ac3b-153c31b82da1",
          "text": "При ручной распиловке линия реза проходит рядом с поддерживающей рукой. Как изменить работу?",
          "displayOrder": 2,
          "options": [
            {
              "id": "55555403-9a84-5874-80d8-9e0b43684ba2",
              "text": "Переставить и закрепить заготовку так, чтобы рука находилась вне линии движения пилы.",
              "displayOrder": 1
            },
            {
              "id": "70f15c6c-3a30-5ff0-aa75-a8eeb5b7b235",
              "text": "Увеличить темп распиловки, чтобы быстрее пройти опасный участок.",
              "displayOrder": 2
            },
            {
              "id": "43628d7c-f27d-568c-a98b-30d7b9b218db",
              "text": "Развернуть полотно зубьями в противоположную сторону.",
              "displayOrder": 3
            },
            {
              "id": "030527f9-df31-5784-b770-6ce81a5e8f84",
              "text": "Продолжить, сильнее прижав заготовку ладонью.",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "55555403-9a84-5874-80d8-9e0b43684ba2",
          "explanation": ""
        },
        {
          "id": "f2b4c912-0614-50a4-bf3c-b1e2b909764d",
          "text": "Плотник строгает доску, направляя рубанок к себе. Как исправить приём?",
          "displayOrder": 3,
          "options": [
            {
              "id": "ff437581-3f73-5809-9433-6eb61bc51a1c",
              "text": "Работать одной рукой, а второй придерживать лезвие.",
              "displayOrder": 1
            },
            {
              "id": "6dfcc247-af22-5abc-afc3-f63875d8fc04",
              "text": "Продолжить движение к себе, но уменьшить нажим.",
              "displayOrder": 2
            },
            {
              "id": "5d78f4ab-8718-56f3-ae79-764a66156a57",
              "text": "Снять упор с верстака, чтобы доска могла смещаться.",
              "displayOrder": 3
            },
            {
              "id": "620d6a71-013b-584f-bed4-873494b70f89",
              "text": "Закрепить доску и вести инструмент контролируемо от тела по устойчивой траектории.",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "620d6a71-013b-584f-bed4-873494b70f89",
          "explanation": ""
        },
        {
          "id": "ec122b32-0e93-5af5-9958-709bb78d2d6a",
          "text": "Полотно электролобзика заклинило в заготовке. Какое первое безопасное действие?",
          "displayOrder": 4,
          "options": [
            {
              "id": "30f21bbf-9106-50f3-8f4d-050229a15584",
              "text": "Потянуть инструмент на себя при работающем двигателе.",
              "displayOrder": 1
            },
            {
              "id": "ae9f9fe2-2f60-5b5d-a267-84d6c8f41fa9",
              "text": "Отпустить выключатель, отключить питание и дождаться полной остановки оснастки.",
              "displayOrder": 2
            },
            {
              "id": "e59b9056-c44a-56e1-ad62-12e2fec43ae9",
              "text": "Нажать на заготовку ногой и увеличить скорость.",
              "displayOrder": 3
            },
            {
              "id": "30426909-056c-50b6-86bf-5af960a4fbf3",
              "text": "Попытаться освободить полотно отвёрткой без отключения питания.",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "ae9f9fe2-2f60-5b5d-a267-84d6c8f41fa9",
          "explanation": ""
        },
        {
          "id": "e5ec4652-9008-56f2-8bec-708f12c7610d",
          "text": "Как проверить пригодность диска перед установкой на пилу?",
          "displayOrder": 5,
          "options": [
            {
              "id": "32edc437-1d5e-553c-bf38-30d21ede0c87",
              "text": "Установить любой диск с подходящим посадочным отверстием.",
              "displayOrder": 1
            },
            {
              "id": "3c04b389-ef6c-5711-8d7f-739e8369e1c1",
              "text": "Проверить диск ударом о металлический верстак.",
              "displayOrder": 2
            },
            {
              "id": "8a0e1e91-21fd-5665-833f-e1df6e3bf7fc",
              "text": "Сверить тип, размер и допустимую частоту вращения с инструментом и убедиться в отсутствии повреждений.",
              "displayOrder": 3
            },
            {
              "id": "e9a3d3a0-cf3a-5854-8710-b4981024a756",
              "text": "Выбрать диск только по цвету упаковки.",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "8a0e1e91-21fd-5665-833f-e1df6e3bf7fc",
          "explanation": ""
        },
        {
          "id": "6840d392-9cec-579f-bf3c-c29d7c274594",
          "text": "При шлифовании образуется много мелкой древесной пыли. Какая мера наиболее эффективна?",
          "displayOrder": 6,
          "options": [
            {
              "id": "e8d828e1-f16d-5806-93b2-623ba6af2475",
              "text": "Закрыть вентиляционные отверстия, чтобы пыль не разлеталась.",
              "displayOrder": 1
            },
            {
              "id": "402602f8-ebf0-5abd-9a03-d339ada10eee",
              "text": "Использовать только хлопчатобумажные перчатки.",
              "displayOrder": 2
            },
            {
              "id": "6229b33f-af34-5b31-abc8-10390cb63cd8",
              "text": "Сместить пыль вентилятором в общий проход.",
              "displayOrder": 3
            },
            {
              "id": "8b41e655-555c-5902-a624-ec6a15be3159",
              "text": "Применить удаление пыли у источника, проветривание и подобранные по риску СИЗ.",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "8b41e655-555c-5902-a624-ec6a15be3159",
          "explanation": ""
        },
        {
          "id": "55f72b98-a3b9-5d12-ac79-085d87b81c9b",
          "text": "Когда разрешается менять пильный диск или полотно?",
          "displayOrder": 7,
          "options": [
            {
              "id": "995b5ac1-0ba7-5619-8680-29f3e3d1b7d7",
              "text": "После отключения инструмента от источника энергии и полной остановки всех движущихся частей.",
              "displayOrder": 1
            },
            {
              "id": "72afca1e-ba27-54cb-807f-82d7b921a26b",
              "text": "На холостом ходу при минимальной частоте вращения.",
              "displayOrder": 2
            },
            {
              "id": "d1f960c6-410b-581e-ba62-97b66044ca79",
              "text": "Сразу после отпускания выключателя, пока диск вращается по инерции.",
              "displayOrder": 3
            },
            {
              "id": "d526ba2d-9252-54ae-9187-9bd66ec68e7e",
              "text": "При включённом инструменте, если использовать плотные перчатки.",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "995b5ac1-0ba7-5619-8680-29f3e3d1b7d7",
          "explanation": ""
        },
        {
          "id": "bab7074c-e136-5ba1-8b2c-63073ec855a8",
          "text": "Какая последовательность предсменной проверки электроинструмента правильная?",
          "displayOrder": 8,
          "options": [
            {
              "id": "9e728bfa-d3ce-5d43-a7d4-b6239cb223c7",
              "text": "Проверить только выключатель, не осматривая оснастку.",
              "displayOrder": 1
            },
            {
              "id": "c9743526-1db8-5ca2-9cf0-8472a6fd3788",
              "text": "Снять ограждение, включить инструмент и затем проверить диск рукой.",
              "displayOrder": 2
            },
            {
              "id": "2735118e-c220-54f7-a687-308e3f341b03",
              "text": "Осмотреть корпус и кабель, проверить ограждения и оснастку, затем выполнить предусмотренную проверку без нагрузки.",
              "displayOrder": 3
            },
            {
              "id": "3c2a36e3-a583-5740-a257-022fef4f6476",
              "text": "Сначала выполнить рабочий рез, затем осмотреть кабель и кожух.",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "2735118e-c220-54f7-a687-308e3f341b03",
          "explanation": ""
        },
        {
          "id": "2324e993-e7cf-5e80-922e-36b09379c4c0",
          "text": "Как завершить работу электроинструментом?",
          "displayOrder": 9,
          "options": [
            {
              "id": "ff9efcdd-5612-53e2-b8a0-8fcd9a38f95b",
              "text": "Оставить инструмент подключённым для следующей смены.",
              "displayOrder": 1
            },
            {
              "id": "389cfaec-0729-52b2-ad7f-d41aebfcfbb5",
              "text": "Выключить, дождаться полной остановки, отключить питание, очистить и убрать инструмент.",
              "displayOrder": 2
            },
            {
              "id": "d50527ea-199e-5735-9f9f-c046b6f2adbf",
              "text": "Положить вращающийся инструмент на верстак и отключить позже.",
              "displayOrder": 3
            },
            {
              "id": "4850fe67-795c-5253-a8e1-0dc187d700d3",
              "text": "Остановить оснастку рукой через ветошь.",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "389cfaec-0729-52b2-ad7f-d41aebfcfbb5",
          "explanation": ""
        },
        {
          "id": "9c91c699-13aa-5507-b288-09c1f5d8e94e",
          "text": "Что означает обратный удар при работе пилой?",
          "displayOrder": 10,
          "options": [
            {
              "id": "0ea1082d-9f22-5d69-a1bf-3683d5b2eb91",
              "text": "Плановую остановку двигателя после отпускания выключателя.",
              "displayOrder": 1
            },
            {
              "id": "bef4cefe-dd30-5b8a-be2e-400de0f63c47",
              "text": "Постепенное затупление режущей кромки.",
              "displayOrder": 2
            },
            {
              "id": "ec8bd640-bede-553c-92b7-1066b0ff8df4",
              "text": "Обычное удаление опилок из пропила.",
              "displayOrder": 3
            },
            {
              "id": "8799388c-795d-5e28-abd2-64418865647c",
              "text": "Внезапное неконтролируемое движение инструмента или заготовки вследствие заклинивания либо захвата диска.",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "8799388c-795d-5e28-abd2-64418865647c",
          "explanation": ""
        }
      ]
    },
    {
      "id": "8abfd5d2-320b-51f0-9c7a-1aa87f9bdef0",
      "variantNumber": 2,
      "questions": [
        {
          "id": "bf4e9d91-04e0-584f-a631-4612503457a3",
          "text": "В проходе у рабочего места лежат обрезки и кабель электроинструмента. Что сделать до начала работы?",
          "displayOrder": 1,
          "options": [
            {
              "id": "41f3e5a3-960d-5c6b-ad53-a1a0f72b8e65",
              "text": "Прикрыть обрезки листом фанеры и начать работу.",
              "displayOrder": 1
            },
            {
              "id": "f96b5414-5949-5e47-b1bd-8da003807275",
              "text": "Убрать обрезки, проложить кабель безопасно и обеспечить свободный проход.",
              "displayOrder": 2
            },
            {
              "id": "c48a73d4-6416-5c8e-9700-5a4d48f2c3f5",
              "text": "Перенести кабель ближе к линии реза, чтобы он был заметнее.",
              "displayOrder": 3
            },
            {
              "id": "6eeabe3e-8ae2-5f96-a44f-543fc603e5cf",
              "text": "Оставить всё на месте, если работа займёт меньше часа.",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "f96b5414-5949-5e47-b1bd-8da003807275",
          "explanation": ""
        },
        {
          "id": "7a130cb7-121b-5651-9b1c-a23cb0bcb1ee",
          "text": "У циркулярной пилы защитный кожух возвращается не полностью. Что должен сделать плотник?",
          "displayOrder": 2,
          "options": [
            {
              "id": "89e9c0fa-332b-53dc-ad05-a1c6deba6fe0",
              "text": "Пользоваться пилой только для неглубоких резов.",
              "displayOrder": 1
            },
            {
              "id": "9d2e5e18-e61d-58b8-b2aa-38f13a785972",
              "text": "Зафиксировать кожух в открытом положении для удобства.",
              "displayOrder": 2
            },
            {
              "id": "fcafaff9-b7f5-5c91-9a0c-4e82b6f7397d",
              "text": "Смазать кожух во время вращения диска и продолжить работу.",
              "displayOrder": 3
            },
            {
              "id": "4bdc5a18-1772-5e0c-842f-ac07663b5e0f",
              "text": "Отключить пилу, вывести её из эксплуатации и сообщить о неисправности.",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "4bdc5a18-1772-5e0c-842f-ac07663b5e0f",
          "explanation": ""
        },
        {
          "id": "c28ca391-3c7a-5328-a846-e01309430bde",
          "text": "У стамески расколота рукоятка. Как поступить?",
          "displayOrder": 3,
          "options": [
            {
              "id": "096c0a1e-22a8-52ba-bebf-e921164f5b10",
              "text": "Изъять инструмент из работы до замены или исправного ремонта рукоятки.",
              "displayOrder": 1
            },
            {
              "id": "f2c2a39b-f653-59b7-9180-3b21bcb53a74",
              "text": "Обмотать раскол изолентой и использовать для лёгких работ.",
              "displayOrder": 2
            },
            {
              "id": "f77e465a-f0d5-5e3e-bee7-ccb2d41dd3d5",
              "text": "Держать стамеску за металлическую часть.",
              "displayOrder": 3
            },
            {
              "id": "2360b422-85f3-5cee-b809-b5c777c125d2",
              "text": "Работать только мягкой киянкой без замены рукоятки.",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "096c0a1e-22a8-52ba-bebf-e921164f5b10",
          "explanation": ""
        },
        {
          "id": "38fe63cc-a0d7-5b8b-bb04-685d75051407",
          "text": "Работник получил удар электрическим током от инструмента. Что должен сделать очевидец?",
          "displayOrder": 4,
          "options": [
            {
              "id": "6e71c69f-0812-5470-9181-acb96ea4bbd7",
              "text": "Полить инструмент водой, чтобы прекратить искрение.",
              "displayOrder": 1
            },
            {
              "id": "ed6abfd5-10b0-51a1-b6b0-612a8f3760b3",
              "text": "Сначала убрать инструмент в шкаф, затем сообщить руководителю.",
              "displayOrder": 2
            },
            {
              "id": "89304837-9a36-5b0e-9fbc-2ef73f8b170e",
              "text": "Безопасно отключить питание, вызвать помощь и оказывать первую помощь без прямого контакта с токоведущей частью.",
              "displayOrder": 3
            },
            {
              "id": "ceee4738-6549-5468-8baa-0e26457ba042",
              "text": "Схватить пострадавшего за руки и оттащить его.",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "89304837-9a36-5b0e-9fbc-2ef73f8b170e",
          "explanation": ""
        },
        {
          "id": "6197587a-8159-5f7a-b57d-060ca8760bef",
          "text": "На кабеле электроинструмента повреждена изоляция. Какое решение соответствует требованиям безопасности?",
          "displayOrder": 5,
          "options": [
            {
              "id": "8759c0c7-1d70-5420-a7b2-3af1ece5bab6",
              "text": "Подключить инструмент через более длинный удлинитель без ремонта.",
              "displayOrder": 1
            },
            {
              "id": "aacc1e16-86e9-5228-bc12-8db26d0b1a27",
              "text": "Не использовать инструмент до устранения неисправности уполномоченным способом.",
              "displayOrder": 2
            },
            {
              "id": "bab54152-90cd-55d8-bc96-6630251efea7",
              "text": "Закрыть повреждение бумагой и работать в сухом помещении.",
              "displayOrder": 3
            },
            {
              "id": "c63c37f6-589d-577d-b91b-6e6ccd6b1059",
              "text": "Держать кабель ногой, чтобы место повреждения не двигалось.",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "aacc1e16-86e9-5228-bc12-8db26d0b1a27",
          "explanation": ""
        },
        {
          "id": "d28794af-3bbb-5ded-b718-3b38291f849d",
          "text": "Почему свободные перчатки опасны возле вращающейся оснастки?",
          "displayOrder": 6,
          "options": [
            {
              "id": "4c7fdf42-817b-5878-86f3-d9e83fa9cbd7",
              "text": "Перчатки обязательно повышают температуру двигателя.",
              "displayOrder": 1
            },
            {
              "id": "f1fb97b2-fd40-5fd3-bbbe-caa1c1b9a87b",
              "text": "Перчатки меняют направление вращения инструмента.",
              "displayOrder": 2
            },
            {
              "id": "e1d48829-ca52-5c26-a45b-1b245defb419",
              "text": "Перчатки мешают работе только при низкой температуре.",
              "displayOrder": 3
            },
            {
              "id": "a14d8ba5-f4b2-5787-91dd-a76d46325ee5",
              "text": "Материал перчатки может быть захвачен вращающейся частью и затянуть руку.",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "a14d8ba5-f4b2-5787-91dd-a76d46325ee5",
          "explanation": ""
        },
        {
          "id": "535250e4-ff60-5c6c-b1de-fb7d6e7f63a5",
          "text": "Как правильно хранить ручной режущий инструмент после очистки?",
          "displayOrder": 7,
          "options": [
            {
              "id": "4f24f6a9-be50-579c-a567-a31ee7d59f52",
              "text": "В общей куче с крепежом и обрезками.",
              "displayOrder": 1
            },
            {
              "id": "0011c056-c08f-556b-bef2-b99aee9cda12",
              "text": "Во влажной ветоши, чтобы металл не нагревался.",
              "displayOrder": 2
            },
            {
              "id": "7c3c2b29-563a-52b0-be93-39aedeaa4246",
              "text": "В сухом отведённом месте, с защищённой режущей частью и без риска падения.",
              "displayOrder": 3
            },
            {
              "id": "c6735c4d-818c-5316-8a6f-52c4ffddb0a9",
              "text": "На краю верстака режущей частью наружу.",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "7c3c2b29-563a-52b0-be93-39aedeaa4246",
          "explanation": ""
        },
        {
          "id": "a27ef516-349c-5595-81ce-60becd4cb45c",
          "text": "Какой порядок проверки ручного инструмента наиболее рационален?",
          "displayOrder": 8,
          "options": [
            {
              "id": "8f1797ab-c7f8-5916-a1a2-e871e0dd662e",
              "text": "Проверить назначение, целостность рукоятки, состояние рабочей части и надёжность её крепления.",
              "displayOrder": 1
            },
            {
              "id": "32d03942-b080-50be-a1aa-38ac98600288",
              "text": "Заточить любой инструмент независимо от его назначения.",
              "displayOrder": 2
            },
            {
              "id": "bd9576d3-ffec-5335-8415-70401a795169",
              "text": "Сначала испытать инструмент максимальным ударом по металлу.",
              "displayOrder": 3
            },
            {
              "id": "7364813d-0323-55d7-8d72-f4e8736a6880",
              "text": "Проверить только чистоту рукоятки.",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "8f1797ab-c7f8-5916-a1a2-e871e0dd662e",
          "explanation": ""
        },
        {
          "id": "b2096a33-d277-58bf-a4c4-783c1f793a77",
          "text": "Инструмент начал сильно вибрировать и появился запах перегрева. Какова правильная последовательность?",
          "displayOrder": 9,
          "options": [
            {
              "id": "67d15d9c-5ace-5fa3-96d8-7dd786fc598a",
              "text": "Увеличить нагрузку, чтобы вибрация уменьшилась.",
              "displayOrder": 1
            },
            {
              "id": "020e68b1-268b-5154-9e89-f5a7c4e8eb53",
              "text": "Охладить инструмент водой без отключения.",
              "displayOrder": 2
            },
            {
              "id": "998ada4c-6831-56e0-9c28-49f82365aeeb",
              "text": "Продолжать до полного отказа, затем заменить оснастку.",
              "displayOrder": 3
            },
            {
              "id": "ec62b09f-c1a1-5b3f-a4fc-a8b752452adf",
              "text": "Немедленно остановить, отключить, обозначить неисправность и передать на проверку.",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "ec62b09f-c1a1-5b3f-a4fc-a8b752452adf",
          "explanation": ""
        },
        {
          "id": "55548083-4a49-5b46-a1bb-df857482f431",
          "text": "Каково назначение защитного ограждения инструмента?",
          "displayOrder": 10,
          "options": [
            {
              "id": "fa91def9-a442-5171-97d5-cd6de4abe981",
              "text": "Заменять обучение и другие меры защиты.",
              "displayOrder": 1
            },
            {
              "id": "26cc1286-64cf-5c42-b542-1fff1a56848e",
              "text": "Ограничивать доступ к опасной движущейся части и сдерживать выброс частиц в предусмотренных пределах.",
              "displayOrder": 2
            },
            {
              "id": "27389fc5-4478-55bf-90d7-64a97c934021",
              "text": "Удерживать заготовку вместо зажимного устройства.",
              "displayOrder": 3
            },
            {
              "id": "01730d90-71f8-594f-aece-40ffdb822be1",
              "text": "Увеличивать скорость вращения оснастки.",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "26cc1286-64cf-5c42-b542-1fff1a56848e",
          "explanation": ""
        }
      ]
    },
    {
      "id": "91f10066-0447-5e23-87da-032ae5ca37b1",
      "variantNumber": 3,
      "questions": [
        {
          "id": "a4676234-b37a-53b4-99a5-567be5236cbf",
          "text": "При осмотре деревянной заготовки обнаружен выступающий гвоздь. Какое действие правильное?",
          "displayOrder": 1,
          "options": [
            {
              "id": "1e15e599-f256-5345-bb71-314ac1eff289",
              "text": "Не начинать обработку, пока металлическое включение не удалено или заготовка не заменена.",
              "displayOrder": 1
            },
            {
              "id": "1ca0f285-f5ca-550f-bc18-8eca2ae667d7",
              "text": "Надеть более плотные перчатки и обработать заготовку обычным способом.",
              "displayOrder": 2
            },
            {
              "id": "039787b3-c0ec-56c3-9399-e164d6c8cd1d",
              "text": "Обработать участок на минимальной скорости, не меняя оснастку.",
              "displayOrder": 3
            },
            {
              "id": "d6e1698e-290a-56e1-a1bb-0ba5b193704e",
              "text": "Отметить гвоздь мелом и продолжить пиление рядом с ним.",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "1e15e599-f256-5345-bb71-314ac1eff289",
          "explanation": ""
        },
        {
          "id": "d5b8618e-480c-543f-95a0-13abd8e6b23e",
          "text": "Небольшую деталь неудобно удерживать при обработке электроинструментом. Какой способ безопаснее?",
          "displayOrder": 2,
          "options": [
            {
              "id": "e4945645-2413-51e2-abf7-0f6fac26c101",
              "text": "Удерживать деталь пальцами как можно ближе к месту обработки.",
              "displayOrder": 1
            },
            {
              "id": "a770aa55-7d37-58fb-b6f2-2b57409ae3ce",
              "text": "Прижать деталь обувью к полу.",
              "displayOrder": 2
            },
            {
              "id": "4c3dda87-094b-5ad3-b703-bc8883b1a129",
              "text": "Закрепить деталь подходящим приспособлением и держать руки вне опасной зоны.",
              "displayOrder": 3
            },
            {
              "id": "5f815f2c-c512-5855-af9c-519a253df24a",
              "text": "Попросить коллегу держать деталь рукой со стороны выхода оснастки.",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "4c3dda87-094b-5ad3-b703-bc8883b1a129",
          "explanation": ""
        },
        {
          "id": "34eea8cc-16aa-54d5-90d2-a0360c233f33",
          "text": "После строгания на верстаке осталась стружка возле режущего инструмента. Как её убрать?",
          "displayOrder": 3,
          "options": [
            {
              "id": "71332ca9-b123-5eea-8724-7124491411ca",
              "text": "Сдуть стружку на коллегу сжатым воздухом.",
              "displayOrder": 1
            },
            {
              "id": "7f9d0faf-a32c-5ef8-b0d8-39f7a670ff9d",
              "text": "После остановки и безопасного размещения инструмента удалить стружку щёткой или другим приспособлением.",
              "displayOrder": 2
            },
            {
              "id": "27f71c0c-57d2-52d3-bb3b-d04228dffe2f",
              "text": "Убирать стружку только после окончания смены, не останавливая работу.",
              "displayOrder": 3
            },
            {
              "id": "4f79c45a-ff94-5a08-b64c-afe073d66273",
              "text": "Смахнуть стружку ладонью в сторону прохода.",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "7f9d0faf-a32c-5ef8-b0d8-39f7a670ff9d",
          "explanation": ""
        },
        {
          "id": "58b9e341-d705-526f-960a-0c7af961235a",
          "text": "В зоне обработки древесины появился дым и запах горения. Как действовать?",
          "displayOrder": 4,
          "options": [
            {
              "id": "2b88c665-5d74-52ba-8c14-d47adb5416bb",
              "text": "Открыть все ёмкости с горючими материалами для проверки.",
              "displayOrder": 1
            },
            {
              "id": "cce1a900-6db1-5cc6-8cc0-d038cda8980c",
              "text": "Закрыть помещение и продолжить работу в соседней зоне.",
              "displayOrder": 2
            },
            {
              "id": "08dbd77b-7161-5178-8bff-c97683c4b5cd",
              "text": "Ждать видимого пламени, не сообщая о признаках пожара.",
              "displayOrder": 3
            },
            {
              "id": "03b8e1bf-83ad-52b7-86c6-4418f263c616",
              "text": "Остановить работу, отключить энергию при безопасной возможности, подать тревогу, сообщить 101/112 и эвакуироваться по обстановке.",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "03b8e1bf-83ad-52b7-86c6-4418f263c616",
          "explanation": ""
        },
        {
          "id": "29f5db9d-1996-5974-a7e7-2e6fce8c01a2",
          "text": "Работнику мешает штатное ограждение режущей части. Что допустимо?",
          "displayOrder": 5,
          "options": [
            {
              "id": "a867e1d2-e839-5932-b829-c802f6fa5d4c",
              "text": "Снять ограждение на один рез и установить его после работы.",
              "displayOrder": 1
            },
            {
              "id": "3b2b4f3c-9902-5367-9a9a-aabb87dbf1ed",
              "text": "Закрепить ограждение проволокой в открытом положении.",
              "displayOrder": 2
            },
            {
              "id": "86292da2-cb4e-5405-8657-4ad08f33d5c2",
              "text": "Сохранить исправное ограждение и подобрать безопасный способ выполнения операции по инструкции изготовителя.",
              "displayOrder": 3
            },
            {
              "id": "403bdee0-cdb2-5ede-b86b-7b25adce5d7a",
              "text": "Попросить коллегу удерживать ограждение рукой.",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "86292da2-cb4e-5405-8657-4ad08f33d5c2",
          "explanation": ""
        },
        {
          "id": "d946b86f-f721-52ff-8e48-a84845b3b7c5",
          "text": "Одновременно присутствуют высокий шум и летящая стружка. Как выбрать защиту?",
          "displayOrder": 6,
          "options": [
            {
              "id": "4c20c937-858f-5e4b-9afd-94f76c3fb94c",
              "text": "Использовать исправную защиту глаз и слуха, соответствующую оценке риска и выполняемой операции.",
              "displayOrder": 1
            },
            {
              "id": "7c8d285d-586b-5571-a285-919564e45038",
              "text": "Закрыть глаза при прохождении стружки и не использовать СИЗ.",
              "displayOrder": 2
            },
            {
              "id": "d74f9bca-b0d7-5039-9f62-c61b7c1dc66c",
              "text": "Надеть обычные очки и отключить штатное ограждение.",
              "displayOrder": 3
            },
            {
              "id": "c8682863-fdee-5de2-b9a2-d4d65152df7c",
              "text": "Выбрать только защиту слуха, поскольку шум опаснее стружки.",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "4c20c937-858f-5e4b-9afd-94f76c3fb94c",
          "explanation": ""
        },
        {
          "id": "890c6cc1-4db1-5623-995e-cec8dab489a3",
          "text": "Как безопасно удалять пыль с инструмента после работы?",
          "displayOrder": 7,
          "options": [
            {
              "id": "bf405947-aeb9-56e1-923a-6f80f3d5f3c7",
              "text": "Очищать вентиляционные отверстия металлической проволокой при включённом питании.",
              "displayOrder": 1
            },
            {
              "id": "e3c6ae2b-5ce4-5328-b5c6-02acc6351a73",
              "text": "Обдувать работающий инструмент сжатым воздухом в сторону коллег.",
              "displayOrder": 2
            },
            {
              "id": "18afcd14-4532-586b-ba3e-0f5c6e670b7f",
              "text": "Погружать электрический инструмент в воду.",
              "displayOrder": 3
            },
            {
              "id": "4c964e58-4e4e-51cd-b560-0bcc912f8744",
              "text": "Отключить инструмент и очистить его способом, предусмотренным инструкцией, не направляя загрязнение на людей.",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "4c964e58-4e4e-51cd-b560-0bcc912f8744",
          "explanation": ""
        },
        {
          "id": "d95244c7-64ed-594a-afce-7695c2fa8cfd",
          "text": "Что следует проверить перед началом обработки заготовки?",
          "displayOrder": 8,
          "options": [
            {
              "id": "a56b6911-7bb2-5f99-bd2a-c925164dfe6c",
              "text": "Только наличие свободной розетки.",
              "displayOrder": 1
            },
            {
              "id": "abeaa3ac-016c-5daa-8383-8230454b480b",
              "text": "Рабочее место, материал и его крепление, исправность инструмента и требуемые меры защиты.",
              "displayOrder": 2
            },
            {
              "id": "56c58aab-3d60-5b9a-adc2-aa0a805be97f",
              "text": "Только внешний вид готового изделия.",
              "displayOrder": 3
            },
            {
              "id": "07863388-bc02-54b3-b727-79c636d00809",
              "text": "Только скорость выполнения предыдущей операции.",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "abeaa3ac-016c-5daa-8383-8230454b480b",
          "explanation": ""
        },
        {
          "id": "28d7415c-20bd-5f43-bada-3785e1c1f1e9",
          "text": "Как безопасно заменить оснастку?",
          "displayOrder": 9,
          "options": [
            {
              "id": "1836c106-3353-528a-92f1-c9dec9d8161a",
              "text": "Отключить энергию, проверить совместимость и состояние оснастки, установить её по инструкции и восстановить ограждения.",
              "displayOrder": 1
            },
            {
              "id": "b59600a0-0b49-52bd-8bc2-bfb866501760",
              "text": "Использовать любую оснастку одинакового цвета.",
              "displayOrder": 2
            },
            {
              "id": "c140e6cd-6151-593a-af2b-739b45a7e1d7",
              "text": "После установки сразу работать на полной нагрузке без проверки.",
              "displayOrder": 3
            },
            {
              "id": "625a7d46-5f8e-550e-8477-3f17b1fa5dba",
              "text": "Снять ограждение при включённом двигателе и быстро заменить оснастку.",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "1836c106-3353-528a-92f1-c9dec9d8161a",
          "explanation": ""
        },
        {
          "id": "f245a326-8260-5616-bbc2-865f09ff4436",
          "text": "Что такое местное удаление пыли?",
          "displayOrder": 10,
          "options": [
            {
              "id": "712dc75c-ab11-5a85-a719-4045a68b32a3",
              "text": "Закрытие всех приточных отверстий во время работы.",
              "displayOrder": 1
            },
            {
              "id": "4e2bae48-fd58-58c6-afc5-4f5ad8961c4a",
              "text": "Уборка пола в конце смены сухой метлой.",
              "displayOrder": 2
            },
            {
              "id": "6b61fdc7-ec45-5a9e-a3e0-1aecb03bc8fb",
              "text": "Захват загрязнения непосредственно у места его образования до распространения по рабочей зоне.",
              "displayOrder": 3
            },
            {
              "id": "aaca6744-f139-5839-85c1-09fc427175b0",
              "text": "Перемещение пыли вентилятором в соседнее помещение.",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "6b61fdc7-ec45-5a9e-a3e0-1aecb03bc8fb",
          "explanation": ""
        }
      ]
    }
  ],
