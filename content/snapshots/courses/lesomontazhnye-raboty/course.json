  "variants": [
    {
      "id": "0ed3fd0d-07bb-53ee-8c0b-dda4bd89ba1e",
      "variantNumber": 1,
      "questions": [
        {
          "id": "7d6d72f1-1f4d-5a6c-be94-d6478feeb5d0",
          "text": "Пользователь лесов снял диагональную связь, чтобы пронести материал. Как действовать?",
          "displayOrder": 1,
          "options": [
            {
              "id": "b2a38aee-d39c-54d9-ba98-d36287ef7c82",
              "text": "Немедленно прекратить использование участка и восстановить конструкцию допущенным персоналом по проекту.",
              "displayOrder": 1
            },
            {
              "id": "fb43b758-cfa3-54a8-beda-832bd5f697c5",
              "text": "Оставить связь снятой до конца смены.",
              "displayOrder": 2
            },
            {
              "id": "84365384-7574-5305-be87-5f52ccc118a1",
              "text": "Заменить связь верёвкой.",
              "displayOrder": 3
            },
            {
              "id": "cc2f5921-89d1-5112-b37b-169f94ccda05",
              "text": "Разрешить работу, если на настиле находится один человек.",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "b2a38aee-d39c-54d9-ba98-d36287ef7c82",
          "explanation": ""
        },
        {
          "id": "6769c0ca-1f86-5959-910f-e160a39fefb4",
          "text": "Опорная плита лесов установлена на рыхлый грунт без подкладки. Что требуется?",
          "displayOrder": 2,
          "options": [
            {
              "id": "1f96b1f0-e729-5e0b-a7dc-fa4421bac739",
              "text": "Подложить случайный кирпич под одну сторону плиты.",
              "displayOrder": 1
            },
            {
              "id": "59833fc2-168e-5ea3-a833-73b5279dacdb",
              "text": "Увеличить нагрузку на стойку для уплотнения грунта.",
              "displayOrder": 2
            },
            {
              "id": "1a29a980-87fa-5192-bb7f-8e642f7b37fa",
              "text": "Утрамбовать грунт ногой вокруг стойки.",
              "displayOrder": 3
            },
            {
              "id": "f6fdebc8-0ac1-50d5-93bc-31dcfff2fe47",
              "text": "Прекратить монтаж и подготовить устойчивое основание по проекту и паспорту системы.",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "f6fdebc8-0ac1-50d5-93bc-31dcfff2fe47",
          "explanation": ""
        },
        {
          "id": "125ee8c2-aef7-5702-a648-7bb0b2933bc9",
          "text": "После сильного ветра видимых повреждений с земли нет. Можно ли сразу возобновить работу?",
          "displayOrder": 3,
          "options": [
            {
              "id": "2a89d0af-4b8a-502b-877c-cadbd559834e",
              "text": "Да, если снизить количество материалов на настиле.",
              "displayOrder": 1
            },
            {
              "id": "5cda491d-e173-59ca-830d-f4743255aae9",
              "text": "Да, если настил сухой.",
              "displayOrder": 2
            },
            {
              "id": "cb51c0bb-c96f-5ef0-bd02-319969219a72",
              "text": "Нет; леса должны пройти внеочередную проверку компетентным лицом до допуска.",
              "displayOrder": 3
            },
            {
              "id": "03e6539b-0d79-5bf1-88f7-8df08f169440",
              "text": "Да, если работники используют каски.",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "cb51c0bb-c96f-5ef0-bd02-319969219a72",
          "explanation": ""
        },
        {
          "id": "63665f9e-9350-57c8-8608-47145e4c7205",
          "text": "На настил складируют материалы сверх указанной допустимой нагрузки. Что делать?",
          "displayOrder": 4,
          "options": [
            {
              "id": "861a440c-60ad-5017-b768-4fb4abdeff47",
              "text": "Распределить груз у одного края настила.",
              "displayOrder": 1
            },
            {
              "id": "db1297af-0b4e-5140-8504-828c70032638",
              "text": "Немедленно прекратить загрузку и привести нагрузку в соответствие с проектом и статусом лесов.",
              "displayOrder": 2
            },
            {
              "id": "77324bd6-f300-5dc9-9b81-3054fa118d76",
              "text": "Снять часть связей для расширения места.",
              "displayOrder": 3
            },
            {
              "id": "feb744da-75ef-5e26-a0ef-741949d0bcbc",
              "text": "Разрешить перегрузку на короткое время.",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "db1297af-0b4e-5140-8504-828c70032638",
          "explanation": ""
        },
        {
          "id": "088d7595-6f55-579b-adfa-695b5e0f73f0",
          "text": "Для чего леса крепят к сооружению?",
          "displayOrder": 5,
          "options": [
            {
              "id": "226944f1-0e15-5225-bda3-9b76c98763ee",
              "text": "Для замены всех диагональных связей.",
              "displayOrder": 1
            },
            {
              "id": "cce74001-f22f-5a68-bb8d-d9bcd0125dcb",
              "text": "Чтобы увеличить ширину настила без расчёта.",
              "displayOrder": 2
            },
            {
              "id": "7e3b8568-f6b9-5657-ad1f-62697c4cdfdb",
              "text": "Только для обозначения высоты яруса.",
              "displayOrder": 3
            },
            {
              "id": "b42c12c1-1cab-5793-97f5-aca894172bf4",
              "text": "Для обеспечения расчётной пространственной устойчивости по проекту и схеме монтажа.",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "b42c12c1-1cab-5793-97f5-aca894172bf4",
          "explanation": ""
        },
        {
          "id": "0e6cf77a-3615-5ba9-ae0e-6bdee837ebfc",
          "text": "Каким должен быть рабочий настил?",
          "displayOrder": 6,
          "options": [
            {
              "id": "b450e982-07b2-55dc-a0ff-10ea8400a86c",
              "text": "Сплошным в предусмотренных пределах, устойчивым, закреплённым и без опасных зазоров и повреждений.",
              "displayOrder": 1
            },
            {
              "id": "754cd847-3821-5af8-9f2a-6094cb1084d8",
              "text": "Наклонённым к внешнему краю для стока воды.",
              "displayOrder": 2
            },
            {
              "id": "918b5257-b1c8-501c-86e0-8b255d4b6a27",
              "text": "Свободно уложенным для быстрого снятия.",
              "displayOrder": 3
            },
            {
              "id": "f2a66ca0-9e68-56ef-8a6f-cd3a27865c77",
              "text": "Составленным из любых обрезков разной толщины.",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "b450e982-07b2-55dc-a0ff-10ea8400a86c",
          "explanation": ""
        },
        {
          "id": "102f95b2-ba00-5633-ab4c-a61ecb8e9b4f",
          "text": "Какая мера от падения имеет приоритет при монтаже лесов?",
          "displayOrder": 7,
          "options": [
            {
              "id": "c2f82404-2cc7-592d-aefc-3567866e6833",
              "text": "Только личная осторожность монтажника.",
              "displayOrder": 1
            },
            {
              "id": "153ab31f-64ab-5fd0-a5f0-a497c30b6762",
              "text": "Только каска без ограждений и страховки.",
              "displayOrder": 2
            },
            {
              "id": "ebe1ded0-9d23-5ad5-928e-5ad8ec3e1989",
              "text": "Предусмотренная технология коллективной защиты, дополненная страховочной системой там, где это требуется.",
              "displayOrder": 3
            },
            {
              "id": "48976c8f-9a45-5bb8-9391-26b0e39eeffa",
              "text": "Устное предупреждение о высоте.",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "ebe1ded0-9d23-5ad5-928e-5ad8ec3e1989",
          "explanation": ""
        },
        {
          "id": "5830f751-52f8-5dc5-a840-bceb70397b48",
          "text": "Какова правильная последовательность допуска лесов к эксплуатации?",
          "displayOrder": 8,
          "options": [
            {
              "id": "f6c1cd59-53ed-5518-a865-d54dfdcc29ed",
              "text": "Проверить только нижний ярус и открыть все уровни.",
              "displayOrder": 1
            },
            {
              "id": "3a2c6419-0bd4-51cd-b30b-3e215e7f23c9",
              "text": "Установить маркировку без осмотра конструкции.",
              "displayOrder": 2
            },
            {
              "id": "12f99518-f581-56c3-beeb-d9bbd6e203fe",
              "text": "Разрешить работу, затем проверить леса в конце смены.",
              "displayOrder": 3
            },
            {
              "id": "c692f7b0-5b06-5f2a-ae85-d6884920a2c4",
              "text": "Завершить монтаж по схеме, провести проверку компетентным лицом, зафиксировать результат и обозначить статус.",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "c692f7b0-5b06-5f2a-ae85-d6884920a2c4",
          "explanation": ""
        },
        {
          "id": "e3376089-fa59-5718-b389-8060e6a2e615",
          "text": "Какова безопасная последовательность демонтажа лесов?",
          "displayOrder": 9,
          "options": [
            {
              "id": "4bc987f8-5d1f-5202-bc47-fa2f717af096",
              "text": "Одновременно разбирать несвязанные участки без руководства.",
              "displayOrder": 1
            },
            {
              "id": "c63ab398-96b4-5b61-a53f-d029eaf11be2",
              "text": "По утверждённой схеме в обратной технологической последовательности с сохранением устойчивости и ограждением зоны.",
              "displayOrder": 2
            },
            {
              "id": "e30deb60-bb97-578e-a707-1b312903349b",
              "text": "Сначала снять все анкеры, затем разбирать настилы.",
              "displayOrder": 3
            },
            {
              "id": "c41abc59-33f1-5167-ac20-cb32ceea4d31",
              "text": "Сбрасывать элементы вниз в ограждённую зону.",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "c63ab398-96b4-5b61-a53f-d029eaf11be2",
          "explanation": ""
        },
        {
          "id": "2b1de486-d32a-5e2b-846d-463d53d4c922",
          "text": "Кто такое компетентное лицо при работе с лесами?",
          "displayOrder": 10,
          "options": [
            {
              "id": "79039d02-270e-5f8c-9b04-350c03b4f403",
              "text": "Любой пользователь, первым поднявшийся на настил.",
              "displayOrder": 1
            },
            {
              "id": "3931d09f-3412-546c-872d-75dc58d26eea",
              "text": "Работник, который только переносит материалы.",
              "displayOrder": 2
            },
            {
              "id": "c670127b-013f-588f-abfa-31c18b24fb4d",
              "text": "Назначенный работник с необходимыми знаниями и полномочиями для предусмотренных проверок и решений.",
              "displayOrder": 3
            },
            {
              "id": "a51e2917-0fc9-501a-8811-5d65cd71707a",
              "text": "Любой посетитель строительной площадки.",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "c670127b-013f-588f-abfa-31c18b24fb4d",
          "explanation": ""
        }
      ]
    },
    {
      "id": "8cb0b85c-fab5-5e92-b733-6b0a969f201c",
      "variantNumber": 2,
      "questions": [
        {
          "id": "5692c857-f86e-5af4-a9f3-10bc7aa390ed",
          "text": "Работник без соответствующего допуска предлагает изменить высоту настила. Что делать?",
          "displayOrder": 1,
          "options": [
            {
              "id": "e3bf3016-7928-5642-ae21-b8085f4dc1be",
              "text": "Разрешить, если не используются инструменты.",
              "displayOrder": 1
            },
            {
              "id": "97728e58-c94a-57b4-803f-cec8b36d05a3",
              "text": "Снять ограждение, чтобы ускорить перестановку.",
              "displayOrder": 2
            },
            {
              "id": "223449d7-d4b4-5bf4-a3f8-5ac42668e7c3",
              "text": "Не разрешать изменение; монтаж и перестановку выполняет назначенный обученный персонал.",
              "displayOrder": 3
            },
            {
              "id": "a52cc2f9-1919-5390-b965-498acbe8cefe",
              "text": "Разрешить изменение под устным наблюдением коллеги.",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "223449d7-d4b4-5bf4-a3f8-5ac42668e7c3",
          "explanation": ""
        },
        {
          "id": "b47dee41-0c82-5cc4-a039-350b4e6e0534",
          "text": "После дождя под основанием лесов появилась просадка. Как поступить?",
          "displayOrder": 2,
          "options": [
            {
              "id": "bb9dc14b-a142-5620-b79e-521b7e55b167",
              "text": "Продолжить работу до окончания смены.",
              "displayOrder": 1
            },
            {
              "id": "d162894e-0fbe-5857-a43c-9678f14688f5",
              "text": "Закрыть доступ, разгрузить участок по безопасной процедуре и провести проверку с восстановлением основания.",
              "displayOrder": 2
            },
            {
              "id": "361169d2-ff9f-55a6-b299-5b7403b6005a",
              "text": "Подбить клинья во время нахождения людей на настиле.",
              "displayOrder": 3
            },
            {
              "id": "79a96c3d-56c1-5d2f-88d3-4b1ef9e1ee16",
              "text": "Добавить материалы на противоположную сторону.",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "d162894e-0fbe-5857-a43c-9678f14688f5",
          "explanation": ""
        },
        {
          "id": "d78550a6-f3bc-5ed4-a205-c0045e20c637",
          "text": "На настиле образовался лёд. Как действовать?",
          "displayOrder": 3,
          "options": [
            {
              "id": "3c3df9c7-38ad-514b-a997-518dc47d91ee",
              "text": "Посыпать лёд опилками во время продолжения работы.",
              "displayOrder": 1
            },
            {
              "id": "ba7f9851-6efe-5a3c-94f2-0011ae1d4120",
              "text": "Передвигаться быстрее, чтобы не задерживаться.",
              "displayOrder": 2
            },
            {
              "id": "89fe62b1-96d7-5ff7-9e0c-57c662f5351c",
              "text": "Снять поручень для удобства очистки.",
              "displayOrder": 3
            },
            {
              "id": "3bc6520e-d425-5cb5-8b42-744bc4852ccc",
              "text": "Остановить использование участка до безопасного устранения скольжения и повторной оценки условий.",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "3bc6520e-d425-5cb5-8b42-744bc4852ccc",
          "explanation": ""
        },
        {
          "id": "276bdb24-899e-59a9-a079-915e8a10ac45",
          "text": "В настиле обнаружена незакреплённая доска. Как поступить?",
          "displayOrder": 4,
          "options": [
            {
              "id": "69ba8e8c-97b6-54d8-ae0d-4dd4a2354e71",
              "text": "Закрыть участок и закрепить или заменить настил допущенным персоналом до использования.",
              "displayOrder": 1
            },
            {
              "id": "63a52059-277f-549a-a2fa-c54e5e53ebc4",
              "text": "Прижать доску материалами.",
              "displayOrder": 2
            },
            {
              "id": "d16ba25c-c20f-5080-8ebd-daf1bf9a419f",
              "text": "Предупредить работников перешагивать опасное место.",
              "displayOrder": 3
            },
            {
              "id": "a26078f2-afd5-58bb-9c4b-cd0d6e416560",
              "text": "Перевернуть доску и продолжить работу.",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "69ba8e8c-97b6-54d8-ae0d-4dd4a2354e71",
          "explanation": ""
        },
        {
          "id": "037aec4a-3506-52d6-8828-f206bdd1126b",
          "text": "Можно ли определять шаг анкеров по одной универсальной цифре?",
          "displayOrder": 5,
          "options": [
            {
              "id": "0d718307-9bf4-5d45-adff-a1d3cc0e4439",
              "text": "Да, если леса ниже соседнего здания.",
              "displayOrder": 1
            },
            {
              "id": "08e43fa8-4283-54e7-9279-4226642e7693",
              "text": "Нет; параметры принимают по проекту, паспорту изготовителя и схеме конкретной системы.",
              "displayOrder": 2
            },
            {
              "id": "4f8d5e48-fe99-595c-875d-3f58c133b1cf",
              "text": "Да, одна цифра подходит для любых лесов.",
              "displayOrder": 3
            },
            {
              "id": "88e01f70-2df5-5bdd-9345-f90b6d0e9793",
              "text": "Да, если фасад выполнен из бетона.",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "08e43fa8-4283-54e7-9279-4226642e7693",
          "explanation": ""
        },
        {
          "id": "80b90315-86eb-5bec-a434-decfe2472630",
          "text": "Как организуют безопасный доступ на ярусы лесов?",
          "displayOrder": 6,
          "options": [
            {
              "id": "36ba0b91-3604-53d8-85c3-1948ab40c06a",
              "text": "По внешней стороне рам без специальных средств.",
              "displayOrder": 1
            },
            {
              "id": "a6b89ee5-d17c-5b43-b063-20038708fc63",
              "text": "По диагональным связям.",
              "displayOrder": 2
            },
            {
              "id": "c5ca6347-4f20-5fa8-8458-bd85b94a59cb",
              "text": "С помощью подъёма на грузовой платформе, не предназначенной для людей.",
              "displayOrder": 3
            },
            {
              "id": "35972f2b-340f-5f09-88ea-27f001e4d79a",
              "text": "По предусмотренной лестнице или лестничному маршу с исправным креплением и защищённым проёмом.",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "35972f2b-340f-5f09-88ea-27f001e4d79a",
          "explanation": ""
        },
        {
          "id": "1ad23bc6-8cd8-5542-b6cd-321a6b48f47e",
          "text": "Анкерная точка для страховки выбрана на случайном элементе лесов. Что сделать?",
          "displayOrder": 7,
          "options": [
            {
              "id": "5a018eef-1ea9-5bb0-bd65-c0a5ce0f950d",
              "text": "Соединить привязь с поясом коллеги.",
              "displayOrder": 1
            },
            {
              "id": "c214b37c-fd62-5be7-a454-a930aed00419",
              "text": "Не учитывать возможное свободное падение.",
              "displayOrder": 2
            },
            {
              "id": "73e0e34f-a84a-5587-9fce-730b2c157d2e",
              "text": "Использовать только предусмотренную планом и рассчитанную точку крепления с учётом запаса высоты.",
              "displayOrder": 3
            },
            {
              "id": "66aa8c10-46cd-5746-964a-4a3ce2f48e2f",
              "text": "Закрепиться за ближайший поручень без проверки.",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "73e0e34f-a84a-5587-9fce-730b2c157d2e",
          "explanation": ""
        },
        {
          "id": "40af5b4c-0367-5887-acc8-a4345d2945b1",
          "text": "Что включает проверка после изменения лесов?",
          "displayOrder": 8,
          "options": [
            {
              "id": "95e170ff-1018-5cbc-97c9-1ec860a4d5bd",
              "text": "Проверку только верхнего поручня.",
              "displayOrder": 1
            },
            {
              "id": "46eb5597-d542-5ecc-863f-d807e1adaab3",
              "text": "Осмотр основания, элементов, связей, креплений, настилов, ограждений и доступа с фиксацией статуса.",
              "displayOrder": 2
            },
            {
              "id": "0273376d-ad87-54f4-9e71-74878c15f9ef",
              "text": "Проверку только цвета маркировки.",
              "displayOrder": 3
            },
            {
              "id": "134c0c5f-1d18-5947-a4ff-b4f6cbde0720",
              "text": "Проверку только количества работников.",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "46eb5597-d542-5ecc-863f-d807e1adaab3",
          "explanation": ""
        },
        {
          "id": "a5d5a75a-0515-59db-86eb-8c53cebe713a",
          "text": "На лесах размещена маркировка «не использовать». Что делать?",
          "displayOrder": 9,
          "options": [
            {
              "id": "27a8292d-2ccc-59fb-baa5-951787848670",
              "text": "Не входить на леса и ожидать устранения причин и нового допуска компетентным лицом.",
              "displayOrder": 1
            },
            {
              "id": "68fa6851-7873-550c-b2a7-3f7e22d91fe2",
              "text": "Использовать только нижний ярус.",
              "displayOrder": 2
            },
            {
              "id": "be6d595e-9eb8-55d1-9f16-e50b64720e27",
              "text": "Снять маркировку после устного разрешения коллеги.",
              "displayOrder": 3
            },
            {
              "id": "5c0bd61c-8592-541d-b04d-71d603f410fb",
              "text": "Работать без материалов, сохраняя маркировку.",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "27a8292d-2ccc-59fb-baa5-951787848670",
          "explanation": ""
        },
        {
          "id": "b7ac1bbd-f68a-5f06-a682-78b5f2d113d7",
          "text": "Для чего нужен бортовой элемент ограждения?",
          "displayOrder": 10,
          "options": [
            {
              "id": "5be2d4f8-0e8b-5eab-ba3e-e04454c9b008",
              "text": "Для увеличения допустимой нагрузки лесов.",
              "displayOrder": 1
            },
            {
              "id": "13ff7656-cd4d-5076-9135-175a9d6b48e1",
              "text": "Для замены среднего поручня во всех случаях.",
              "displayOrder": 2
            },
            {
              "id": "4f499786-d72c-59f8-8dd4-9879f4fc8fe3",
              "text": "Для крепления электрических кабелей.",
              "displayOrder": 3
            },
            {
              "id": "cdfe1ece-13e5-5824-8d78-0156421ef934",
              "text": "Для снижения риска соскальзывания предметов и ног работника за край настила.",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "cdfe1ece-13e5-5824-8d78-0156421ef934",
          "explanation": ""
        }
      ]
    },
    {
      "id": "ba490446-8f39-5277-ab62-d2124035492c",
      "variantNumber": 3,
      "questions": [
        {
          "id": "278ccf96-38a9-5f5e-bb81-8841dbe3e1dd",
          "text": "После передачи лесов в эксплуатацию пользователь заметил недостающий элемент. Какое действие правильное?",
          "displayOrder": 1,
          "options": [
            {
              "id": "eae7ccae-e37b-56f8-a5e2-99dc742d3f2c",
              "text": "Перейти на соседний пролёт, не сообщая о дефекте.",
              "displayOrder": 1
            },
            {
              "id": "4a9dfb8d-bc92-5a4e-ab29-f539d39e3192",
              "text": "Остановить использование, оградить участок и сообщить компетентному лицу для проверки.",
              "displayOrder": 2
            },
            {
              "id": "4b024e9d-7331-5571-beee-9a65b6c1f5f6",
              "text": "Самостоятельно заменить элемент любым подходящим профилем.",
              "displayOrder": 3
            },
            {
              "id": "62042341-4ad5-51d9-ab48-18837fe6ea37",
              "text": "Продолжить работу без размещения материалов.",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "4a9dfb8d-bc92-5a4e-ab29-f539d39e3192",
          "explanation": ""
        },
        {
          "id": "7885e909-7fe7-5287-a6d1-6fc6e14347bf",
          "text": "Стойка установлена на набор незакреплённых обрезков. Какое решение верное?",
          "displayOrder": 2,
          "options": [
            {
              "id": "f3739f24-20be-51ba-8030-4bdfcd453d5d",
              "text": "Скрепить обрезки проволокой и оставить.",
              "displayOrder": 1
            },
            {
              "id": "b7eeeec5-2d0f-5578-b5f4-73322a3dedb2",
              "text": "Подсыпать песок только с одной стороны.",
              "displayOrder": 2
            },
            {
              "id": "72742e8b-2b1a-5633-a098-6e74b5eb655b",
              "text": "Переделать опору с использованием предусмотренных базовых элементов на подготовленном основании.",
              "displayOrder": 3
            },
            {
              "id": "4e920141-f958-56ce-bfa7-6fd31172eb12",
              "text": "Считать опору допустимой при отсутствии ветра.",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "72742e8b-2b1a-5633-a098-6e74b5eb655b",
          "explanation": ""
        },
        {
          "id": "a6868dc3-cd8a-5a49-b60c-d0148c73d692",
          "text": "При работе ухудшилась видимость и усилился ветер. Что должен сделать руководитель?",
          "displayOrder": 3,
          "options": [
            {
              "id": "cbac7473-0343-5941-85f0-a40d7b2c585a",
              "text": "Оценить условия и остановить работу, если безопасное выполнение и устойчивость не обеспечены.",
              "displayOrder": 1
            },
            {
              "id": "23b3d84c-ff04-5ca2-8596-309c278c713f",
              "text": "Убрать сигнальные ограждения, чтобы их не сорвало.",
              "displayOrder": 2
            },
            {
              "id": "1506c3b7-f181-5063-bec9-c0dbafcb9acc",
              "text": "Разрешить работу без перемещения материалов.",
              "displayOrder": 3
            },
            {
              "id": "41ae0574-866e-5eb3-b99b-238955e8c927",
              "text": "Продолжить работу только на верхнем ярусе.",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "cbac7473-0343-5941-85f0-a40d7b2c585a",
          "explanation": ""
        },
        {
          "id": "57be894a-ea0f-5209-94dc-9c54523c4fce",
          "text": "На ярусе отсутствует бортовой элемент, а внизу работают люди. Какое действие правильное?",
          "displayOrder": 4,
          "options": [
            {
              "id": "86c20103-061a-5c2a-822e-d924776e393f",
              "text": "Сдвинуть материалы ближе к краю для освобождения прохода.",
              "displayOrder": 1
            },
            {
              "id": "40c3dd22-d271-5044-b005-560e84df97a0",
              "text": "Продолжить, если инструмент лежит в карманах.",
              "displayOrder": 2
            },
            {
              "id": "cd147d86-0666-52f0-b247-f44f9088c127",
              "text": "Поставить устное предупреждение без ограждения зоны.",
              "displayOrder": 3
            },
            {
              "id": "2613b877-b504-519c-a0e4-b096271a9763",
              "text": "Остановить работу, исключить нахождение людей внизу и восстановить защиту от падения предметов.",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "2613b877-b504-519c-a0e4-b096271a9763",
          "explanation": ""
        },
        {
          "id": "53ac272c-f246-5208-8198-9dfa6af90216",
          "text": "Как следует поступить с ослабленным хомутом или соединением?",
          "displayOrder": 5,
          "options": [
            {
              "id": "b67b973b-d47a-532e-89fc-66a6d394af23",
              "text": "Подтянуть его во время нахождения людей на настиле.",
              "displayOrder": 1
            },
            {
              "id": "ed0cc646-2b91-53bf-a073-e4633c656de0",
              "text": "Заменить хомут проволокой.",
              "displayOrder": 2
            },
            {
              "id": "e18d9924-f2ff-52fc-a17c-84b98d50b46f",
              "text": "Остановить использование затронутого участка и восстановить соединение по системе с последующей проверкой.",
              "displayOrder": 3
            },
            {
              "id": "5c241580-1d25-5908-9f10-3161cf1b5aeb",
              "text": "Оставить до планового демонтажа.",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "e18d9924-f2ff-52fc-a17c-84b98d50b46f",
          "explanation": ""
        },
        {
          "id": "a8580d1d-b97b-5ab4-8e8a-10f209c2a08e",
          "text": "Что обязательно учитывать при устройстве ограждения настила?",
          "displayOrder": 6,
          "options": [
            {
              "id": "e1aa8a8c-99a0-5f9f-9e73-0a479f1c03cf",
              "text": "Непрерывность поручней, промежуточной защиты и бортовых элементов согласно проекту и системе лесов.",
              "displayOrder": 1
            },
            {
              "id": "a6cceb3a-9be1-5a33-9f71-e89180e439b2",
              "text": "Только наличие одного каната на внешней стороне.",
              "displayOrder": 2
            },
            {
              "id": "9625466b-a240-563a-93d9-7f0af4c17db3",
              "text": "Только высоту ближайшей стены.",
              "displayOrder": 3
            },
            {
              "id": "80e52545-3d7d-5b3f-aceb-38d8eb15ca0c",
              "text": "Только цвет верхнего поручня.",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "e1aa8a8c-99a0-5f9f-9e73-0a479f1c03cf",
          "explanation": ""
        },
        {
          "id": "5bdc6210-5957-59dd-89df-fc0c5b4dc433",
          "text": "Леса расположены рядом с электроустановкой. Как действовать?",
          "displayOrder": 7,
          "options": [
            {
              "id": "0f4a651f-96f2-5f12-84b0-2108675cc668",
              "text": "Перемещать длинные элементы над проводами вручную.",
              "displayOrder": 1
            },
            {
              "id": "77c1063e-7d0d-544c-9094-9d9fcf6ab68e",
              "text": "Соблюсти установленные безопасные расстояния и защитные меры по плану, исключив приближение элементов и людей.",
              "displayOrder": 2
            },
            {
              "id": "51c582b6-3756-58a6-8dcf-aaa32064f23a",
              "text": "Считать металлические леса защитным заземлением без проверки.",
              "displayOrder": 3
            },
            {
              "id": "23093c95-d691-5861-ae3a-d721792954f2",
              "text": "Продолжить работу при отключённом освещении.",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "77c1063e-7d0d-544c-9094-9d9fcf6ab68e",
          "explanation": ""
        },
        {
          "id": "3da37fc5-bb04-57c5-8ca8-a7cb0fc3fd67",
          "text": "Когда требуется внеочередная проверка?",
          "displayOrder": 8,
          "options": [
            {
              "id": "77962d55-ba31-5785-83f5-823f25e80598",
              "text": "Только после полного демонтажа.",
              "displayOrder": 1
            },
            {
              "id": "8dfdefbe-dbcb-535f-8527-c4a65bdfa228",
              "text": "Только перед праздничными днями.",
              "displayOrder": 2
            },
            {
              "id": "c4a3b9fe-0cd8-586b-8603-a362ac22287e",
              "text": "После изменения, повреждения, просадки, неблагоприятной погоды или другого события, способного повлиять на безопасность.",
              "displayOrder": 3
            },
            {
              "id": "d41bec89-6674-5aca-995b-1a1dcf1c5b24",
              "text": "Только при смене цвета фасада.",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "c4a3b9fe-0cd8-586b-8603-a362ac22287e",
          "explanation": ""
        },
        {
          "id": "45427f1d-f108-5aa0-88e2-f23a404cb6be",
          "text": "Во время демонтажа найден деформированный элемент. Как поступить?",
          "displayOrder": 9,
          "options": [
            {
              "id": "f0ea4f18-3bbb-51a6-a522-9d9247e707a7",
              "text": "Спрятать элемент в общей пачке.",
              "displayOrder": 1
            },
            {
              "id": "ae367e9f-72df-5213-810b-0a0ecf40d6e5",
              "text": "Использовать его как временную опорную подкладку.",
              "displayOrder": 2
            },
            {
              "id": "875a4d99-124f-5b7e-a674-82ca8a554229",
              "text": "Выпрямить ударом и сразу установить на другом участке.",
              "displayOrder": 3
            },
            {
              "id": "94c2c398-66e0-569c-a227-c05ed69b1223",
              "text": "Отделить его от исправных элементов, промаркировать и направить на установленную отбраковку или оценку.",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "94c2c398-66e0-569c-a227-c05ed69b1223",
          "explanation": ""
        },
        {
          "id": "0b63f5e5-62ed-5a5a-b439-cbcf4a93d2c4",
          "text": "Что означает анкерное крепление лесов?",
          "displayOrder": 10,
          "options": [
            {
              "id": "a2e7a74f-b504-5cab-b646-ad5490dd683e",
              "text": "Предусмотренное проектом соединение лесов с сооружением, обеспечивающее их устойчивость.",
              "displayOrder": 1
            },
            {
              "id": "f4f3e019-a8c9-54dd-affe-502d48a7146c",
              "text": "Маркировку допустимой нагрузки на настиле.",
              "displayOrder": 2
            },
            {
              "id": "d1e46088-3658-579c-928b-534e5b29d638",
              "text": "Любую верёвку между двумя стойками.",
              "displayOrder": 3
            },
            {
              "id": "81113a66-6c91-50b7-bf5a-8b56b98f034b",
              "text": "Подкладку под базовую плиту.",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "a2e7a74f-b504-5cab-b646-ad5490dd683e",
          "explanation": ""
        }
      ]
    }
  ],
