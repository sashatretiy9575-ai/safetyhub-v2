  "variants": [
    {
      "id": "cca1995b-d347-56c1-90d2-02bd7a87cb8e",
      "variantNumber": 1,
      "questions": [
        {
          "id": "9600e24e-2e63-5d17-84f1-fedfa9c739ad",
          "text": "Работник заметил дым и запах гари. Какое первое решение правильное?",
          "displayOrder": 1,
          "options": [
            {
              "id": "a23f4c20-2790-5769-bfcf-2e4e8ab9eba3",
              "text": "Ждать появления открытого пламени.",
              "displayOrder": 1
            },
            {
              "id": "a67c2c6c-8bbc-587b-a68a-9d8f493f8c9c",
              "text": "Сначала закончить текущую операцию.",
              "displayOrder": 2
            },
            {
              "id": "1121fc84-294b-53f4-8f30-21cb7a3379c6",
              "text": "Открыть все двери и окна, не сообщая о пожаре.",
              "displayOrder": 3
            },
            {
              "id": "7030608f-d7e9-5dec-bdea-d56b753d3d77",
              "text": "Немедленно подать сигнал тревоги, сообщить 101/112 и начать действия по эвакуации.",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "7030608f-d7e9-5dec-bdea-d56b753d3d77",
          "explanation": ""
        },
        {
          "id": "21bc1c81-cadc-5fd7-a4d1-15964e140615",
          "text": "Начальный очаг пожара растёт, помещение быстро заполняется дымом. Можно ли продолжать тушение?",
          "displayOrder": 2,
          "options": [
            {
              "id": "e8c5350a-62a0-5962-916a-d938736cbbf5",
              "text": "Да, если в помещении есть ещё один человек.",
              "displayOrder": 1
            },
            {
              "id": "e03cc981-4d67-50e6-8559-2c91f1f39152",
              "text": "Да, если стать ближе к очагу.",
              "displayOrder": 2
            },
            {
              "id": "4cac5d98-78b6-5587-a2c5-bd6280d5de46",
              "text": "Нет; нужно немедленно прекратить тушение, закрыть дверь без запирания и эвакуироваться.",
              "displayOrder": 3
            },
            {
              "id": "77aa9486-d9b2-57dc-bf83-2eb8cf79bfc5",
              "text": "Да, пока огнетушитель не разрядится полностью.",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "4cac5d98-78b6-5587-a2c5-bd6280d5de46",
          "explanation": ""
        },
        {
          "id": "e6eecce6-4f42-574c-b157-4f70e409a21f",
          "text": "Загорелось электрооборудование, которое остаётся под напряжением. Что учитывать при выборе огнетушителя?",
          "displayOrder": 3,
          "options": [
            {
              "id": "d5ccd973-f626-5573-afee-2a2d2b8d02f9",
              "text": "Использовать средство, разрешённое маркировкой для электрооборудования, и соблюдать безопасные условия применения.",
              "displayOrder": 1
            },
            {
              "id": "deddf6a1-d043-5fec-999a-c807513d8bd4",
              "text": "Накрыть оборудование мокрой тканью руками.",
              "displayOrder": 2
            },
            {
              "id": "68018f72-4f83-55fa-b177-56dc280855dd",
              "text": "Использовать струю воды независимо от напряжения.",
              "displayOrder": 3
            },
            {
              "id": "281529fe-8f98-539b-b82f-034a197ff457",
              "text": "Применить пену без отключения и проверки маркировки.",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "d5ccd973-f626-5573-afee-2a2d2b8d02f9",
          "explanation": ""
        },
        {
          "id": "e1b2b29e-e303-5521-809d-dda793bccc2a",
          "text": "После огневых работ наблюдение за местом завершили сразу. В чём ошибка?",
          "displayOrder": 4,
          "options": [
            {
              "id": "13edb70c-fcf1-5730-a37b-f13d0cc2d118",
              "text": "Наблюдение нужно только до начала работ.",
              "displayOrder": 1
            },
            {
              "id": "ba90bb26-e6f3-5793-9deb-ca649fd43979",
              "text": "Место должно контролироваться после окончания в течение установленного для условий периода по наряду и процедуре.",
              "displayOrder": 2
            },
            {
              "id": "9310fe1f-c0d9-58d7-8b06-36826dce839d",
              "text": "После выключения инструмента тление невозможно.",
              "displayOrder": 3
            },
            {
              "id": "b5b9975f-4ca9-5221-9af5-5c51689dea6e",
              "text": "Контроль требуется только при работе на открытом воздухе.",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "ba90bb26-e6f3-5793-9deb-ca649fd43979",
          "explanation": ""
        },
        {
          "id": "e6e947f9-a053-5820-a7b7-1be40657769c",
          "text": "Как прекратить горение по модели огненного треугольника?",
          "displayOrder": 5,
          "options": [
            {
              "id": "9001de08-3689-59b9-a1b0-d27f889ee42b",
              "text": "Добавить горючий материал.",
              "displayOrder": 1
            },
            {
              "id": "0f7e38b6-ba82-540b-9504-3dfa02a35a58",
              "text": "Повысить температуру очага.",
              "displayOrder": 2
            },
            {
              "id": "3c9dd856-9904-5bcf-8060-e81debf0ea31",
              "text": "Устранить хотя бы один необходимый фактор: горючее, окислитель или источник тепла.",
              "displayOrder": 3
            },
            {
              "id": "80e95be0-405e-5124-846a-3ab26dd24306",
              "text": "Увеличить приток воздуха.",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "3c9dd856-9904-5bcf-8060-e81debf0ea31",
          "explanation": ""
        },
        {
          "id": "e8cfd42b-8ca5-59d8-900a-f11155c35f23",
          "text": "От чего зависит предельное расстояние до огнетушителя в помещении?",
          "displayOrder": 6,
          "options": [
            {
              "id": "bcb3e165-8109-5716-8018-8d9a09308c45",
              "text": "Только от цвета огнетушителя.",
              "displayOrder": 1
            },
            {
              "id": "2909c63b-7b0a-5e0a-964c-68c614a94a12",
              "text": "Всегда только от универсального значения 30 метров.",
              "displayOrder": 2
            },
            {
              "id": "94ac6e42-f132-5c03-84fd-b2fd685502d1",
              "text": "Только от роста работников.",
              "displayOrder": 3
            },
            {
              "id": "0103be91-41c2-597f-b5b7-f4beed9fa7c9",
              "text": "От назначения и категории помещения; правила предусматривают разные значения 20, 30, 40 или 70 метров.",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "0103be91-41c2-597f-b5b7-f4beed9fa7c9",
          "explanation": ""
        },
        {
          "id": "71f7fc27-7d78-5126-a030-755aa27f8bec",
          "text": "Эвакуационный выход загромождён коробками. Какое требование нарушено?",
          "displayOrder": 7,
          "options": [
            {
              "id": "77ab2d84-1127-5e13-8172-1eda38d41644",
              "text": "Пути и выходы должны постоянно оставаться свободными и доступными.",
              "displayOrder": 1
            },
            {
              "id": "f4f03d98-54cc-5643-8c8c-86e641a2da8b",
              "text": "Коробки запрещены только в рабочее время.",
              "displayOrder": 2
            },
            {
              "id": "88631dad-95df-5c49-b765-506990950ec7",
              "text": "Загромождение допустимо при наличии огнетушителя.",
              "displayOrder": 3
            },
            {
              "id": "8195ee12-3a85-57e9-961b-023698e9bca3",
              "text": "Выход можно перекрыть, если рядом есть окно.",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "77ab2d84-1127-5e13-8172-1eda38d41644",
          "explanation": ""
        },
        {
          "id": "186672fa-6fe0-5ba1-b05f-7d113cb09598",
          "text": "Какова правильная последовательность при обнаружении пожара?",
          "displayOrder": 8,
          "options": [
            {
              "id": "294ac2ce-10b6-5740-a157-b68e09e7355b",
              "text": "Сначала собрать личные вещи, затем закрыть выходы.",
              "displayOrder": 1
            },
            {
              "id": "99f56786-7830-5b87-9332-5354114e9bc3",
              "text": "Ждать указания от коллег и не подавать тревогу.",
              "displayOrder": 2
            },
            {
              "id": "33bc128e-9805-5e10-ac61-733fd0e05c2a",
              "text": "Сообщить 101/112, предупредить людей, эвакуироваться, встретить службы; тушить только безопасный начальный очаг.",
              "displayOrder": 3
            },
            {
              "id": "96dc61bd-ba23-594b-a8d4-5183d33e34a8",
              "text": "Сначала тушить до полного расхода средств, затем сообщить.",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "33bc128e-9805-5e10-ac61-733fd0e05c2a",
          "explanation": ""
        },
        {
          "id": "5ddf5d4e-3ef7-57a8-802e-f2dc2b827a99",
          "text": "Как подготовить переносной огнетушитель к применению?",
          "displayOrder": 9,
          "options": [
            {
              "id": "4b010dab-b397-57c8-b805-88fba78b50b3",
              "text": "Открыть корпус и смешать заряд вручную.",
              "displayOrder": 1
            },
            {
              "id": "5fd8f7c1-71a5-5b0e-a16b-fd1eae979d8a",
              "text": "Сначала направить насадок на людей для проверки.",
              "displayOrder": 2
            },
            {
              "id": "61396b00-e2d1-53f1-9355-e22882450a76",
              "text": "Положить огнетушитель горизонтально и ударить по корпусу.",
              "displayOrder": 3
            },
            {
              "id": "47d6d6ea-1adf-5c1c-b543-284263d7940e",
              "text": "Снять пломбу и предохранитель по инструкции, направить насадок на основание пламени и привести огнетушитель в действие.",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "47d6d6ea-1adf-5c1c-b543-284263d7940e",
          "explanation": ""
        },
        {
          "id": "d4594fcc-e8ae-557e-835e-80e0df35af26",
          "text": "Что относится к пожару класса A?",
          "displayOrder": 10,
          "options": [
            {
              "id": "d1de72e0-c0f0-50fd-8d57-afee0056dfd3",
              "text": "Горение газов.",
              "displayOrder": 1
            },
            {
              "id": "51ed51b2-c235-5835-b37a-86e8610b548c",
              "text": "Горение твёрдых веществ, обычно органического происхождения, часто с образованием тлеющих углей.",
              "displayOrder": 2
            },
            {
              "id": "f7f294a1-f94e-5ef5-828c-7a488d637d53",
              "text": "Горение металлов.",
              "displayOrder": 3
            },
            {
              "id": "de49df16-69d7-5328-98e9-042f1e475239",
              "text": "Горение кулинарных масел и жиров.",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "51ed51b2-c235-5835-b37a-86e8610b548c",
          "explanation": ""
        }
      ]
    },
    {
      "id": "d218d7d0-22a9-528d-8c09-d003ce99d0c4",
      "variantNumber": 2,
      "questions": [
        {
          "id": "4c4a5f08-d028-55b7-ae74-4d16a93a2c9f",
          "text": "Сработала пожарная сигнализация, но пламени не видно. Как действовать?",
          "displayOrder": 1,
          "options": [
            {
              "id": "9322daeb-72bb-56c8-ad44-3c94603fe1d8",
              "text": "Спрятаться в помещении до подтверждения пожара.",
              "displayOrder": 1
            },
            {
              "id": "ac9d822c-6ae0-50dc-a8dd-d5480eb666c6",
              "text": "Выполнить установленный порядок эвакуации и указания ответственного персонала, не игнорируя сигнал.",
              "displayOrder": 2
            },
            {
              "id": "868e9eb9-78d2-5051-8d51-37685bf6901a",
              "text": "Пойти искать очаг в одиночку по задымлённым коридорам.",
              "displayOrder": 3
            },
            {
              "id": "ef3afebf-4e85-5af3-9155-48939fa50dad",
              "text": "Отключить сигнализацию и продолжить работу.",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "ac9d822c-6ae0-50dc-a8dd-d5480eb666c6",
          "explanation": ""
        },
        {
          "id": "88242eff-679d-51e8-82d5-ccd88ce5518b",
          "text": "Работник не обучен применению огнетушителя и не видит безопасного пути отхода. Что делать?",
          "displayOrder": 2,
          "options": [
            {
              "id": "6677c30f-be19-54aa-9e54-d1491e5ae9c1",
              "text": "Не приступать к тушению, предупредить людей и эвакуироваться, сообщив 101/112.",
              "displayOrder": 1
            },
            {
              "id": "57acb836-b417-5e6c-b21e-52eb5594b0dd",
              "text": "Ждать у очага прибытия пожарных.",
              "displayOrder": 2
            },
            {
              "id": "5976fffb-d3f7-5ed9-98f3-2c7b364a655d",
              "text": "Искать подходящий огнетушитель в задымлённой зоне.",
              "displayOrder": 3
            },
            {
              "id": "dffaf32f-c44d-5c57-ad11-663b4f77e33b",
              "text": "Тушить любой жидкостью, находящейся рядом.",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "6677c30f-be19-54aa-9e54-d1491e5ae9c1",
          "explanation": ""
        },
        {
          "id": "5968ef69-6c0c-52c3-8e4e-191b41ecad41",
          "text": "Какое действие при пожаре электрооборудования повышает безопасность, если оно выполнимо без риска?",
          "displayOrder": 3,
          "options": [
            {
              "id": "d0a3e945-9856-5e7b-8cd8-bfec18b6ab61",
              "text": "Разобрать корпус работающего оборудования.",
              "displayOrder": 1
            },
            {
              "id": "8b10f9d9-9daf-573b-9c8e-667d83b5e120",
              "text": "Прикасаться к кабелю металлическим инструментом.",
              "displayOrder": 2
            },
            {
              "id": "331911d3-ba4b-5ab8-9c63-37fb32ae1fff",
              "text": "Залить распределительный щит водой.",
              "displayOrder": 3
            },
            {
              "id": "e385cb4c-ed19-5d24-80be-838a38928fa9",
              "text": "Отключить питание установленным способом и затем применять подходящее средство тушения.",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "e385cb4c-ed19-5d24-80be-838a38928fa9",
          "explanation": ""
        },
        {
          "id": "f315bceb-b812-557a-bc44-fcc8e1838589",
          "text": "Перед сваркой рядом находятся горючие материалы. Как поступить?",
          "displayOrder": 4,
          "options": [
            {
              "id": "c602edd9-808b-5b14-be37-1ce5b1a051be",
              "text": "Начать сварку на меньшем токе.",
              "displayOrder": 1
            },
            {
              "id": "1e3693c4-10ce-56d9-ab66-7eb4d6f96da2",
              "text": "Удалить или защитить материалы, подготовить средства тушения и выполнить требования наряда-допуска.",
              "displayOrder": 2
            },
            {
              "id": "7ebd6b77-18fc-525c-95af-01386380fd5b",
              "text": "Оставить материалы и открыть окно.",
              "displayOrder": 3
            },
            {
              "id": "8102e71a-ff21-5693-baa7-41e2cde77383",
              "text": "Накрыть материалы обычной бумагой.",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "1e3693c4-10ce-56d9-ab66-7eb4d6f96da2",
          "explanation": ""
        },
        {
          "id": "af16c829-bf30-59fc-b24e-c6e3b520671c",
          "text": "Какой огнетушитель выбирают для конкретного очага?",
          "displayOrder": 5,
          "options": [
            {
              "id": "d162d8fa-cc90-52aa-8332-3c56a10f821c",
              "text": "По расположению ближайшего шкафа без учёта очага.",
              "displayOrder": 1
            },
            {
              "id": "22b887ec-fdbd-53ed-b3c3-4875b41a5ac4",
              "text": "Только по цвету наклейки иностранного шаблона.",
              "displayOrder": 2
            },
            {
              "id": "cbb8e529-7bc8-5032-a208-da2943f7c7ec",
              "text": "По классу пожара, типу заряда, маркировке огнетушителя и условиям безопасности.",
              "displayOrder": 3
            },
            {
              "id": "69ae70ff-da5a-58fc-8800-36f21b376121",
              "text": "Только по массе корпуса.",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "cbb8e529-7bc8-5032-a208-da2943f7c7ec",
          "explanation": ""
        },
        {
          "id": "f655ca03-94ff-5986-a454-e9e35d9dcd18",
          "text": "Как устанавливают переносной огнетушитель массой 15 кг и более?",
          "displayOrder": 6,
          "options": [
            {
              "id": "4a0e08cc-dfff-5ba4-a5e3-ecd2dae464bc",
              "text": "На высоте ровно 1,5 метра до нижней части корпуса.",
              "displayOrder": 1
            },
            {
              "id": "d0c3e49d-42c6-5bd4-bdf9-f9fe278ba8d9",
              "text": "Непосредственно на пути эвакуации с сужением прохода.",
              "displayOrder": 2
            },
            {
              "id": "bac4ec02-b1b5-574b-a13e-3b90f92e5c46",
              "text": "За запертой дверью без обозначения.",
              "displayOrder": 3
            },
            {
              "id": "c3c2199b-74e9-5fff-b9c0-32a1f0f05745",
              "text": "Так, чтобы верх огнетушителя находился не выше 1,0 метра от пола, либо в предусмотренном шкафу или на подставке.",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "c3c2199b-74e9-5fff-b9c0-32a1f0f05745",
          "explanation": ""
        },
        {
          "id": "00b1d525-37d3-5b55-93ab-fcb39d5d5770",
          "text": "Горючие жидкости хранятся в открытой немаркированной таре. Что следует сделать?",
          "displayOrder": 7,
          "options": [
            {
              "id": "9ae2ea0a-0795-54bc-90b9-0ffa0d9668b9",
              "text": "Поставить тару у источника тепла.",
              "displayOrder": 1
            },
            {
              "id": "b1f00a0b-9476-50e6-b790-712fb3190e20",
              "text": "Прекратить такое хранение и разместить вещества в предусмотренной закрытой маркированной таре и месте.",
              "displayOrder": 2
            },
            {
              "id": "3045070e-6293-5117-9601-8617e9d0844e",
              "text": "Оставить тару открытой для испарения.",
              "displayOrder": 3
            },
            {
              "id": "718a4ffc-2eb0-51df-bf3f-e9805874d168",
              "text": "Перелить жидкости в пищевые бутылки.",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "b1f00a0b-9476-50e6-b790-712fb3190e20",
          "explanation": ""
        },
        {
          "id": "af967078-e027-5243-8822-c4039f189b62",
          "text": "Что делать после выхода к пункту сбора?",
          "displayOrder": 8,
          "options": [
            {
              "id": "87511e10-bdfb-5576-afef-ce139fff6101",
              "text": "Отметиться при перекличке, сообщить известные сведения и не возвращаться без разрешения служб.",
              "displayOrder": 1
            },
            {
              "id": "aab1de1a-c5bc-5e19-be9f-c91eeeca3cf1",
              "text": "Встать у входа и мешать проезду пожарных машин.",
              "displayOrder": 2
            },
            {
              "id": "7c73e76f-8137-51fe-8e63-75a9fa89a61d",
              "text": "Самостоятельно вернуться за документами.",
              "displayOrder": 3
            },
            {
              "id": "ee0d5768-8e72-59eb-8413-67d6bafbdc6d",
              "text": "Покинуть пункт сбора, не сообщая никому.",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "87511e10-bdfb-5576-afef-ce139fff6101",
          "explanation": ""
        },
        {
          "id": "f8dd7505-75e2-55f2-a4e5-69d45aa7c9b1",
          "text": "Какое положение безопаснее при тушении начального очага?",
          "displayOrder": 9,
          "options": [
            {
              "id": "f4af2199-1f95-59e1-bfef-6da444755d0e",
              "text": "Встать между очагом и единственным выходом лицом к двери.",
              "displayOrder": 1
            },
            {
              "id": "b80e272c-15db-57ea-94a2-9ce8c8e3fce3",
              "text": "Подойти вплотную к пламени независимо от тепла.",
              "displayOrder": 2
            },
            {
              "id": "17e3e2fb-6e69-59ef-a5b7-0ae46a75b42e",
              "text": "Работать спиной к очагу, чтобы видеть выход.",
              "displayOrder": 3
            },
            {
              "id": "bc5ea7a2-dd70-51a1-a079-f01112cf626c",
              "text": "Сохранять за спиной свободный путь отхода и не входить в дым или зону опасного теплового воздействия.",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "bc5ea7a2-dd70-51a1-a079-f01112cf626c",
          "explanation": ""
        },
        {
          "id": "c4ee66a5-9806-5f91-a6b0-e42205a02858",
          "text": "Что такое конвекция при пожаре?",
          "displayOrder": 10,
          "options": [
            {
              "id": "4f05da42-a4c4-54b6-925b-a1d8e45748c7",
              "text": "Распространение света без нагрева.",
              "displayOrder": 1
            },
            {
              "id": "bd0ecfe7-cdb2-56ad-b73d-0e3976a6765e",
              "text": "Прекращение горения из-за отсутствия топлива.",
              "displayOrder": 2
            },
            {
              "id": "e945c15b-f5db-5c31-aa3e-1794e0e84baa",
              "text": "Перенос тепла движущимися нагретыми газами и дымом.",
              "displayOrder": 3
            },
            {
              "id": "0cb79a6c-dbda-5d31-b7f5-2d5838c46e96",
              "text": "Передача тепла только через непосредственный контакт твёрдых тел.",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "e945c15b-f5db-5c31-aa3e-1794e0e84baa",
          "explanation": ""
        }
      ]
    },
    {
      "id": "5a114eca-9129-5c97-aeb1-b5a00a263280",
      "variantNumber": 3,
      "questions": [
        {
          "id": "19e65d17-2bce-5537-978d-cde623a170fc",
          "text": "Работник первым обнаружил небольшое возгорание. Что он должен обеспечить прежде всего?",
          "displayOrder": 1,
          "options": [
            {
              "id": "d24e8376-28b9-5e51-8a54-662ef9923893",
              "text": "Ожидание команды после распространения дыма.",
              "displayOrder": 1
            },
            {
              "id": "35654980-f993-5013-a9e2-d5088e080536",
              "text": "Сохранность личных вещей.",
              "displayOrder": 2
            },
            {
              "id": "6bc66aa0-64fc-5203-85e6-461a49ba6834",
              "text": "Оповещение людей и пожарной службы, безопасный путь отхода и эвакуацию по обстановке.",
              "displayOrder": 3
            },
            {
              "id": "c30b5cec-14f5-5d81-970d-c768d9498f5d",
              "text": "Закрытие всех эвакуационных выходов.",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "6bc66aa0-64fc-5203-85e6-461a49ba6834",
          "explanation": ""
        },
        {
          "id": "37bf813c-78f7-5651-bd3d-563b6b9b90a8",
          "text": "Небольшой очаг доступен, огнетушитель подходит, а выход остаётся за спиной. Когда допустима попытка тушения?",
          "displayOrder": 2,
          "options": [
            {
              "id": "60da55f9-1272-5c96-b17a-e2d47160335d",
              "text": "До подачи сигнала тревоги, чтобы не беспокоить людей.",
              "displayOrder": 1
            },
            {
              "id": "408aab23-c0de-5738-a714-04a954410273",
              "text": "После оповещения, при наличии обучения, отсутствии угрозы жизни и готовности немедленно отступить.",
              "displayOrder": 2
            },
            {
              "id": "f1117e09-e16d-585f-9469-577f34edd3b3",
              "text": "Только после закрытия единственного выхода.",
              "displayOrder": 3
            },
            {
              "id": "0ceb12cf-da46-5f88-878d-21e03675d218",
              "text": "При любом размере огня, пока есть огнетушитель.",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "408aab23-c0de-5738-a714-04a954410273",
          "explanation": ""
        },
        {
          "id": "6542fe0a-3c07-54d5-97fb-dfe40f4a7d63",
          "text": "На огнетушителе нет понятной маркировки применимости к электрооборудованию. Как поступить?",
          "displayOrder": 3,
          "options": [
            {
              "id": "ce14b1fa-9622-50db-878b-ee9b7946aede",
              "text": "Не использовать его для оборудования под напряжением и выбрать подтверждённо подходящее средство либо эвакуироваться.",
              "displayOrder": 1
            },
            {
              "id": "5c046f36-e7ac-505f-b395-1ad306ef7562",
              "text": "Смешать заряд с водой.",
              "displayOrder": 2
            },
            {
              "id": "7091535e-54a6-5576-a40d-46632257bddc",
              "text": "Проверить пригодность коротким выпуском в щит.",
              "displayOrder": 3
            },
            {
              "id": "aca0e427-7530-5343-832b-fe78a1e562a0",
              "text": "Использовать огнетушитель, ориентируясь на цвет корпуса.",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "ce14b1fa-9622-50db-878b-ee9b7946aede",
          "explanation": ""
        },
        {
          "id": "7600b23d-bb08-5ffd-821f-a622f4a55cfd",
          "text": "Пожарный пост потерял связь с исполнителем огневой работы. Что делать?",
          "displayOrder": 4,
          "options": [
            {
              "id": "55849e56-9bcb-5428-b80a-a2dfd1166dd7",
              "text": "Заменить связь периодическими жестами без согласования.",
              "displayOrder": 1
            },
            {
              "id": "70f500f5-70b4-5791-b342-533d12b818bd",
              "text": "Продолжить, если искры не видны.",
              "displayOrder": 2
            },
            {
              "id": "d0a637c5-ac7e-5311-bd32-089b95fdebce",
              "text": "Приостановить работу до восстановления предусмотренного наблюдения и связи.",
              "displayOrder": 3
            },
            {
              "id": "b15c1981-5e6f-5d3a-90f0-e56e276c3c2a",
              "text": "Покинуть пост, не сообщая исполнителю.",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "d0a637c5-ac7e-5311-bd32-089b95fdebce",
          "explanation": ""
        },
        {
          "id": "1f9c940e-3364-5223-8f6e-2b4cc133d194",
          "text": "Почему закрытая без запирания дверь полезна при выходе из горящего помещения?",
          "displayOrder": 5,
          "options": [
            {
              "id": "cb8443d3-4403-5912-93d0-e93aa61bdd2e",
              "text": "Она полностью прекращает горение во всех случаях.",
              "displayOrder": 1
            },
            {
              "id": "1f4d9056-9ced-55a0-a1cc-42106336a2de",
              "text": "Она заменяет вызов пожарной службы.",
              "displayOrder": 2
            },
            {
              "id": "35b1f577-0ec0-56e5-a078-cdfdb351e9e6",
              "text": "Она разрешает повторно войти без защиты.",
              "displayOrder": 3
            },
            {
              "id": "92645e91-8799-590a-9277-636fa80788bc",
              "text": "Она может ограничить распространение дыма и огня, сохраняя возможность доступа служб.",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "92645e91-8799-590a-9277-636fa80788bc",
          "explanation": ""
        },
        {
          "id": "0d57c1dc-021b-50ae-95b5-a3c6adb316d1",
          "text": "Что проверяют при внешнем осмотре огнетушителя?",
          "displayOrder": 6,
          "options": [
            {
              "id": "d31aee1f-d3b4-5c30-af62-79cf7108e01d",
              "text": "Только массу соседнего оборудования.",
              "displayOrder": 1
            },
            {
              "id": "97861680-dd23-5bcc-bffe-d3ec45ef8530",
              "text": "Доступность, пломбу и индикатор при наличии, отсутствие повреждений, читаемость маркировки и срок обслуживания.",
              "displayOrder": 2
            },
            {
              "id": "6b93e381-fa30-5334-b3e4-7ba1daae6064",
              "text": "Только наличие свободного окна рядом.",
              "displayOrder": 3
            },
            {
              "id": "e24d7ed8-7669-5d1d-a2e4-c90b7478275b",
              "text": "Только цвет корпуса.",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "97861680-dd23-5bcc-bffe-d3ec45ef8530",
          "explanation": ""
        },
        {
          "id": "431f5f26-c949-58df-bfc7-410c1e3eebd2",
          "text": "Где допускается курение на территории организации?",
          "displayOrder": 7,
          "options": [
            {
              "id": "1378a8ac-773d-5510-b8dc-b8eab88563d2",
              "text": "Только в специально отведённых и обозначенных местах с соблюдением установленных мер.",
              "displayOrder": 1
            },
            {
              "id": "7cfb40a2-dda7-53a2-b60c-6202f413a4e0",
              "text": "У склада горючих материалов при отсутствии ветра.",
              "displayOrder": 2
            },
            {
              "id": "b1c00370-ad6a-581b-95ab-f1c7fefd8079",
              "text": "В любом месте на открытом воздухе.",
              "displayOrder": 3
            },
            {
              "id": "f2144ab1-b419-54ee-bee1-6c3a02868d3b",
              "text": "В помещении рядом с огнетушителем.",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "1378a8ac-773d-5510-b8dc-b8eab88563d2",
          "explanation": ""
        },
        {
          "id": "a0451b68-5acc-5e9e-9d5b-394812006217",
          "text": "Как действовать при эвакуации через задымлённый участок, если путь остаётся допустимым по плану?",
          "displayOrder": 8,
          "options": [
            {
              "id": "537f3590-e4c8-52b1-9e80-d690cd350517",
              "text": "Бежать в противоположную сторону без ориентирования.",
              "displayOrder": 1
            },
            {
              "id": "0f3fce79-cd61-5f9a-92f7-c631918fd78c",
              "text": "Открывать все двери и оставлять их настежь.",
              "displayOrder": 2
            },
            {
              "id": "701a1c8f-4e8e-5b62-b1c4-9f6331bf3b6b",
              "text": "Двигаться организованно к безопасному выходу, держаться ниже слоя дыма и не пользоваться лифтом.",
              "displayOrder": 3
            },
            {
              "id": "8030d0ae-9aab-5a41-850f-d71962e7d0ef",
              "text": "Возвращаться за средствами индивидуальной защиты из другой зоны.",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "701a1c8f-4e8e-5b62-b1c4-9f6331bf3b6b",
          "explanation": ""
        },
        {
          "id": "42d9770c-68c4-5068-8ef1-dc7ad608b3fd",
          "text": "Когда следует прекратить применение огнетушителя?",
          "displayOrder": 9,
          "options": [
            {
              "id": "8ce3046e-7a06-5a89-8dce-8a19e6687e3a",
              "text": "Только после прибытия руководителя организации.",
              "displayOrder": 1
            },
            {
              "id": "5fcf8d39-aeda-5b3b-a89f-af0aed279f3b",
              "text": "Только если огонь перешёл на пол.",
              "displayOrder": 2
            },
            {
              "id": "ee77159d-9a80-5c37-9a5d-8fe36c364ba7",
              "text": "Только после полного опустошения корпуса.",
              "displayOrder": 3
            },
            {
              "id": "911ac334-4242-5263-971e-cd5a08713913",
              "text": "Если огонь растёт, усиливается дым, средство неэффективно или безопасный отход оказывается под угрозой.",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "911ac334-4242-5263-971e-cd5a08713913",
          "explanation": ""
        },
        {
          "id": "3e8a1c3b-9133-5f5e-8120-467082b33b00",
          "text": "Что называют источником зажигания?",
          "displayOrder": 10,
          "options": [
            {
              "id": "81e99df7-0692-5fa5-ac84-481e9d89bf6c",
              "text": "Источник энергии, способный инициировать горение горючей смеси или материала.",
              "displayOrder": 1
            },
            {
              "id": "02d2c294-d56e-55cc-aa02-677be96d0f03",
              "text": "Только негорючую строительную конструкцию.",
              "displayOrder": 2
            },
            {
              "id": "afcb4009-d5a7-52f9-bbf7-b14d6214694a",
              "text": "Любой эвакуационный знак.",
              "displayOrder": 3
            },
            {
              "id": "6062791e-b3a7-5c56-8e7e-ba714d6f717d",
              "text": "Любое средство тушения.",
              "displayOrder": 4
            }
          ],
          "correctOptionId": "81e99df7-0692-5fa5-ac84-481e9d89bf6c",
          "explanation": ""
        }
      ]
    }
  ],
